{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "exposed_copper_bars_axe_blocked_by_shield", 
    "description": "With a shield in the off hand an axe use is passed and exposed copper bars are not scraped; once the shield is removed the same axe use scrapes them. Random ticks are disabled so the unwaxed bars cannot oxidize mid-test.", 
    "tags": ["connectible", "bars", "copper-bars", "axe", "scrape", "shield", "player"], 
    "minecraftIds": [
        "minecraft:exposed_copper_bars", "minecraft:copper_bars"        , "minecraft:iron_axe"           , 
        "minecraft:shield"             
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [2, 4, 2] ]
        }, 
        "player": {
            "inventory": {
                "hotbar1" : {"id": "minecraft:iron_axe", "count": 1}, 
                "off_hand": {"id": "minecraft:shield"  , "count": 1}  
            }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:exposed_copper_bars"} }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 2, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2, 1], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id"         : "minecraft:exposed_copper_bars", 
                        "north"      : "false"                        , 
                        "south"      : "true"                         , 
                        "east"       : "false"                        , 
                        "west"       : "true"                         , 
                        "waterlogged": "false"                          
                    }
                }
            ]
        }, 
        {"at": 5, "do": "set_slot", "slot": "off_hand"}, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id"         : "minecraft:copper_bars", 
                        "north"      : "false"                , 
                        "south"      : "true"                 , 
                        "east"       : "false"                , 
                        "west"       : "true"                 , 
                        "waterlogged": "false"                  
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

