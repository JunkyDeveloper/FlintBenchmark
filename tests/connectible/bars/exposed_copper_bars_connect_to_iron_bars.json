{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "exposed_copper_bars_connect_to_iron_bars", 
    "description": "Exposed copper bars connect to an adjacent iron bars block and vice versa (any bars block counts as an attachment target), and not to the empty sides. Random ticks are disabled so the unwaxed bars cannot oxidize mid-test.", 
    "tags": ["connectible", "bars", "copper-bars", "iron-bars", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:exposed_copper_bars", "minecraft:iron_bars"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [2, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:exposed_copper_bars"} }, 
        { "at": 1, "do": "place", "pos": [-1, 0, 0], "block": {"id": "minecraft:iron_bars"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"         : "minecraft:exposed_copper_bars", 
                        "north"      : "false"                        , 
                        "south"      : "false"                        , 
                        "east"       : "false"                        , 
                        "west"       : "true"                         , 
                        "waterlogged": "false"                          
                    }
                }, 
                {
                    "pos": [-1, 0, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "true"               , 
                        "west"       : "false"              , 
                        "waterlogged": "false"                
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

