{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "exposed_copper_bars_oxidize_randomly", 
    "description": "With a high random tick speed, a lone exposed copper bars block oxidizes to weathered or oxidized copper bars and keeps its connection properties.", 
    "tags": ["connectible", "bars", "copper-bars", "oxidation", "random-tick"], 
    "minecraftIds": [
        "minecraft:exposed_copper_bars"  , "minecraft:weathered_copper_bars", "minecraft:oxidized_copper_bars" 
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [2, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:exposed_copper_bars"} }, 
        { "at": 1, "do": "place", "pos": [-1, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"         : "minecraft:exposed_copper_bars", 
                        "north"      : "false"                        , 
                        "south"      : "false"                        , 
                        "east"       : "false"                        , 
                        "west"       : "true"                         , 
                        "waterlogged": "false"                          
                    }
                }
            ]
        }, 
        {
            "at": 150, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": [
                        {
                            "id"         : "minecraft:weathered_copper_bars", 
                            "north"      : "false"                          , 
                            "south"      : "false"                          , 
                            "east"       : "false"                          , 
                            "west"       : "true"                           , 
                            "waterlogged": "false"                            
                        }, 
                        {
                            "id"         : "minecraft:oxidized_copper_bars", 
                            "north"      : "false"                         , 
                            "south"      : "false"                         , 
                            "east"       : "false"                         , 
                            "west"       : "true"                          , 
                            "waterlogged": "false"                           
                        }
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

