{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_bars_connection_exceptions", 
    "description": "Pumpkin, carved pumpkin and jack o'lantern are connection exceptions (Block.isExceptionForConnection): iron bars do not connect to them, but still connect to stone.", 
    "tags": ["connectible", "bars", "iron-bars", "block-state", "neighbor-update"], 
    "minecraftIds": [
        "minecraft:iron_bars"     , "minecraft:pumpkin"       , "minecraft:carved_pumpkin", "minecraft:jack_o_lantern"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, -1, -2], [2, 1, 2] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:iron_bars"} }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 0,  0], "block": {"id": "minecraft:pumpkin"                          } }, 
                { "pos": [ 0, 0, -1], "block": {"id": "minecraft:carved_pumpkin", "facing": "north"} }, 
                { "pos": [ 1, 0,  0], "block": {"id": "minecraft:jack_o_lantern", "facing": "north"} }, 
                { "pos": [ 0, 0,  1], "block": {"id": "minecraft:stone"                            } }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "true"               , 
                        "east"       : "false"              , 
                        "west"       : "false"              , 
                        "waterlogged": "false"                
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

