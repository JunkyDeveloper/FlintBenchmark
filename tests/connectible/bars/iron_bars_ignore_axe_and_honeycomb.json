                        "waterlogged": "false"                
                    }
                }
            ]
        }, 
        {"at": 3, "do": "select_hotbar", "slot": 2}, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "false"              , 
                        "west"       : "false"              , 
                        "waterlogged": "false"                
                    }
