{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_bars_ignore_axe_and_honeycomb", 
    "description": "Iron bars are not in any copper map: an axe does not scrape or unwax them and honeycomb does not wax them, and the honeycomb is not consumed.", 
    "tags": ["connectible", "bars", "iron-bars", "axe", "honeycomb", "player"], 
    "minecraftIds": ["minecraft:iron_bars", "minecraft:iron_axe", "minecraft:honeycomb"], 
    "dependencies": [], 
    "setup": {
