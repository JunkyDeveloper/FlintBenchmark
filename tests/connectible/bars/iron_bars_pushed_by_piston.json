{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_bars_pushed_by_piston", 
    "description": "A piston pushes iron bars one block; after the move the bars recompute their connections against the new neighbours (stone ahead, piston head behind).", 
    "tags": ["connectible", "bars", "iron-bars", "piston", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:iron_bars", "minecraft:piston"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:piston"   , "facing": "east", "extended": "false"} }, 
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:iron_bars"                                       } }, 
                { "pos": [ 2, 1, 0], "block": {"id": "minecraft:stone"                                           } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "false"              , 
                        "west"       : "true"               , 
                        "waterlogged": "false"                
                    }
                }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-2, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "true"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east", "type": "normal"} }, 
                {
                    "pos": [1, 1, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "true"               , 
                        "west"       : "true"               , 
                        "waterlogged": "false"                
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

