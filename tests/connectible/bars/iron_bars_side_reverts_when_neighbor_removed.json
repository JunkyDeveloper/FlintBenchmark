{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_bars_side_reverts_when_neighbor_removed", 
    "description": "Removing a solid block beside connected iron bars sets only that side back to false (IronBarsBlock.updateShape); the opposite connection stays.", 
    "tags": ["connectible", "bars", "iron-bars", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:iron_bars"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, -1, -2], [2, 1, 2] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:iron_bars"} }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 0, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "true"               , 
                        "west"       : "true"               , 
                        "waterlogged": "false"                
                    }
                }
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [-1, 0, 0] }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "true"               , 
                        "west"       : "false"              , 
                        "waterlogged": "false"                
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

