{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_bars_waterlogged_on_placement", 
    "description": "A player placing iron bars into a water source block gets waterlogged iron bars.", 
    "tags": ["connectible", "bars", "iron-bars", "waterlogged", "placement", "player"], 
    "minecraftIds": ["minecraft:iron_bars", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_bars", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:water", "level": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id"         : "minecraft:iron_bars", 
                        "north"      : "false"              , 
                        "south"      : "false"              , 
                        "east"       : "false"              , 
                        "west"       : "false"              , 
                        "waterlogged": "true"                 
                    }
                }, 
                { "is": {"id": "minecraft:air", "count": 0}, "slot": "hotbar1" }
            ]
        }
    ], 
    "breakpoints": []
}

