{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "waxed_exposed_copper_bars_never_oxidize", 
    "description": "With a high random tick speed, waxed exposed copper bars never change and do not hold back an adjacent unwaxed exposed copper bars, which oxidizes further.", 
    "tags": ["connectible", "bars", "copper-bars", "waxed", "oxidation", "random-tick"], 
    "minecraftIds": [
        "minecraft:waxed_exposed_copper_bars", 
