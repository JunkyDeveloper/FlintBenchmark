                        "id"         : "minecraft:waxed_exposed_copper_bars", 
                        "north"      : "false"                              , 
                        "south"      : "false"                              , 
                        "east"       : "true"                               , 
                        "west"       : "false"                              , 
                        "waterlogged": "false"                                
                    }
                }, 
                {
                    "pos": [1, 0, 0], 
                    "is": {
                        "id"         : "minecraft:exposed_copper_bars", 
                        "north"      : "false"                        , 
