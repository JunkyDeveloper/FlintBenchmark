{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Gate Flammable Wood Allows Fire", 
    "description": "Flint and steel on the top of a non-sturdy slab places fire when a wood fence gate is the only flammable neighbour.", 
    "tags": ["connectible", "fence_gate", "fire", "flammability", "player"], 
    "minecraftIds": [
        "minecraft:oak_fence_gate" , "minecraft:flint_and_steel", "minecraft:stone_slab"     , 
        "minecraft:fire"           
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone_slab"    , "type": "bottom"                   } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:oak_fence_gate",                   "facing": "south"} }  
            ]
        }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:flint_and_steel"}, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:fire"           }                    }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_fence_gate" }                    }, 
                {                   "is": {"id": "minecraft:flint_and_steel"}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

