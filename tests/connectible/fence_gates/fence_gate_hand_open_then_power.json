{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Gate Hand Open Then Power", 
    "description": "A gate opened by hand is marked powered when redstone is applied, then closes and becomes unpowered when the power is removed.", 
    "tags": ["connectible", "fence_gate", "redstone", "interaction", "player"], 
    "minecraftIds": ["minecraft:oak_fence_gate", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 0, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:oak_fence_gate", "facing": "south"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "open": "true", "powered": "false"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "open": "true", "powered": "true"} }
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "open": "false", "powered": "false"} }
            ]
        }
    ], 
    "breakpoints": []
}

