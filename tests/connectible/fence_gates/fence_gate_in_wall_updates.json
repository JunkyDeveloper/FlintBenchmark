{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Gate In Wall Updates", 
    "description": "in_wall follows walls beside an existing gate: it turns on when a wall is added, stays on while either side has a wall, and turns off when the last one is removed.", 
    "tags": ["connectible", "fence_gate", "wall", "neighbor-update"], 
    "minecraftIds": ["minecraft:oak_fence_gate", "minecraft:cobblestone_wall"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [1, 0, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {"id": "minecraft:oak_fence_gate", "facing": "south", "in_wall": "false"}
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "in_wall": "false"} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:cobblestone_wall"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "in_wall": "true"} }
            ]
        }, 
        { "at": 4, "do": "place", "pos": [-1, 0, 0], "block": {"id": "minecraft:cobblestone_wall"} }, 
        { "at": 5, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "in_wall": "true"} }
            ]
        }, 
        { "at": 7, "do": "remove", "pos": [-1, 0, 0] }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "in_wall": "false"} }
            ]
        }
    ], 
    "breakpoints": []
}

