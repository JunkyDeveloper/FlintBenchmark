{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Gate Placement", 
    "description": "A survival player placing a fence gate gets a closed, unpowered gate facing the player's direction, and the item is consumed.", 
    "tags": ["connectible", "fence_gate", "placement", "player"], 
    "minecraftIds": ["minecraft:oak_fence_gate"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:oak_fence_gate"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id"     : "minecraft:oak_fence_gate", 
                        "facing" : "south"                   , 
                        "open"   : "false"                   , 
                        "powered": "false"                   , 
                        "in_wall": "false"                     
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

