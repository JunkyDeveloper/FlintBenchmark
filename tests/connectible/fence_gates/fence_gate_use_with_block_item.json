{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Gate Use With Block Item", 
    "description": "Using a gate while holding a stack of planks (hotbar1 selected) opens the gate instead of placing a block, and the held stack is unchanged.", 
    "tags": ["connectible", "fence_gate", "interaction", "player"], 
    "minecraftIds": ["minecraft:oak_fence_gate", "minecraft:oak_planks"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:oak_fence_gate", "facing": "south"} }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:oak_planks", "count": 5}, 
        {"at": 1, "do": "select_hotbar", "slot": 1}, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "slot": "hotbar1", "is": {"id": "minecraft:oak_planks", "count": 5}                            }, 
                {                    "is": {"id": "minecraft:oak_fence_gate", "open": "false"}, "pos": [0, 0, 0] }  
            ]
        }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence_gate", "open": "true"}                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"}                                               }, 
                {                   "is": {"id": "minecraft:oak_planks", "count": 5}        , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

