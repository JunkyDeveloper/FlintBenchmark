{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Disconnect On Removal", 
    "description": "An oak fence drops the connection on a side when the neighbouring fence or stone block there is removed, leaving the other sides untouched.", 
    "tags": ["connectible", "fence", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:oak_fence", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 0, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 0,  0], "block": {"id": "minecraft:oak_fence"} }, 
                { "pos": [-1, 0,  0], "block": {"id": "minecraft:oak_fence"} }, 
                { "pos": [ 1, 0,  0], "block": {"id": "minecraft:stone"    } }, 
                { "pos": [ 0, 0, -1], "block": {"id": "minecraft:oak_fence"} }, 
                { "pos": [ 0, 0,  1], "block": {"id": "minecraft:stone"    } }  
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [-1, 0, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"   : "minecraft:oak_fence", 
                        "west" : "false"              , 
                        "east" : "true"               , 
                        "north": "true"               , 
                        "south": "true"                 
                    }
                }
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"   : "minecraft:oak_fence", 
                        "west" : "false"              , 
                        "east" : "false"              , 
                        "north": "true"               , 
                        "south": "true"                 
                    }
                }
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [0, 0, -1] }, 
        { "at": 3, "do": "remove", "pos": [0, 0, 1] }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"   : "minecraft:oak_fence", 
                        "west" : "false"              , 
                        "east" : "false"              , 
                        "north": "false"              , 
                        "south": "false"                
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

