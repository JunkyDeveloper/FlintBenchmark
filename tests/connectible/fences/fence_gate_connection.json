{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Gate Connection", 
    "description": "An oak fence connects to a fence gate only when the gate is oriented along the fence's connecting axis, not when it faces end-on.", 
    "tags": ["connectible", "fence", "fence-gate", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:oak_fence", "minecraft:oak_fence_gate"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 0, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:oak_fence"                        } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:oak_fence_gate", "facing": "north"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id"   : "minecraft:oak_fence", 
                        "east" : "true"               , 
                        "west" : "false"              , 
                        "north": "false"              , 
                        "south": "false"                
                    }
                }
            ]
        }, 
        { "at": 1, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:oak_fence_gate", "facing": "east"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence", "east": "false"} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:oak_fence_gate", "facing": "south"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence", "east": "true"} }
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence", "east": "false"} }
            ]
        }
    ], 
    "breakpoints": []
}

