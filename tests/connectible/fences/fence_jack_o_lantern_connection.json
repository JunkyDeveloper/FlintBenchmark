{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Jack O Lantern Connection", 
    "description": "An oak fence does not connect to a jack o'lantern or a carved pumpkin even though their faces are full, and disconnects when a connected block is replaced by one.", 
    "tags": ["connectible", "fence", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:oak_fence", "minecraft:jack_o_lantern", "minecraft:carved_pumpkin"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 0, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:oak_fence"     } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:jack_o_lantern"} }, 
                { "pos": [0, 0, 2], "block": {"id": "minecraft:oak_fence"     } }, 
                { "pos": [1, 0, 2], "block": {"id": "minecraft:carved_pumpkin"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence", "east": "false"} }, 
                { "pos": [0, 0, 2], "is": {"id": "minecraft:oak_fence", "east": "false"} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence", "east": "true"} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:jack_o_lantern"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:oak_fence", "east": "false"} }
            ]
        }
    ], 
    "breakpoints": []
}

