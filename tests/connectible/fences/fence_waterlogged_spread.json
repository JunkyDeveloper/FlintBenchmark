{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Waterlogged Spread", 
    "description": "A waterlogged oak fence acts as a water source and spreads water into adjacent empty space, while staying waterlogged.", 
