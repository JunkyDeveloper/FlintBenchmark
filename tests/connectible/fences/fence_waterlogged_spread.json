            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:oak_fence", "waterlogged": "true"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water"                           } }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:water"                           } }  
