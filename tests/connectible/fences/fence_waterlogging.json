{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fence Waterlogging", 
    "description": "An oak fence placed by hand into a water source replaces the water and becomes waterlogged.", 
    "tags": ["connectible", "fence", "waterlogged", "block-state", "fluid"], 
    "minecraftIds": ["minecraft:oak_fence", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"gamemode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }
            ]
        }, 
        {"at": 2, "do": "interact", "item": "oak_fence"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_fence", "waterlogged": "true"}                    }, 
                {                   "is": "empty"                                             , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

