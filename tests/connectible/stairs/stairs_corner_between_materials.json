{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "stairs_corner_between_materials", 
    "description": "Stairs of different materials still form outer and inner corners with each other.", 
    "tags": ["connectible", "stairs", "shape", "placement", "player"], 
    "minecraftIds": ["minecraft:stone_stairs", "minecraft:oak_stairs", "minecraft:cut_copper_stairs"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [4, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:stone_stairs", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1,  0], "block": {"id": "minecraft:stone"                              } }, 
                { "pos": [4, 1,  0], "block": {"id": "minecraft:stone"                              } }, 
                { "pos": [0, 2,  1], "block": {"id": "minecraft:oak_stairs"       , "facing": "east"} }, 
                { "pos": [4, 2, -1], "block": {"id": "minecraft:cut_copper_stairs", "facing": "west"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "outerleft" } }, 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "innerright"} }  
            ]
        }
    ], 
    "breakpoints": []
}

