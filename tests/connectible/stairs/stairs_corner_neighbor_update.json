{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "stairs_corner_neighbor_update", 
    "description": "An existing straight stair turns into an outer or inner corner when a perpendicular stair appears beside it, and returns to straight when that neighbor is removed.", 
    "tags": ["connectible", "stairs", "shape", "neighbor-update"], 
    "minecraftIds": ["minecraft:stone_stairs"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [4, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone_stairs", "facing": "south"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:stone_stairs", "facing": "south"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1,  1], "block": {"id": "minecraft:stone_stairs", "facing": "east"} }, 
                { "pos": [4, 1, -1], "block": {"id": "minecraft:stone_stairs", "facing": "west"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "outerleft" } }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "innerright"} }  
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [0, 1, 1] }, 
        { "at": 3, "do": "remove", "pos": [4, 1, -1] }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "straight"} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "straight"} }  
            ]
        }
    ], 
    "breakpoints": []
}

