{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "stairs_shape_vertical_update", 
    "description": "A stair's corner shape is not changed by blocks placed directly above or below it, since only horizontal neighbor updates recompute the shape.", 
    "tags": ["connectible", "stairs", "shape", "neighbor-update"], 
    "minecraftIds": ["minecraft:stone_stairs"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 3, 2] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [1, 1, 2], "block": {"id": "minecraft:stone_stairs", "facing": "south"} }, 
        { "at": 1, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:stone_stairs", "facing": "east"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 2], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "innerleft"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 2, 2], "block": {"id": "minecraft:stone"} }, 
        { "at": 3, "do": "place", "pos": [1, 0, 2], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 2], "is": {"id": "minecraft:stone_stairs", "facing": "south", "shape": "innerleft"} }
            ]
        }
    ], 
    "breakpoints": []
}

