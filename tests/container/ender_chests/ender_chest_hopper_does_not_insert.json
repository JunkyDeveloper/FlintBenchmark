{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ender_chest_hopper_does_not_insert", 
    "description": "A hopper pointing into an ender chest keeps all its items because the ender chest is not a container, while an identical hopper feeding a normal chest transfers an item.", 
    "tags": ["container", "ender-chest", "hopper", "block-entity", "redstone"], 
    "minecraftIds": ["minecraft:ender_chest", "minecraft:hopper", "minecraft:chest", "minecraft:cobblestone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [1, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 1, 0], "block": {"id": "minecraft:ender_chest", "facing": "west", "waterlogged": false} }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:chest", "facing": "west"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:hopper", 
                        "facing": "east", 
                        "nbt": {"Items": "[{Slot: 0b, count: 4, id: \"minecraft:cobblestone\"}]", "TransferCooldown": 0}
                    }
                }, 
                {
                    "pos": [0, 1, 2], 
                    "block": {
                        "id": "minecraft:hopper", 
                        "facing": "east", 
                        "nbt": {"Items": "[{Slot: 0b, count: 4, id: \"minecraft:cobblestone\"}]", "TransferCooldown": 0}
                    }
                }
            ]
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 2], 
                    "is": {
                        "id": "minecraft:chest", 
                        "nbt": {"Items[0].id": "minecraft:cobblestone", "Items[0].count": 1}
                    }
                }, 
                {
                    "pos": [0, 1, 2], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items[0].count": 3} }
                }
            ]
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:hopper", 
                        "nbt": {"Items[0].id": "minecraft:cobblestone", "Items[0].count": 4}
                    }
                }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:ender_chest"} }
            ]
        }
    ], 
    "breakpoints": []
}

