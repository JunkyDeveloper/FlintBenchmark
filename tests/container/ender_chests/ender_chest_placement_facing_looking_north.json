{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ender_chest_placement_facing_looking_north", 
    "description": "A survival player looking looking_north (yaw 180) who places an ender chest gets a chest facing south, not waterlogged, and the held chest is consumed.", 
    "tags": ["container", "ender-chest", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:ender_chest", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:ender_chest"}, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [180, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:ender_chest", "facing": "south", "waterlogged": false} }, 
                {"slot": "hotbar1", "is": "empty"}                                                                    
            ]
        }
    ], 
    "breakpoints": []
}

