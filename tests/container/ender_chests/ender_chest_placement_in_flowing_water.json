{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ender_chest_placement_in_flowing_water", 
    "description": "Placing an ender chest into flowing (non-source) water does not waterlog it, because only water source blocks count.", 
    "tags": ["container", "ender-chest", "placement", "waterlogged", "player"], 
    "minecraftIds": ["minecraft:ender_chest", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [2, 1, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [2, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [2, 1, -1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, 1], [2, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 2, 1, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water"} }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 1} }
            ]
        }, 
        {"at": 13, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:ender_chest"}, 
        { "at": 13, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 14, "do": "interact"}, 
        {
            "at": 16, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:ender_chest", "waterlogged": false}                    }, 
                {                   "is": "empty"                                              , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

