{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ender_chest_placement_in_water_source", 
    "description": "Placing an ender chest into a water source block gives a waterlogged chest.", 
    "tags": ["container", "ender-chest", "placement", "waterlogged", "player"], 
    "minecraftIds": ["minecraft:ender_chest", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water"} }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:ender_chest"}, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:ender_chest", "facing": "north", "waterlogged": true} }, 
                {"slot": "hotbar1", "is": "empty"}                                                                   
            ]
        }
    ], 
    "breakpoints": []
}

