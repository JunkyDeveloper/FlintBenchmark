{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ender_chest_survives_tnt_explosion", 
    "description": "An ender chest (blast resistance 600) next to a TNT explosion stays in place and drops nothing, while a glass block in the same blast is destroyed.", 
    "tags": ["container", "ender-chest", "tnt", "explosion", "blast-resistance"], 
    "minecraftIds": ["minecraft:ender_chest", "minecraft:tnt", "minecraft:obsidian", "minecraft:glass"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [6, 3, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [6, 0, 4] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [2, 1, 2], 
                    "block": {"id": "minecraft:ender_chest", "facing": "north", "waterlogged": false}
                }, 
                { "pos": [4, 1, 2], "block": {"id": "minecraft:glass"} }
            ]
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [3.5, 1, 2.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 2], "is": {"id": "minecraft:ender_chest", "facing": "north", "waterlogged": false} }, 
                { "pos": [4, 1, 2], "is": {"id": "minecraft:air"} }                                                 , 
                {"is": "minecraft:item", "exists": false}                                                             
            ]
        }
    ], 
    "breakpoints": []
}

