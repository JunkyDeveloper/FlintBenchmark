{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "furnace_comparator_signal", 
    "description": "A comparator reading a furnace outputs 0 when empty, 1 with a single item and 5 with a full stack in one of its three slots (floor(1/3 * 14) + 1).", 
    "tags": ["container", "furnace", "block-entity", "comparator", "redstone"], 
    "minecraftIds": ["minecraft:furnace", "minecraft:comparator", "minecraft:stone", "minecraft:dirt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [1, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 1, 0], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 4], "block": {"id": "minecraft:comparator", "facing": "west"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:furnace"} }, 
                {
                    "pos": [0, 1, 2], 
                    "block": {
                        "id": "minecraft:furnace", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:dirt\"}]"}
                    }
                }, 
                {
                    "pos": [0, 1, 4], 
                    "block": {
                        "id": "minecraft:furnace", 
                        "nbt": {"Items": "[{Slot: 0b, count: 64, id: \"minecraft:dirt\"}]"}
                    }
                }
            ]
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 0} }
                }, 
                {
                    "pos": [1, 1, 2], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 1} }
                }, 
                {
                    "pos": [1, 1, 4], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 5} }
                }
            ]
        }
    ], 
    "breakpoints": []
}

