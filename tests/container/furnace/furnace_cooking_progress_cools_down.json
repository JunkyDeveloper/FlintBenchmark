{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "furnace_cooking_progress_cools_down", 
    "description": "An unlit furnace with no fuel loses 2 points of cooking progress per tick and stops at 0.", 
