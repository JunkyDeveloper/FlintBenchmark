            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": { "id": "minecraft:furnace", "lit": "false", "nbt": {"cooking_time_spent": "30s"} }
                }
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id": "minecraft:furnace", 
                        "lit": "false", 
                        "nbt": {"cooking_time_spent": "0s", "Items[0].id": "minecraft:raw_iron"}
