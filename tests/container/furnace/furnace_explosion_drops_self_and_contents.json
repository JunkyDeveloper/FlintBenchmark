{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "furnace_explosion_drops_self_and_contents", 
    "description": "A furnace destroyed by an explosion drops itself as one item and spills the contents of its input, fuel and result slots, giving four item entities in total.", 
    "tags": ["container", "furnace", "block-entity", "drops", "explosion"], 
    "minecraftIds": [
        "minecraft:furnace"   , "minecraft:tnt"       , "minecraft:obsidian"  , "minecraft:item"      , 
        "minecraft:dirt"      , "minecraft:coal"      , "minecraft:iron_ingot"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [8, 4, 8] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [4, 0, 4], [8, 0, 8] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [6, 1, 6], 
            "block": {
                "id": "minecraft:furnace", 
                "nbt": {
                    "Items": "[{Slot: 0b, count: 1, id: \"minecraft:dirt\"}, {Slot: 1b, count: 1, id: \"minecraft:coal\"}, {Slot: 2b, count: 1, id: \"minecraft:iron_ingot\"}]"
                }
            }
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [6.5, 1, 5.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [6, 1, 6], "is": {"id": "minecraft:air"}                             }, 
                {                   "is": "minecraft:item"       , "exists": true, "count": 4 }  
            ]
        }
    ], 
    "breakpoints": []
}

