{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "furnace_hopper_side_inserts_only_fuel", 
    "description": "A hopper beside a furnace inserts coal into the fuel slot but refuses an item that is not a fuel.", 
    "tags": ["container", "furnace", "block-entity", "hopper", "item-transfer", "fuel"], 
    "minecraftIds": ["minecraft:furnace", "minecraft:hopper", "minecraft:coal", "minecraft:cobblestone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 0, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:furnace"} }, 
                {
                    "pos": [0, 0, 0], 
                    "block": {
                        "id": "minecraft:hopper", 
                        "facing": "east", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:coal\"}]"}
                    }
                }, 
                {
                    "pos": [2, 0, 0], 
                    "block": {
                        "id": "minecraft:hopper", 
                        "facing": "west", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:cobblestone\"}]"}
                    }
                }
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 0, 0], 
                    "is": {
                        "id": "minecraft:furnace", 
                        "nbt": {"Items[0].id": "minecraft:coal", "Items[0].Slot": "1b", "Items[0].count": 1}
                    }
                }, 
                {
                    "pos": [0, 0, 0], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items": []} }
                }, 
                {
                    "pos": [2, 0, 0], 
                    "is": {
                        "id": "minecraft:hopper", 
                        "nbt": {"Items[0].id": "minecraft:cobblestone", "Items[0].count": 1}
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

