{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "beacon_effect_applied_without_level_check", 
    "description": "A level 1 beacon whose NBT sets the level 4 only Regeneration effect still applies it, since the level check is only in the menu.", 
    "tags": ["decoration", "beacon", "effects", "player"], 
    "minecraftIds": ["minecraft:beacon"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -4], [4, 6, 4] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 3, -1], [1, 3, 1] ], 
            "with": {"id": "minecraft:iron_block"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 4, 0], 
            "block": { "id": "minecraft:beacon", "nbt": {"primary_effect": "minecraft:regeneration"} }
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5] }, 
        {
            "at": 170, 
            "do": "assert", 
            "checks": [ {"is": "minecraft:player", "active_effects[0].id": "minecraft:regeneration"} ]
        }
    ], 
    "breakpoints": []
}

