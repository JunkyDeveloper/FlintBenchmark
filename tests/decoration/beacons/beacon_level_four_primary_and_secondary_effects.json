{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "beacon_level_four_primary_and_secondary_effects", 
    "description": "A level 4 beacon with Speed primary and Regeneration secondary gives the player both effects.", 
    "tags": ["decoration", "beacon", "effects", "player"], 
    "minecraftIds": ["minecraft:beacon"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -4], [4, 6, 4] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-4, 0, -4], [4, 0, 4] ], 
            "with": {"id": "minecraft:iron_block"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-3, 1, -3], [3, 1, 3] ], 
            "with": {"id": "minecraft:iron_block"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 2, -2], [2, 2, 2] ], 
            "with": {"id": "minecraft:iron_block"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 3, -1], [1, 3, 1] ], 
            "with": {"id": "minecraft:iron_block"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 4, 0], 
            "block": {
                "id": "minecraft:beacon", 
                "nbt": {"primary_effect": "minecraft:speed", "secondary_effect": "minecraft:regeneration"}
            }
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5] }, 
        {
            "at": 170, 
            "do": "assert", 
            "checks": [
                {
                    "is"                  : "minecraft:player"      , 
                    "active_effects[0].id": "minecraft:speed"       , 
                    "active_effects[1].id": "minecraft:regeneration"  
                }
            ]
        }
    ], 
    "breakpoints": []
}

