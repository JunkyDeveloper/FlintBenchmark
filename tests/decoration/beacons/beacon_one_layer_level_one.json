{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "beacon_one_layer_level_one", 
    "description": "A beacon on a full 3x3 iron block layer reaches level 1.", 
    "tags": ["decoration", "beacon", "levels", "pyramid"], 
    "minecraftIds": ["minecraft:beacon"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -4], [4, 6, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 3, -1], [1, 3, 1] ], 
            "with": {"id": "minecraft:iron_block"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 4, 0], "block": {"id": "minecraft:beacon"} }, 
        {
            "at": 170, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 4, 0], 
                    "is": { "id": "minecraft:beacon", "nbt": {"Levels": 1} }
                }
            ]
        }
    ], 
    "breakpoints": []
}

