{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bed_half_breaks_without_partner", 
    "description": "A lone bed half stays until a neighbor update arrives from its partner's position holding a non-bed block, then it turns to air.", 
    "tags": ["decoration", "bed", "neighbor-update", "block-state"], 
    "minecraftIds": ["minecraft:red_bed", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 2, 3] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 1], 
            "block": {"id": "minecraft:red_bed", "facing": "south", "part": "foot"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [5, 0, 1], 
            "block": {"id": "minecraft:red_bed", "facing": "south", "part": "head"}
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 1], "is": {"id": "minecraft:red_bed", "facing": "south", "part": "foot"} }, 
                { "pos": [5, 0, 1], "is": {"id": "minecraft:red_bed", "facing": "south", "part": "head"} }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 0, 2], "block": {"id": "minecraft:stone"} }, 
        { "at": 2, "do": "place", "pos": [5, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 1], "is": {"id": "minecraft:air"  } }, 
                { "pos": [0, 0, 2], "is": {"id": "minecraft:stone"} }, 
                { "pos": [5, 0, 1], "is": {"id": "minecraft:air"  } }, 
                { "pos": [5, 0, 0], "is": {"id": "minecraft:stone"} }  
            ]
        }
    ], 
    "breakpoints": []
}

