{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bed_placement_head_space", 
    "description": "A bed cannot be placed when the block where its head would go is not replaceable, but it replaces a replaceable block such as short grass.", 
    "tags": ["decoration", "bed", "placement", "replaceable", "player"], 
    "minecraftIds": ["minecraft:red_bed", "minecraft:short_grass"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 3, 4] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:red_bed"} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 1], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [5, 0, 1], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [5, 0, 2], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [5, 1, 2], "block": {"id": "minecraft:short_grass"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [1.5, 3, 1.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"    }                    }, 
                { "pos": [1, 1, 2], "is": {"id": "minecraft:stone"  }                    }, 
                {                   "is": {"id": "minecraft:red_bed"}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [5.5, 3, 1.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [5, 1, 1], "is": {"id": "minecraft:red_bed", "facing": "south", "part": "foot"} }, 
                { "pos": [5, 1, 2], "is": {"id": "minecraft:red_bed", "facing": "south", "part": "head"} }, 
                {"is": "empty", "slot": "hotbar1"}                                                          
            ]
        }
    ], 
    "breakpoints": []
}

