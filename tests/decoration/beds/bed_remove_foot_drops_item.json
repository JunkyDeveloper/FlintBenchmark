                { "pos": [0, 0, 0], "is": {"id": "minecraft:red_bed", "facing": "south", "part": "foot"} }, 
                { "pos": [0, 0, 1], "is": {"id": "minecraft:red_bed", "facing": "south", "part": "head"} }  
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }                                 , 
                { "pos": [0, 0, 1], "is": {"id": "minecraft:air"} }                                 , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:red_bed"}  
