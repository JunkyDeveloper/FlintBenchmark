{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bed_remove_head_no_drop", 
    "description": "Removing the head of a bed also destroys the foot, but no bed item drops because only the head half has a loot entry.", 
    "tags": ["decoration", "bed", "drops", "neighbor-update"], 
    "minecraftIds": ["minecraft:red_bed"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 3] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {"id": "minecraft:red_bed", "facing": "south", "part": "foot"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 1], 
            "block": {"id": "minecraft:red_bed", "facing": "south", "part": "head"}
        }, 
        { "at": 1, "do": "remove", "pos": [0, 0, 1] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"}                  }, 
                { "pos": [0, 0, 1], "is": {"id": "minecraft:air"}                  }, 
                {                   "is": "minecraft:item"       , "exists": false }  
            ]
        }
    ], 
    "breakpoints": []
}

