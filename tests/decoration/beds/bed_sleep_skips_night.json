{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bed_sleep_skips_night", 
    "description": "A player sleeping in a bed through the night skips the night to morning, wakes up, and both bed halves become unoccupied again; a daylight detector reads night power before and morning power after the skip.", 
    "tags": ["decoration", "bed", "sleeping", "time", "world-config", "player"], 
    "minecraftIds": ["minecraft:red_bed"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 3] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "time": "minecraft:midnight", 
            "gamerules": {
                "minecraft:spawn_mobs"     : false, 
                "minecraft:advance_time"   : true , 
                "minecraft:advance_weather": false  
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {"id": "minecraft:red_bed", "facing": "south", "part": "foot"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 1], 
            "block": {"id": "minecraft:red_bed", "facing": "south", "part": "head"}
        }, 
        { "at": 0, "do": "place", "pos": [2, 0, 0], "block": {"id": "minecraft:daylight_detector"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:red_bed", "part": "foot", "occupied": true} }, 
                { "pos": [0, 0, 1], "is": {"id": "minecraft:red_bed", "part": "head", "occupied": true} }, 
                {"time": 18005}                                                                            
            ]
        }, 
        {
            "at": 90, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:red_bed", "part": "foot", "occupied": true} }, 
                {"time": 18090}                                                                          , 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:daylight_detector", "power": 0} }              
            ]
        }, 
        {
            "at": 130, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:red_bed", "part": "foot", "occupied": false} }, 
                { "pos": [0, 0, 1], "is": {"id": "minecraft:red_bed", "part": "head", "occupied": false} }, 
                {
                    "pos": [2, 0, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 6}, 
                        {"id": "minecraft:daylight_detector", "power": 7}, 
                        {"id": "minecraft:daylight_detector", "power": 8}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

