{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cauldron_bucket_under_water", 
    "description": "With water directly above an empty cauldron, lava and powder snow buckets are refused, while a water bucket still fills it to level 3.", 
    "tags": ["decoration", "cauldron", "bucket", "water", "interaction", "player"], 
    "minecraftIds": [
        "minecraft:cauldron"          , "minecraft:water_cauldron"    , "minecraft:water"             , 
        "minecraft:lava_bucket"       , "minecraft:powder_snow_bucket", "minecraft:water_bucket"      
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 4, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [-1, 3, -1], [5, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:water"   } }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:water"   } }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:water"   } }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, -0.5], "rot": [0, 72] }, 
        {"at": 2, "do": "interact", "item": "minecraft:lava_bucket"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:cauldron"   }                    }, 
                {                   "is": {"id": "minecraft:lava_bucket"}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [2.5, 3, -0.5], "rot": [0, 72] }, 
        {"at": 3, "do": "interact", "item": "minecraft:powder_snow_bucket"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:cauldron"          }                    }, 
                {                   "is": {"id": "minecraft:powder_snow_bucket"}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, -0.5], "rot": [0, 72] }, 
        {"at": 4, "do": "interact", "item": "minecraft:water_bucket"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 1, 0], "is": {"id": "minecraft:water_cauldron", "level": 3}                    }, 
                {                   "is": {"id": "minecraft:bucket"                    }, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

