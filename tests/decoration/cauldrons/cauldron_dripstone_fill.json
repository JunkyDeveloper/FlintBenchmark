{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cauldron_dripstone_fill", 
    "description": "Pointed dripstone under a water source fills an empty cauldron with water, and one under a lava source fills it with lava.", 
    "tags": ["decoration", "cauldron", "dripstone", "random-tick", "empty-cauldron"], 
    "minecraftIds": [
        "minecraft:cauldron"         , "minecraft:water_cauldron"   , "minecraft:lava_cauldron"    , 
        "minecraft:pointed_dripstone", "minecraft:dripstone_block"  , "minecraft:water"            , 
        "minecraft:lava"             
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 6, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 2000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 5, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 6, -1], [3, 6, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:air"} }, 
                { "pos": [0, 4, 0], "block": {"id": "minecraft:dripstone_block"} }, 
                {
                    "pos": [0, 3, 0], 
                    "block": {"id": "minecraft:pointed_dripstone", "thickness": "tip", "vertical_direction": "down"}
                }, 
                { "pos": [0, 5, 0], "block": {"id": "minecraft:water"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:air"} }, 
                { "pos": [2, 4, 0], "block": {"id": "minecraft:dripstone_block"} }, 
                {
                    "pos": [2, 3, 0], 
                    "block": {"id": "minecraft:pointed_dripstone", "thickness": "tip", "vertical_direction": "down"}
                }, 
                { "pos": [2, 5, 0], "block": {"id": "minecraft:lava"} }
            ]
        }, 
        {
            "at": 250, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:water_cauldron", "level": 1}, 
                        {"id": "minecraft:water_cauldron", "level": 2}, 
                        {"id": "minecraft:water_cauldron", "level": 3}  
                    ]
                }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:lava_cauldron"} }
            ]
        }
    ], 
    "breakpoints": []
}

