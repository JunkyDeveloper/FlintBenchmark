{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cauldron_ignores_empty_containers", 
    "description": "An empty bucket or a glass bottle used on an empty cauldron changes nothing and stays in the hand.", 
    "tags": ["decoration", "cauldron", "bucket", "bottle", "interaction", "player"], 
    "minecraftIds": ["minecraft:cauldron", "minecraft:bucket", "minecraft:glass_bottle"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [-1, 1, 0], [3, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [-1, 2, -1], [3, 4, -1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:cauldron"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, -0.5], "rot": [0, 65] }, 
        {"at": 2, "do": "interact", "item": "minecraft:bucket"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:cauldron"}                    }, 
                {                   "is": {"id": "minecraft:bucket"  }, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, -0.5], "rot": [0, 65] }, 
        {"at": 3, "do": "interact", "item": "minecraft:glass_bottle"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:cauldron"    }                    }, 
                {                   "is": {"id": "minecraft:glass_bottle"}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

