{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "powder_snow_cauldron_dripstone", 
    "description": "Water and lava drips leave a powder snow cauldron unchanged, while an empty cauldron under the same water source does fill.", 
    "tags": ["decoration", "cauldron", "dripstone", "random-tick", "powder-snow-cauldron"], 
    "minecraftIds": [
        "minecraft:powder_snow_cauldron", "minecraft:cauldron"            , "minecraft:water_cauldron"      , 
        "minecraft:pointed_dripstone"   , "minecraft:dripstone_block"     , "minecraft:water"               , 
        "minecraft:lava"                
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 6, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 2000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 5, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 6, -1], [5, 6, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:powder_snow_cauldron", "level": 1} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:air"} }, 
                { "pos": [0, 4, 0], "block": {"id": "minecraft:dripstone_block"} }, 
                {
                    "pos": [0, 3, 0], 
                    "block": {"id": "minecraft:pointed_dripstone", "thickness": "tip", "vertical_direction": "down"}
                }, 
                { "pos": [0, 5, 0], "block": {"id": "minecraft:water"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:powder_snow_cauldron", "level": 1} }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:air"} }, 
                { "pos": [2, 4, 0], "block": {"id": "minecraft:dripstone_block"} }, 
                {
                    "pos": [2, 3, 0], 
                    "block": {"id": "minecraft:pointed_dripstone", "thickness": "tip", "vertical_direction": "down"}
                }, 
                { "pos": [2, 5, 0], "block": {"id": "minecraft:lava"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:cauldron"} }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:air"} }, 
                { "pos": [4, 4, 0], "block": {"id": "minecraft:dripstone_block"} }, 
                {
                    "pos": [4, 3, 0], 
                    "block": {"id": "minecraft:pointed_dripstone", "thickness": "tip", "vertical_direction": "down"}
                }, 
                { "pos": [4, 5, 0], "block": {"id": "minecraft:water"} }
            ]
        }, 
        {
            "at": 250, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [4, 1, 0], 
                    "is": [
                        {"id": "minecraft:water_cauldron", "level": 1}, 
                        {"id": "minecraft:water_cauldron", "level": 2}, 
                        {"id": "minecraft:water_cauldron", "level": 3}  
                    ]
                }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:powder_snow_cauldron", "level": 1} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:powder_snow_cauldron", "level": 1} }
            ]
        }
    ], 
    "breakpoints": []
}

