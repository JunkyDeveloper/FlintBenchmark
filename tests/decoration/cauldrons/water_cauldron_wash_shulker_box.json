        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [-1, 2, -1], [3, 4, -1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:water_cauldron", "level": 3} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:water_cauldron", "level": 3} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, -0.5], "rot": [0, 65] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
