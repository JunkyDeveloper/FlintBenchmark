            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water_cauldron", "level": 2}                    }, 
                {                   "is": {"id": "minecraft:shulker_box"               }, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, -0.5], "rot": [0, 65] }, 
        {"at": 3, "do": "interact", "item": "minecraft:shulker_box"}, 
        {
            "at": 4, 
