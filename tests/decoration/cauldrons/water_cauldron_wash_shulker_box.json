{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "water_cauldron_wash_shulker_box", 
    "description": "A water cauldron turns a dyed shulker box into a plain one and loses a level, while a plain shulker box leaves the level unchanged.", 
    "tags": ["decoration", "cauldron", "water-cauldron", "washing", "interaction", "player"], 
    "minecraftIds": ["minecraft:water_cauldron", "minecraft:red_shulker_box", "minecraft:shulker_box"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:red_shulker_box"} }, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
