{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_chain_wax_round_trip", 
    "description": "Honeycomb waxes a copper chain into waxed_copper_chain (HoneycombItem.WAXABLES), keeping axis and waterlogged, and uses up one honeycomb; a second honeycomb on the waxed chain passes without being consumed. An axe then removes the wax (WAX_OFF_BY_BLOCK) back to copper_chain, and another axe use leaves the unaffected chain unchanged because it has no earlier stage and no wax.", 
    "tags": ["chain", "copper_chain", "honeycomb", "axe", "wax", "block-state", "player"], 
    "minecraftIds": [
        "minecraft:copper_chain"      , "minecraft:waxed_copper_chain", "minecraft:honeycomb"         , 
        "minecraft:iron_axe"          , "minecraft:stone"             
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": {
                "hotbar1": {"id": "minecraft:honeycomb", "count": 2}, 
                "hotbar2": {"id": "minecraft:iron_axe"             }  
            }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                         } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:copper_chain", "axis": "x", "waterlogged": true} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:waxed_copper_chain", "axis": "x", "waterlogged": true} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:honeycomb", "count": 1} }                                
            ]
        }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:waxed_copper_chain", "axis": "x", "waterlogged": true} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:honeycomb", "count": 1} }                                
            ]
        }, 
        {"at": 5, "do": "select_hotbar", "slot": 2}, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_chain", "axis": "x", "waterlogged": true} }
            ]
        }, 
        {"at": 8, "do": "interact"}, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_chain", "axis": "x", "waterlogged": true} }, 
                { "slot": "hotbar2", "is": {"id": "minecraft:iron_axe"} }                                       
            ]
        }
    ], 
    "breakpoints": []
}

