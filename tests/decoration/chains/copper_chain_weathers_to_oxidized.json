{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_chain_weathers_to_oxidized", 
    "description": "WeatheringCopperChainBlock random-ticks while a next stage exists: an isolated copper chain passes through exposed and weathered to oxidized_copper_chain keeping axis and waterlogged. A waxed copper chain (plain ChainBlock, no random ticking) placed far away under the same random tick speed stays unchanged as a control. 400 ticks are allowed (about 110 expected).", 
    "tags": ["chain", "copper_chain", "random-tick", "weathering", "block-state"], 
    "minecraftIds": [
        "minecraft:copper_chain"         , "minecraft:oxidized_copper_chain", "minecraft:waxed_copper_chain"   , 
        "minecraft:stone"                
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [11, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:copper_chain", "axis": "x", "waterlogged": false} }, 
                { "pos": [10, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [10, 1, 0], 
                    "block": {"id": "minecraft:waxed_copper_chain", "axis": "x", "waterlogged": false}
                }
            ]
        }, 
        {
            "at": 400, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:oxidized_copper_chain", "axis": "x", "waterlogged": false}
                }, 
                { "pos": [10, 1, 0], "is": {"id": "minecraft:waxed_copper_chain", "axis": "x", "waterlogged": false} }
            ]
        }
    ], 
    "breakpoints": []
}

