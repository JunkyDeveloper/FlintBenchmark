{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "iron_chain_ignores_axe_and_honeycomb", 
    "description": "Iron chain is not in the copper waxing or weathering maps (HoneycombItem.WAXABLES, WeatheringCopper.NEXT_BY_BLOCK), so an axe and a honeycomb used on it leave the block unchanged and the honeycomb is not consumed.", 
    "tags": ["chain", "iron_chain", "axe", "honeycomb", "interaction", "player"], 
    "minecraftIds": ["minecraft:iron_chain", "minecraft:iron_axe", "minecraft:honeycomb", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": {
                "hotbar1": {"id": "minecraft:iron_axe"             }, 
                "hotbar2": {"id": "minecraft:honeycomb", "count": 3}  
            }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                        } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": false} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {"at": 2, "do": "select_hotbar", "slot": 2}, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": false} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:iron_axe"} }                                    , 
                { "slot": "hotbar2", "is": {"id": "minecraft:honeycomb", "count": 3} }                         
            ]
        }
    ], 
    "breakpoints": []
}

