{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "iron_chain_not_flowed_into_by_fluids", 
    "description": "An unwaterlogged iron chain blocks motion, so FlowingFluid.canHoldAnyFluid rejects it: water and lava sources placed beside and above a chain never replace it or waterlog it.", 
    "tags": ["chain", "iron_chain", "fluid", "water", "lava"], 
    "minecraftIds": ["minecraft:iron_chain", "minecraft:stone", "minecraft:water", "minecraft:lava"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-3, 0, -3], [8, 3, 3] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-3, 0, -3], [8, 0, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [2, 1, -3], [2, 3, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0] , "block": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": false} }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:water", "level": 0}                             }, 
                { "pos": [0, 2, 0] , "block": {"id": "minecraft:water", "level": 0}                             }, 
                { "pos": [5, 1, 0] , "block": {"id": "minecraft:iron_chain", "axis": "x", "waterlogged": false} }, 
                { "pos": [6, 1, 0] , "block": {"id": "minecraft:lava", "level": 0}                              }, 
                { "pos": [5, 2, 0] , "block": {"id": "minecraft:lava", "level": 0}                              }  
            ]
        }, 
        {
            "at": 80, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": false} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "x", "waterlogged": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

