{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "iron_chain_placement_axis_from_face", 
    "description": "Placing an iron chain sets its axis from the clicked face (RotatedPillarBlock.getStateForPlacement): top gives y, north/south faces give z, east/west faces give x. Each placement uses up one item and is not waterlogged.", 
    "tags": ["chain", "iron_chain", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:iron_chain", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [8, 3, 3] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_chain", "count": 4} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [3, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [6, 1, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [3.5, 0, -1.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [8.5, 0, 0.5], "rot": [90, 0] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": false} } , 
                { "pos": [3, 1, -1], "is": {"id": "minecraft:iron_chain", "axis": "z", "waterlogged": false} }, 
                { "pos": [7, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "x", "waterlogged": false} } , 
                { "slot": "hotbar1", "is": {"id": "minecraft:iron_chain", "count": 1} }                         
            ]
        }
    ], 
    "breakpoints": []
}

