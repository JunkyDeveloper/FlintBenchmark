{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "iron_chain_waterlogged_only_from_source", 
    "description": "ChainBlock.getStateForPlacement waterlogs the chain only when the replaced fluid is a water source: a chain placed into a source block has waterlogged=true, one placed into flowing water has waterlogged=false.", 
    "tags": ["chain", "iron_chain", "waterlogged", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:iron_chain", "minecraft:stone", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -2], [8, 3, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_chain", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [5, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [5, 1, 0], "block": {"id": "minecraft:water", "level": 1} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [5.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": true} } , 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:iron_chain", "axis": "y", "waterlogged": false} }, 
                {"slot": "hotbar1", "is": "empty"}                                                             
            ]
        }
    ], 
    "breakpoints": []
}

