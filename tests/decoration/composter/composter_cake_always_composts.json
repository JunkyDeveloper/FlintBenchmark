{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "composter_cake_always_composts", 
    "description": "A survival player using a cake (chance 1.0) on a level 3 composter always raises it to level 4 and consumes the cake.", 
    "tags": ["composter", "interaction", "player", "composting"], 
    "minecraftIds": ["minecraft:composter", "minecraft:cake", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {
            "selected_hotbar": 1, 
            "inventory": { "hotbar1": {"id": "minecraft:cake", "count": 1} }, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:composter", "level": 3} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:composter", "level": 4}                    }, 
                {                   "is": "empty"                                  , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

