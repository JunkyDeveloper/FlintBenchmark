{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "composter_first_item_always_composts", 
    "description": "A survival player using wheat seeds (30% chance) on an empty composter always raises it to level 1, because ComposterBlock.addItem skips the random roll at level 0, and the held stack shrinks by one.", 
    "tags": ["composter", "composting", "interaction", "player"], 
    "minecraftIds": ["minecraft:composter", "minecraft:wheat_seeds", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:wheat_seeds", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:composter", "level": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:composter"  , "level": 1            }                    }, 
                {                   "is": {"id": "minecraft:wheat_seeds",             "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

