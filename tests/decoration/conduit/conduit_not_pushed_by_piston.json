{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Conduit Not Pushed By Piston", 
    "description": "A conduit has a block entity, so PistonBaseBlock.isPushable rejects it: a powered piston facing it neither moves it nor extends.", 
    "tags": ["conduit", "piston", "block-entity", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:conduit", "minecraft:piston"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:conduit", "waterlogged": false}                 }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:conduit", "waterlogged": false}                 }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"}                                           }  
            ]
        }
    ], 
    "breakpoints": []
}

