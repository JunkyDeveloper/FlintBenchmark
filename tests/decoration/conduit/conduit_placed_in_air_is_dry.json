{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Conduit Placed In Air Is Dry", 
    "description": "A conduit placed by a player in air is not waterlogged: getStateForPlacement only sets waterlogged for a full water fluid state, overriding the registered default of true.", 
    "tags": ["conduit", "placement", "waterlogging", "block-state", "player"], 
    "minecraftIds": ["minecraft:conduit"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:conduit"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:conduit", "waterlogged": false}                    }, 
                {                   "is": "empty"                                          , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
