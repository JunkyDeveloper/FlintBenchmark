{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_axe_blocked_by_offhand_shield", 
    "description": "An axe in the main hand does not remove wax from a waxed copper grate while a shield is held in the off hand (AxeItem.playerHasBlockingItemUseIntent), but once the shield is removed the same axe removes the wax.", 
    "tags": ["decoration", "copper-grate", "axe", "wax", "shield", "off-hand", "player"], 
    "minecraftIds": [
        "minecraft:waxed_copper_grate", "minecraft:copper_grate"      , "minecraft:iron_axe"          , 
        "minecraft:shield"            
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                   } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:waxed_copper_grate", "waterlogged": false} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "set_slot", "slot": "off_hand", "item": "minecraft:shield"}, 
        {"at": 2, "do": "interact", "item": "minecraft:iron_axe"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:waxed_copper_grate", "waterlogged": false} }, 
                { "slot": "off_hand", "is": {"id": "minecraft:shield"} }                                , 
                { "slot": "hotbar1", "is": {"id": "minecraft:iron_axe"} }                                 
            ]
        }, 
        {"at": 4, "do": "set_slot", "slot": "off_hand"}, 
        {"at": 5, "do": "interact", "item": "minecraft:iron_axe"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": false}                     }, 
                {                   "is": "empty"                                               , "slot": "off_hand" }  
            ]
        }
    ], 
    "breakpoints": []
}

