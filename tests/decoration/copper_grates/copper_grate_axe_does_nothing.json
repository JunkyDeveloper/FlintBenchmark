{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_axe_does_nothing", 
    "description": "An axe used on an unwaxed, unweathered copper grate does nothing: there is no earlier oxidation stage to scrape back to and no wax to remove (AxeItem.useOn passes). An oak log used with the same axe is stripped, which proves the axe interaction itself worked.", 
    "tags": ["decoration", "copper-grate", "axe", "weathering", "block-state", "player"], 
    "minecraftIds": [
        "minecraft:copper_grate"    , "minecraft:iron_axe"        , "minecraft:oak_log"         , 
        "minecraft:stripped_oak_log"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [4, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [4, 0, 0] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:copper_grate", "waterlogged": false             } }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:oak_log"     ,                       "axis": "y"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:iron_axe"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:iron_axe"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 1, 0], "is": {"id": "minecraft:stripped_oak_log", "axis": "y"}                         }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": false}                    }, 
                {                   "is": {"id": "minecraft:iron_axe"}                          , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

