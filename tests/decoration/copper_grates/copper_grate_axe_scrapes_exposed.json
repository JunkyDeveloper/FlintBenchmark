{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_axe_scrapes_exposed", 
    "description": "An axe used on an exposed copper grate scrapes it back to a plain copper grate (WeatheringCopper.getPrevious) and keeps its waterlogged state; the axe is not consumed.", 
    "tags": ["decoration", "copper-grate", "axe", "weathering", "scrape", "block-state", "player"], 
    "minecraftIds": ["minecraft:exposed_copper_grate", "minecraft:copper_grate", "minecraft:iron_axe"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                    } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:exposed_copper_grate", "waterlogged": true} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:iron_axe"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": true}                    }, 
                {                   "is": {"id": "minecraft:iron_axe"                         }, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

