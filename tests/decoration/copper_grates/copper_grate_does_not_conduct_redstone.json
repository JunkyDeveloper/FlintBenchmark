{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_does_not_conduct_redstone", 
    "description": "A powered lever attached to a copper grate does not power a redstone lamp on the opposite side, because the grate is not a redstone conductor (isRedstoneConductor = never); the same setup with stone lights the lamp.", 
    "tags": ["decoration", "copper-grate", "redstone", "conductor", "lever", "redstone-lamp"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:stone", "minecraft:lever", "minecraft:redstone_lamp"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [1, 1, 4] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, 0], [1, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 1, 0], "block": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [1, 1, 4], "block": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                {
                    "pos": [-1, 1, 0], 
                    "block": {"id": "minecraft:lever", "face": "wall", "facing": "west", "powered": true}
                }, 
                {
                    "pos": [-1, 1, 4], 
                    "block": {"id": "minecraft:lever", "face": "wall", "facing": "west", "powered": true}
                }
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:copper_grate", "waterlogged": false} }, 
                { "pos": [0, 1, 4], "block": {"id": "minecraft:stone"                             } }  
            ]
        }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [-1, 1, 0], 
                    "is": {"id": "minecraft:lever", "face": "wall", "facing": "west", "powered": true}
                }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                {
                    "pos": [-1, 1, 4], 
                    "is": {"id": "minecraft:lever", "face": "wall", "facing": "west", "powered": true}
                }, 
                { "pos": [1, 1, 4], "is": {"id": "minecraft:redstone_lamp", "lit": true} }
            ]
        }
    ], 
    "breakpoints": []
}

