{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_honeycomb_waxes", 
    "description": "Using honeycomb on a copper grate turns it into a waxed copper grate (HoneycombItem.useOn), keeps its waterlogged state and consumes one honeycomb.", 
    "tags": ["decoration", "copper-grate", "honeycomb", "wax", "block-state", "player"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:waxed_copper_grate", "minecraft:honeycomb"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                            } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:copper_grate", "waterlogged": true} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:honeycomb"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:waxed_copper_grate", "waterlogged": true} }, 
                {"slot": "hotbar1", "is": "empty"}                                                       
            ]
        }
    ], 
    "breakpoints": []
}

