{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_oxidized_stays_oxidized", 
    "description": "With a very high random tick speed an oxidized copper grate never changes (isRandomlyTicking is false because there is no next stage), while an unwaxed copper grate in the same world does age.", 
    "tags": ["decoration", "copper-grate", "weathering", "oxidation", "random-tick", "block-state"], 
    "minecraftIds": ["minecraft:oxidized_copper_grate", "minecraft:copper_grate"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [6, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [6, 0, 0] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oxidized_copper_grate", "waterlogged": false} }, 
                { "pos": [6, 1, 0], "block": {"id": "minecraft:copper_grate"         , "waterlogged": false} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oxidized_copper_grate", "waterlogged": false} }, 
                { "pos": [6, 1, 0], "is": {"id": "minecraft:copper_grate"         , "waterlogged": false} }  
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oxidized_copper_grate", "waterlogged": false} }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oxidized_copper_grate", "waterlogged": false} }
            ]
        }, 
        {
            "at": 300, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oxidized_copper_grate", "waterlogged": false} }, 
                {
                    "pos": [6, 1, 0], 
                    "is": [
                        {"id": "minecraft:exposed_copper_grate"  , "waterlogged": false}, 
                        {"id": "minecraft:weathered_copper_grate", "waterlogged": false}, 
                        {"id": "minecraft:oxidized_copper_grate" , "waterlogged": false}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

