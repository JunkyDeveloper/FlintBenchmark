{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_oxidizes_over_time", 
    "description": "With a very high random tick speed an exposed copper grate randomly ticks through the remaining oxidation stages (WeatheringCopperGrateBlock.randomTick) and ends up as an oxidized copper grate, keeping its waterlogged state.", 
    "tags": ["decoration", "copper-grate", "weathering", "oxidation", "random-tick", "block-state"], 
    "minecraftIds": [
        "minecraft:exposed_copper_grate"  , "minecraft:weathered_copper_grate", "minecraft:oxidized_copper_grate" 
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                    } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:exposed_copper_grate", "waterlogged": true} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:exposed_copper_grate", "waterlogged": true} }
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:exposed_copper_grate"  , "waterlogged": true}, 
                        {"id": "minecraft:weathered_copper_grate", "waterlogged": true}, 
                        {"id": "minecraft:oxidized_copper_grate" , "waterlogged": true}  
                    ]
                }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:exposed_copper_grate"  , "waterlogged": true}, 
                        {"id": "minecraft:weathered_copper_grate", "waterlogged": true}, 
                        {"id": "minecraft:oxidized_copper_grate" , "waterlogged": true}  
                    ]
                }
            ]
        }, 
        {
            "at": 300, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oxidized_copper_grate", "waterlogged": true} }
            ]
        }
    ], 
    "breakpoints": []
}

