{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_passes_skylight", 
    "description": "A daylight detector in a sealed chamber roofed by a copper grate receives skylight (TransparentBlock.propagatesSkylightDown) and powers its adjacent redstone lamp at noon; an identical chamber roofed by stone stays dark.", 
    "tags": ["decoration", "copper-grate", "skylight", "daylight-detector", "redstone-lamp", "world-config"], 
    "minecraftIds": [
        "minecraft:copper_grate"     , "minecraft:stone"            , "minecraft:daylight_detector", 
        "minecraft:redstone_lamp"    
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 2, 7] ]
        }, 
        "world": {
            "time": "minecraft:noon", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 7] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"}                                }, 
                { "pos": [0, 1, -1], "block": {"id": "minecraft:stone"}                                }, 
                { "pos": [0, 1, 1] , "block": {"id": "minecraft:stone"}                                }, 
                { "pos": [1, 1, 0] , "block": {"id": "minecraft:redstone_lamp", "lit": false}          }, 
                { "pos": [0, 1, 0] , "block": {"id": "minecraft:daylight_detector", "inverted": false} }, 
                { "pos": [0, 2, 0] , "block": {"id": "minecraft:copper_grate", "waterlogged": false}   }, 
                { "pos": [-1, 1, 6], "block": {"id": "minecraft:stone"}                                }, 
                { "pos": [0, 1, 5] , "block": {"id": "minecraft:stone"}                                }, 
                { "pos": [0, 1, 7] , "block": {"id": "minecraft:stone"}                                }, 
                { "pos": [1, 1, 6] , "block": {"id": "minecraft:redstone_lamp", "lit": false}          }, 
                { "pos": [0, 1, 6] , "block": {"id": "minecraft:daylight_detector", "inverted": false} }, 
                { "pos": [0, 2, 6] , "block": {"id": "minecraft:stone"}                                }  
            ]
        }, 
        {
            "at": 50, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:copper_grate" , "waterlogged": false              } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:redstone_lamp",                       "lit": true } }, 
                { "pos": [1, 1, 6], "is": {"id": "minecraft:redstone_lamp",                       "lit": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

