{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_placed_in_flowing_water_is_not_waterlogged", 
    "description": "A copper grate placed into flowing (non-source) water is not waterlogged, because getStateForPlacement only checks fluidState.is(Fluids.WATER), which is the source fluid type.", 
    "tags": ["decoration", "copper-grate", "placement", "waterlogging", "water", "block-state", "player"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [2, 1, 1] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [2, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 2, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  0], "block": {"id": "minecraft:water"} }  
            ]
        }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water", "level": 1} }  
            ]
        }, 
        { "at": 13, "do": "tp", "entity_alias": "player", "pos": [1.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 13, "do": "interact", "item": "minecraft:copper_grate"}, 
        {
            "at": 14, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": false}                    }, 
                {                   "is": "empty"                                               , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

