{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_placed_in_water_source_is_waterlogged", 
    "description": "A copper grate placed by a player into a water source block becomes waterlogged (getStateForPlacement sets waterlogged when the replaced fluid is water).", 
    "tags": ["decoration", "copper-grate", "placement", "waterlogging", "water", "block-state", "player"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 1, 1] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 0,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  0], "block": {"id": "minecraft:water"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:copper_grate"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": true}                    }, 
                {                   "is": "empty"                                              , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

