{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_pushed_by_piston_loses_waterlogged", 
    "description": "An extending piston pushes a waterlogged copper grate one block (normal push reaction) but PistonMovingBlockEntity clears waterlogged when the moved block is placed, so the grate arrives at its new position with waterlogged=false.", 
    "tags": ["decoration", "copper-grate", "piston", "push-reaction", "waterlogging", "redstone"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:piston"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:copper_grate", "waterlogged": true}             }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": true}             }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"}                                           }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "true"}    }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east", "type": "normal"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": false}              }  
            ]
        }
    ], 
    "breakpoints": []
}

