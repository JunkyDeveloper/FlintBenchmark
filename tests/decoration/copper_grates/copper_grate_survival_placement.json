{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_survival_placement", 
    "description": "A player using a copper grate on top of stone places it with waterlogged=false (WaterloggedTransparentBlock.getStateForPlacement) and consumes the item.", 
    "tags": ["decoration", "copper-grate", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:copper_grate"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:copper_grate", "waterlogged": false}                    }, 
                {                   "is": "empty"                                               , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

