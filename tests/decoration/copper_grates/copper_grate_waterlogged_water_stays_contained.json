{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_grate_waterlogged_water_stays_contained", 
    "description": "A waterlogged copper grate does not release water into adjacent air even after a player placement next to it triggers a fluid tick, because its full-block collision shape stops FlowingFluid.canPassThroughWall; a waterlogged bottom slab in an identical walled pocket is the control and does spread.", 
    "tags": ["decoration", "copper-grate", "waterlogging", "water", "fluid", "block-state", "player"], 
    "minecraftIds": ["minecraft:copper_grate", "minecraft:oak_slab", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [10, 3, 2] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -2], [2, 1, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [6, 0, -2], [10, 1, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [1, 1, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [7, 1, -1], [9, 1, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:copper_grate", "waterlogged": true                  } }, 
                { "pos": [8, 1, 0], "block": {"id": "minecraft:oak_slab"    , "waterlogged": true, "type": "bottom"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:stone"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [8.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact", "item": "minecraft:stone"}, 
        {
            "at": 17, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0] , "is": {"id": "minecraft:stone"}                                           }, 
                { "pos": [8, 2, 0] , "is": {"id": "minecraft:stone"}                                           }, 
                { "pos": [8, 1, 0] , "is": {"id": "minecraft:oak_slab", "type": "bottom", "waterlogged": true} }, 
                { "pos": [9, 1, 0] , "is": {"id": "minecraft:water", "level": 1}                               }, 
                { "pos": [7, 1, 0] , "is": {"id": "minecraft:water", "level": 1}                               }, 
                { "pos": [8, 1, 1] , "is": {"id": "minecraft:water", "level": 1}                               }, 
                { "pos": [8, 1, -1], "is": {"id": "minecraft:water", "level": 1}                               }, 
                { "pos": [0, 1, 0] , "is": {"id": "minecraft:copper_grate", "waterlogged": true}               }, 
                { "pos": [1, 1, 0] , "is": {"id": "minecraft:air"}                                             }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:air"}                                             }, 
                { "pos": [0, 1, 1] , "is": {"id": "minecraft:air"}                                             }, 
                { "pos": [0, 1, -1], "is": {"id": "minecraft:air"}                                             }  
            ]
        }
    ], 
    "breakpoints": []
}

