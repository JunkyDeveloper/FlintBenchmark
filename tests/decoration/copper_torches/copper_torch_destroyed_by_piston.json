{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "copper_torch_destroyed_by_piston", 
    "description": "An extending piston destroys a standing copper torch and a copper wall torch in front of it instead of pushing them, and extends fully.", 
    "tags": ["decoration", "copper_torch", "piston", "push-reaction", "redstone"], 
    "minecraftIds": [
        "minecraft:copper_torch"     , "minecraft:copper_wall_torch", "minecraft:piston"           , 
        "minecraft:redstone_block"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [9, 2, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [5, 0, 0], [9, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [8, 1, 4], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [7, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [8, 1, 0], "block": {"id": "minecraft:copper_torch"}                                  }, 
                { "pos": [7, 1, 3], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [8, 1, 3], "block": {"id": "minecraft:copper_wall_torch", "facing": "north"}          }  
            ]
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [8, 1, 0], "is": {"id": "minecraft:copper_torch"                        } }, 
                { "pos": [8, 1, 3], "is": {"id": "minecraft:copper_wall_torch", "facing": "north"} }  
            ]
        }, 
        { "at": 4, "do": "place", "pos": [6, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        { "at": 4, "do": "place", "pos": [6, 1, 3], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [7, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "true"}    }, 
                { "pos": [8, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east", "type": "normal"} }, 
                { "pos": [9, 1, 0], "is": {"id": "minecraft:air"}                                             }, 
                { "pos": [7, 1, 3], "is": {"id": "minecraft:piston", "facing": "east", "extended": "true"}    }, 
                { "pos": [8, 1, 3], "is": {"id": "minecraft:piston_head", "facing": "east", "type": "normal"} }, 
                { "pos": [9, 1, 3], "is": {"id": "minecraft:air"}                                             }  
            ]
        }
    ], 
    "breakpoints": []
}

