{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "copper_torch_forces_wall_post", 
    "description": "A copper torch on top of the middle of a straight cobblestone wall run raises the wall post, while a run with nothing on top has no post.", 
    "tags": ["decoration", "copper_torch", "connectible", "wall", "block-state"], 
    "minecraftIds": ["minecraft:copper_torch", "minecraft:cobblestone_wall"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 1, 0] ], 
            "with": {"id": "minecraft:cobblestone_wall"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 1, 3], [2, 1, 3] ], 
            "with": {"id": "minecraft:cobblestone_wall"}
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": {
                        "id"   : "minecraft:cobblestone_wall", 
                        "up"   : "false"                     , 
                        "east" : "low"                       , 
                        "west" : "low"                       , 
                        "north": "none"                      , 
                        "south": "none"                        
                    }
                }, 
                {
                    "pos": [1, 1, 3], 
                    "is": {
                        "id"   : "minecraft:cobblestone_wall", 
                        "up"   : "false"                     , 
                        "east" : "low"                       , 
                        "west" : "low"                       , 
                        "north": "none"                      , 
                        "south": "none"                        
                    }
                }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 2, 3], "block": {"id": "minecraft:copper_torch"} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:cobblestone_wall", "up": "false"} }, 
                {
                    "pos": [1, 1, 3], 
                    "is": {"id": "minecraft:cobblestone_wall", "up": "true", "east": "low", "west": "low"}
                }, 
                { "pos": [1, 2, 3], "is": {"id": "minecraft:copper_torch"} }
            ]
        }
    ], 
    "breakpoints": []
}

