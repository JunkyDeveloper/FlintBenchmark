{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "copper_wall_torch_support_removed_drops_item", 
    "description": "Removing the block a copper wall torch is attached to removes the torch and drops one copper torch item.", 
    "tags": ["decoration", "copper-torch", "wall-torch", "support", "neighbor-update", "drops"], 
    "minecraftIds": ["minecraft:copper_wall_torch", "minecraft:copper_torch", "minecraft:stone", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [11, 4, 1] ]
        }, 
        "player": {"game_mode": "Spectator"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [11, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [8, 1, 0], "block": {"id": "minecraft:stone"                              } }, 
                { "pos": [9, 1, 0], "block": {"id": "minecraft:copper_wall_torch", "facing": "east"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [9, 1, 0], "is": {"id": "minecraft:copper_wall_torch", "facing": "east"} }
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [8, 1, 0] }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [9, 1, 0], "is": {"id": "minecraft:air"} }                                      , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:copper_torch"}  
            ]
        }
    ], 
    "breakpoints": []
}

