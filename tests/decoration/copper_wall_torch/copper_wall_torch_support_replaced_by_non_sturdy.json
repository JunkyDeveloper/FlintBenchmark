{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "copper_wall_torch_support_replaced_by_non_sturdy", 
    "description": "Replacing the block a copper wall torch is attached to with oak leaves removes the torch, because leaves have no sturdy face.", 
    "tags": ["decoration", "copper-torch", "wall-torch", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:copper_wall_torch", "minecraft:stone", "minecraft:oak_leaves"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [11, 4, 1] ]
        }, 
        "player": {"game_mode": "Spectator"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [11, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [8, 1, 0], "block": {"id": "minecraft:stone"                              } }, 
                { "pos": [9, 1, 0], "block": {"id": "minecraft:copper_wall_torch", "facing": "east"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [9, 1, 0], "is": {"id": "minecraft:copper_wall_torch", "facing": "east"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [8, 1, 0], "block": {"id": "minecraft:oak_leaves", "persistent": true} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [8, 1, 0], "is": {"id": "minecraft:oak_leaves"} }, 
                { "pos": [9, 1, 0], "is": {"id": "minecraft:air"       } }  
            ]
        }
    ], 
    "breakpoints": []
}

