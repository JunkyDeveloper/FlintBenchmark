{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "dead_coral_placement_in_water_source", 
    "description": "A survival player placing dead tube coral into a water source block replaces the water and the coral becomes waterlogged.", 
    "tags": ["decoration", "coral", "placement", "waterlogging", "water", "player", "block-state"], 
    "minecraftIds": ["minecraft:dead_tube_coral", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:dead_tube_coral", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dead_tube_coral", "waterlogged": "true"} }, 
                {"slot": "hotbar1", "is": "empty"}                                                      
            ]
        }
    ], 
    "breakpoints": []
}

