{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "dead_coral_pushed_off_ledge_breaks", 
    "description": "An extending piston pushing a dead tube coral onto a position with no block underneath makes the coral disappear.", 
    "tags": ["decoration", "coral", "piston", "push-reaction", "support", "redstone"], 
    "minecraftIds": ["minecraft:dead_tube_coral", "minecraft:piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:dead_tube_coral", "waterlogged": "false"}       }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:dead_tube_coral"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:air"            } }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "facing": "east", "extended": "true"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"                    } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                                              } }  
            ]
        }
    ], 
    "breakpoints": []
}

