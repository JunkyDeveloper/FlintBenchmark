{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "dead_coral_unaffected_by_side_block_removal", 
    "description": "Removing a block next to a dead tube coral, but not the one under it, leaves the coral in place.", 
    "tags": ["decoration", "coral", "support", "block-update"], 
    "minecraftIds": ["minecraft:dead_tube_coral", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:dead_tube_coral", "waterlogged": "false"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:stone"          } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dead_tube_coral"} }  
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [1, 1, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"                                    } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dead_tube_coral", "waterlogged": "false"} }, 
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"                                  } }  
            ]
        }
    ], 
    "breakpoints": []
}

