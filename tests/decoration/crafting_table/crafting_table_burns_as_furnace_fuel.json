{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "crafting_table_burns_as_furnace_fuel", 
    "description": "A crafting table in a furnace's fuel slot is consumed as fuel with a burn time of 300 ticks (1.5 base units) and lights the furnace while it smelts raw beef.", 
    "tags": ["decoration", "crafting_table", "furnace", "fuel", "block-entity"], 
    "minecraftIds": ["minecraft:crafting_table", "minecraft:furnace", "minecraft:beef"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:furnace", 
                "facing": "north", 
                "lit": false, 
                "nbt": {
                    "Items": "[{Slot: 0b, count: 1, id: \"minecraft:beef\"}, {Slot: 1b, count: 1, id: \"minecraft:crafting_table\"}]"
                }
            }
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": { "id": "minecraft:furnace", "lit": true, "nbt": {"lit_total_time": "300s"} }
                }
            ]
        }
    ], 
    "breakpoints": []
}

