{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "crafting_table_pushed_by_piston", 
    "description": "An extending piston pushes a crafting table one block forward (push reaction NORMAL) instead of destroying it; the table is still a crafting table in its new position.", 
    "tags": ["decoration", "crafting_table", "piston", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:crafting_table", "minecraft:piston"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:crafting_table"}                                }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "true"}    }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east", "type": "normal"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:crafting_table"}                                  }  
            ]
        }
    ], 
    "breakpoints": []
}

