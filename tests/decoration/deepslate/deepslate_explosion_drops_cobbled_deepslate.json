{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "deepslate_explosion_drops_cobbled_deepslate", 
    "description": "A deepslate block destroyed by an explosion becomes air and drops a single cobbled deepslate item rather than deepslate.", 
    "tags": ["decoration", "deepslate", "drops", "explosion", "item"], 
    "minecraftIds": ["minecraft:deepslate", "minecraft:cobbled_deepslate", "minecraft:tnt", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -4], [4, 10, 4] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs"              : false, 
                "minecraft:advance_time"            : false, 
                "minecraft:advance_weather"         : false, 
                "minecraft:tnt_explosion_drop_decay": false  
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 8, 0], "block": {"id": "minecraft:deepslate"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 8, 0], "is": {"id": "minecraft:deepslate"}                  }, 
                {                   "is": "minecraft:item"             , "exists": false }  
            ]
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [0.5, 9, 0.5], 
            "fuse": 1
        }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 8, 0], "is": {"id": "minecraft:air"} }                                            , 
                {"is": "minecraft:item", "count": 1, "Item.id": "minecraft:cobbled_deepslate", "Item.count": 1}  
            ]
        }
    ], 
    "breakpoints": []
}

