{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "end_rod_explosion_drops_itself", 
    "description": "An exploding TNT next to an end rod destroys it and the loot table drops exactly one end rod item.", 
    "tags": ["decoration", "end-rod", "explosion", "drops", "loot-table"], 
    "minecraftIds": ["minecraft:end_rod", "minecraft:tnt", "minecraft:obsidian", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [4, 3, 2] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -2], [4, 0, 2] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:end_rod", "facing": "up"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:end_rod", "facing": "up"}                  }, 
                {                   "is": "minecraft:item"                           , "exists": false }  
            ]
        }, 
        {
            "at": 1, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }                                  , 
                {"is": "minecraft:item", "count": 1, "Item.id": "minecraft:end_rod", "Item.count": 1}  
            ]
        }
    ], 
    "breakpoints": []
}

