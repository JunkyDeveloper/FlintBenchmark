{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "end_rod_pushed_by_piston", 
    "description": "A piston pushes an end rod one block forward (normal push reaction) and the rod keeps its facing, whether it lies across or along the push axis.", 
    "tags": ["decoration", "end-rod", "piston", "push-reaction"], 
    "minecraftIds": ["minecraft:end_rod", "minecraft:piston", "minecraft:redstone_block", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 2, 2] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston" , "facing": "east" , "extended": false} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:end_rod", "facing": "north"                   } }, 
                { "pos": [0, 1, 2], "block": {"id": "minecraft:piston" , "facing": "east" , "extended": false} }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:end_rod", "facing": "east"                    } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:end_rod", "facing": "north"} }, 
                { "pos": [1, 1, 2], "is": {"id": "minecraft:end_rod", "facing": "east" } }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        { "at": 2, "do": "place", "pos": [0, 2, 2], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": true} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"} }             , 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:end_rod", "facing": "north"} }                , 
                { "pos": [1, 1, 2], "is": {"id": "minecraft:piston_head", "facing": "east"} }             , 
                { "pos": [2, 1, 2], "is": {"id": "minecraft:end_rod", "facing": "east"} }                 , 
                {"is": "minecraft:item", "exists": false}                                                   
            ]
        }
    ], 
    "breakpoints": []
}

