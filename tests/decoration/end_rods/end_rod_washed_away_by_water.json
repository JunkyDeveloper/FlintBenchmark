{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "end_rod_washed_away_by_water", 
    "description": "Flowing water replaces an end rod because the rod is registered non-solid (forceSolidOff), dropping it as one end rod item.", 
    "tags": ["decoration", "end-rod", "fluid", "water", "drops"], 
    "minecraftIds": ["minecraft:end_rod", "minecraft:water", "minecraft:stone", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, -1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [-1, 1,  1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 0, 1,  1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 1, 1, -1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 1, 1,  1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 2, 1, -1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 2, 1,  1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 3, 1, -1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 3, 1,  1], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [-1, 1,  0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 3, 1,  0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [ 1, 1,  0], "block": {"id": "minecraft:end_rod", "facing": "up"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:end_rod", "facing": "up"}                  }, 
                {                   "is": "minecraft:item"                           , "exists": false }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
        {
            "at": 15, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water", "level": 1} }                    , 
                {"is": "minecraft:item", "count": 1, "Item.id": "minecraft:end_rod", "Item.count": 1}  
            ]
        }
    ], 
    "breakpoints": []
}

