{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "flower_pot_empty_hand_does_nothing", 
    "description": "Using an empty hand on an empty flower pot does nothing: the pot stays empty and the player's hotbar stays empty.", 
    "tags": ["decoration", "flower-pot", "interaction", "player"], 
    "minecraftIds": ["minecraft:flower_pot"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {"selected_hotbar": 1, "game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:flower_pot"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:flower_pot"}                    }, 
                {                   "is": "empty"                       , "slot": "hotbar1" }, 
                {                   "is": "empty"                       , "slot": "hotbar2" }  
            ]
        }
    ], 
    "breakpoints": []
}

