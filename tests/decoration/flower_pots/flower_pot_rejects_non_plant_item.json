{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "flower_pot_rejects_non_plant_item", 
    "description": "Using stone on an empty flower pot does nothing: the item has no potted variant so the pot's empty-hand interaction runs, which is consumed for an empty pot, so no stone is placed and the stack is unchanged.", 
    "tags": ["decoration", "flower-pot", "interaction", "player"], 
    "minecraftIds": ["minecraft:flower_pot", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:stone", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:flower_pot"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:flower_pot"            }                    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"                   }                    }, 
                {                   "is": {"id": "minecraft:stone"     , "count": 2}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

