{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "potted_open_eyeblossom_closes_in_daytime", 
    "description": "At daytime (outside the eyeblossom open window) with a very high random tick speed, a potted open eyeblossom random-ticks into a potted closed eyeblossom. Note: flintcli does not reset random_tick_speed after the test.", 
    "tags": ["decoration", "flower-pot", "eyeblossom", "random-tick", "time", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:potted_open_eyeblossom", "minecraft:potted_closed_eyeblossom", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:potted_open_eyeblossom"} }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:potted_closed_eyeblossom"} }
            ]
        }
    ], 
    "breakpoints": []
}

