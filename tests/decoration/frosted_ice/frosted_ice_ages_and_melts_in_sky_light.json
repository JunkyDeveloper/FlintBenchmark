{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "frosted_ice_ages_and_melts_in_sky_light", 
    "description": "Frosted ice uses the highest of sky and block light. Time is set to noon (6000). An inverted daylight detector outputs 15 minus the effective sky light; power 0-3 confirms effective sky light of at least 12 (rain darkens the sky by 3), so the frosted ice, open to the sky in a stone pit, sees at least 11 (sky light loses 1 entering it). That is above 11 - age - 1 at every age. A lone block always has fewer than 4 frosted neighbours, so each scheduled tick ages it by 1 and at age 3 it melts into a water source. Every age change runs onPlace again, which schedules the next tick 60-120 ticks later; the 20-40 tick reschedule in tick() is dropped as a duplicate. So the 4 steps take 240-480 ticks: age 0 until at least +60, age 1-2 at +121, not yet water at +239, water by +481.", 
    "tags": ["frosted-ice", "melting", "scheduled-tick", "light", "sky-light", "block-state"], 
    "minecraftIds": ["minecraft:frosted_ice", "minecraft:water", "minecraft:daylight_detector"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }, 
            "weather": "clear"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "assert", 
            "checks": [ {"time": 6000} ]
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [2, 2, 0], "block": {"id": "minecraft:daylight_detector", "inverted": true} }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [2, 2, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 0}, 
                        {"id": "minecraft:daylight_detector", "power": 1}, 
                        {"id": "minecraft:daylight_detector", "power": 2}, 
                        {"id": "minecraft:daylight_detector", "power": 3}  
                    ]
                }
            ]
        }, 
        { "at": 25, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:frosted_ice", "age": 0} }, 
        {
            "at": 26, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }
            ]
        }, 
        {
            "at": 84, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }
            ]
        }, 
        {
            "at": 146, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [ 0                                        , 1                                        , 0 ], 
                    "is" : [ {"id": "minecraft:frosted_ice", "age": 1}, {"id": "minecraft:frosted_ice", "age": 2}    ]  
                }
            ]
        }, 
        {
            "at": 263, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:frosted_ice", "age": 1}, 
                        {"id": "minecraft:frosted_ice", "age": 2}, 
                        {"id": "minecraft:frosted_ice", "age": 3}  
                    ]
                }
            ]
        }, 
        {
            "at": 507, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                {
                    "pos": [2, 2, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 0}, 
                        {"id": "minecraft:daylight_detector", "power": 1}, 
                        {"id": "minecraft:daylight_detector", "power": 2}, 
                        {"id": "minecraft:daylight_detector", "power": 3}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

