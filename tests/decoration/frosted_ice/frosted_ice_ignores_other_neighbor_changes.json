{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "frosted_ice_ignores_other_neighbor_changes", 
    "description": "Everything is sealed in stone, so there is no light and frosted ice never ages or melts on its own. Flint places blocks with /setblock and /fill, which notify neighbours with the new block (ServerLevel.updateNeighboursOnBlockSet), while a melting block notifies its neighbours with the old block, frosted ice. Frosted ice only reacts to a neighbour update that comes from frosted ice. In a 2x2 square filled at once, removing one corner with /setblock air notifies with air, so the two blocks next to it stay even though each now has only 1 frosted neighbour. Placing stone into the gap notifies with stone, and they still stay.", 
    "tags": ["frosted-ice", "neighbor-update", "block-update"], 
    "minecraftIds": ["minecraft:frosted_ice"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [2, 2, 2] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [2, 2, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [1, 1, 1] ], 
            "with": {"id": "minecraft:frosted_ice", "age": 0}
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [1, 1, 1] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"                  } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }, 
        { "at": 10, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 11, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:stone"                } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }
    ], 
    "breakpoints": []
}

