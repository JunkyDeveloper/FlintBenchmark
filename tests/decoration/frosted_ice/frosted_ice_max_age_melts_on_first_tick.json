{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "frosted_ice_max_age_melts_on_first_tick", 
    "description": "Frosted ice placed at age 3 melts into a water source on its first scheduled tick (60-120 ticks after placement; flint ticks can lag the game tick by one, hence the margin), because at age 3 the next step is melting instead of ageing. Time is set to noon (6000); an inverted daylight detector at power 0-3 confirms effective sky light of at least 12, so the ice in an open stone pit sees at least 11, above the age-3 threshold of 11 - 3 - 1 = 7.", 
    "tags": ["frosted-ice", "melting", "scheduled-tick", "light", "sky-light", "block-state"], 
    "minecraftIds": ["minecraft:frosted_ice", "minecraft:water", "minecraft:daylight_detector"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }, 
            "weather": "clear"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "assert", 
            "checks": [ {"time": 6000} ]
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [2, 2, 0], "block": {"id": "minecraft:daylight_detector", "inverted": true} }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [2, 2, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 0}, 
                        {"id": "minecraft:daylight_detector", "power": 1}, 
                        {"id": "minecraft:daylight_detector", "power": 2}, 
                        {"id": "minecraft:daylight_detector", "power": 3}  
                    ]
                }
            ]
        }, 
        { "at": 25, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:frosted_ice", "age": 3} }, 
        {
            "at": 80, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 3} }
            ]
        }, 
        {
            "at": 147, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                {
                    "pos": [2, 2, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 0}, 
                        {"id": "minecraft:daylight_detector", "power": 1}, 
                        {"id": "minecraft:daylight_detector", "power": 2}, 
                        {"id": "minecraft:daylight_detector", "power": 3}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

