{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "frosted_ice_melts_when_frosted_ice_placed_next_to_it", 
    "description": "Everything is sealed in stone, so there is no light and frosted ice never ages or melts on its own. Flint places blocks with /setblock and /fill, which notify neighbours with the new block (ServerLevel.updateNeighboursOnBlockSet), while a melting block notifies its neighbours with the old block, frosted ice. Frosted ice melts straight away when a neighbour update comes from frosted ice and it has fewer than 2 frosted neighbours. A 2x2 square is filled at once (every block has 2 frosted neighbours, so it stays), one corner is removed, and a lone frosted ice block is placed next to the gap. Placing frosted ice back into the gap notifies the lone block, which has 1 frosted neighbour and melts into a water source. The refilled corner and the rest of the square have 2 frosted neighbours each, so they stay.", 
    "tags": ["frosted-ice", "melting", "neighbor-update"], 
    "minecraftIds": ["minecraft:frosted_ice", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 2] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [1, 1, 0], [2, 1, 1] ], 
            "with": {"id": "minecraft:frosted_ice", "age": 0}
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [2, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [1, 1, 0] }, 
        { "at": 5, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:frosted_ice", "age": 0} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"                  } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [2, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }, 
        { "at": 8, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:frosted_ice", "age": 0} }, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"      , "level": 0          } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice",             "age": 0} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:frosted_ice",             "age": 0} }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:frosted_ice",             "age": 0} }, 
                { "pos": [2, 1, 1], "is": {"id": "minecraft:frosted_ice",             "age": 0} }  
            ]
        }
    ], 
    "breakpoints": []
}

