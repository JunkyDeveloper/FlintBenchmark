{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "frosted_ice_stable_at_midnight", 
    "description": "At midnight (18000) the sky darkens by 11, so frosted ice open to the sky sees too little light to age or melt. An inverted daylight detector at power 11-15 confirms effective sky light of 4 or less, so the ice in an open stone pit sees 3 or less, below 11 - 0 - 1 = 10 at age 0. It stays at age 0 for 240 ticks.", 
    "tags": ["frosted-ice", "scheduled-tick", "light", "sky-light", "night", "block-state"], 
    "minecraftIds": ["minecraft:frosted_ice", "minecraft:daylight_detector"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "time": "18000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }, 
            "weather": "clear"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "assert", 
            "checks": [ {"time": 18000} ]
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [2, 2, 0], "block": {"id": "minecraft:daylight_detector", "inverted": true} }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [2, 2, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 11}, 
                        {"id": "minecraft:daylight_detector", "power": 12}, 
                        {"id": "minecraft:daylight_detector", "power": 13}, 
                        {"id": "minecraft:daylight_detector", "power": 14}, 
                        {"id": "minecraft:daylight_detector", "power": 15}  
                    ]
                }
            ]
        }, 
        { "at": 25, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:frosted_ice", "age": 0} }, 
        {
            "at": 145, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }
            ]
        }, 
        {
            "at": 265, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                {
                    "pos": [2, 2, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 11}, 
                        {"id": "minecraft:daylight_detector", "power": 12}, 
                        {"id": "minecraft:daylight_detector", "power": 13}, 
                        {"id": "minecraft:daylight_detector", "power": 14}, 
                        {"id": "minecraft:daylight_detector", "power": 15}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

