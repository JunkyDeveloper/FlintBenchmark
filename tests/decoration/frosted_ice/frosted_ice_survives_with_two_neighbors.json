{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "frosted_ice_survives_with_two_neighbors", 
    "description": "Everything is sealed in stone, so there is no light and frosted ice never ages or melts on its own. Flint places blocks with /setblock and /fill, which notify neighbours with the new block (ServerLevel.updateNeighboursOnBlockSet), while a melting block notifies its neighbours with the old block, frosted ice. Frosted ice only melts from a frosted-ice neighbour update if it has fewer than 2 frosted neighbours. A 2x2 square filled at once gives every block exactly 2 frosted neighbours, so the whole square stays at age 0. A pair filled at once in a separate stone pocket gives each block only 1, so both melt into water sources.", 
    "tags": ["frosted-ice", "melting", "neighbor-update", "threshold"], 
    "minecraftIds": ["minecraft:frosted_ice", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 2, 2] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [6, 2, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [1, 1, 1] ], 
            "with": {"id": "minecraft:frosted_ice", "age": 0}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [4, 1, 0], [5, 1, 0] ], 
            "with": {"id": "minecraft:frosted_ice", "age": 0}
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0            } }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0            } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0            } }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0            } }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:water"      ,           "level": 0} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:water"      ,           "level": 0} }  
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:frosted_ice", "age": 0} }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:frosted_ice", "age": 0} }  
            ]
        }
    ], 
    "breakpoints": []
}

