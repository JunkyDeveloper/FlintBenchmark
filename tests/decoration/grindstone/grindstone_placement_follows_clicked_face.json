{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grindstone_placement_follows_clicked_face", 
    "description": "The clicked face takes priority over the look direction: clicking the top of a block at a shallow pitch still gives a face=floor grindstone facing the player's horizontal direction, and clicking the side of a block at a steep pitch still gives a face=wall grindstone facing away from that side.", 
    "tags": ["grindstone", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:grindstone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 3, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:grindstone", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2.5, -2.5], "rot": [0, 36] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [3.05, 2.5, 0.5], "rot": [-90, 70] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:grindstone", "face": "floor", "facing": "south"} }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:grindstone", "face": "wall", "facing": "west"} }  , 
                {"slot": "hotbar1", "is": "empty"}                                                              
            ]
        }
    ], 
    "breakpoints": []
}

