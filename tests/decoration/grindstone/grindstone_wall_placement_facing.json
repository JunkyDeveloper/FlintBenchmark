{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grindstone_wall_placement_facing", 
    "description": "A survival player looking level at the side of a block places a face=wall grindstone against that side, facing away from the block toward the player.", 
    "tags": ["grindstone", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:grindstone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 2, 7] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:grindstone", "count": 4} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 1, 6], "block": {"id": "minecraft:stone"} }, 
                { "pos": [4, 1, 6], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, -3.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 0, 3.5], "rot": [180, 0] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [-3.5, 0, 6.5], "rot": [-90, 0] }, 
        {"at": 3, "do": "interact"}, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [7.5, 0, 6.5], "rot": [90, 0] }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, -1], "is": {"id": "minecraft:grindstone", "face": "wall", "facing": "north"} }, 
                { "pos": [4, 1, 1], "is": {"id": "minecraft:grindstone", "face": "wall", "facing": "south"} } , 
                { "pos": [-1, 1, 6], "is": {"id": "minecraft:grindstone", "face": "wall", "facing": "west"} } , 
                { "pos": [5, 1, 6], "is": {"id": "minecraft:grindstone", "face": "wall", "facing": "east"} }  , 
                {"slot": "hotbar1", "is": "empty"}                                                              
            ]
        }
    ], 
    "breakpoints": []
}

