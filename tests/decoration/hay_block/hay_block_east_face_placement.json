{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "hay_block_east_face_placement", 
    "description": "A survival player placing hay against the east face of a block gets axis x and uses up the item.", 
    "tags": ["decoration", "hay-block", "pillar", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:hay_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [2, 4, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:hay_block", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [3.5, 0, 0.5], "rot": [90, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:hay_block", "axis": "x"}                    }, 
                {                   "is": "empty"                                   , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

