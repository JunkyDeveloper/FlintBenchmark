{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "hay_block_explosion_drops_itself", 
    "description": "A hay block destroyed by a TNT explosion drops exactly one hay block item (loot table dropSelf).", 
    "tags": ["decoration", "hay-block", "drops", "explosion", "tnt", "entity"], 
    "minecraftIds": ["minecraft:hay_block", "minecraft:obsidian", "minecraft:tnt", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [12, 3, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [8, 0, 0], [12, 0, 4] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 1, "do": "place", "pos": [10, 1, 1], "block": {"id": "minecraft:hay_block", "axis": "y"} }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [10.5, 1, 2.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [10, 1, 1], "is": {"id": "minecraft:air"} }, 
                {
                    "is": "minecraft:item", 
                    "exists": true, 
                    "count": 1, 
                    "Item.id": "minecraft:hay_block", 
                    "Item.count": "1"
                }
            ]
        }
    ], 
    "breakpoints": []
}

