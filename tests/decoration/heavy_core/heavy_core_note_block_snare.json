{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "heavy_core_note_block_snare", 
    "description": "A note block sitting on a heavy core switches its instrument to snare, and back to harp when the heavy core is removed.", 
    "tags": ["decoration", "heavy_core", "note_block", "instrument"], 
    "minecraftIds": ["minecraft:heavy_core", "minecraft:note_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:note_block"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:note_block", "instrument": "harp"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:heavy_core"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:note_block", "instrument": "snare"} }
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 1, 0] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:note_block", "instrument": "harp"} }
            ]
        }
    ], 
    "breakpoints": []
}

