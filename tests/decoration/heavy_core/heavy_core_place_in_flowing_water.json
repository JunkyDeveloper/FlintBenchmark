{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "heavy_core_place_in_flowing_water", 
    "description": "Placing a heavy core into flowing (non-source) water does not waterlog it, because placement only checks for a water source.", 
    "tags": ["decoration", "heavy_core", "placement", "waterlogged", "player"], 
    "minecraftIds": ["minecraft:heavy_core", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:heavy_core", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [1, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:water"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 8} }  
            ]
        }, 
        { "at": 11, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 11, "do": "interact"}, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:heavy_core", "waterlogged": false}                    }, 
                {                   "is": {"id": "minecraft:air", "count": 0}                 , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

