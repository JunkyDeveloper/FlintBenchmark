{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "heavy_core_survives_tnt_explosion", 
    "description": "A heavy core next to exploding TNT survives because of its explosion resistance, while a dirt block on the other side of the TNT is destroyed.", 
    "tags": ["decoration", "heavy_core", "explosion", "resistance"], 
    "minecraftIds": ["minecraft:heavy_core", "minecraft:dirt", "minecraft:obsidian", "minecraft:tnt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:heavy_core"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:dirt"      } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [1.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"       } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:heavy_core"} }  
            ]
        }
    ], 
    "breakpoints": []
}

