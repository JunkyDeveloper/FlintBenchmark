{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "honey_block_drags_adjacent_block_sideways", 
    "description": "A block beside a honey block is dragged along when a piston pushes the honey block, because honey is sticky.", 
    "tags": ["decoration", "honey-block", "piston", "sticky", "push-reaction"], 
    "minecraftIds": ["minecraft:honey_block", "minecraft:stone", "minecraft:piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 1, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:piston"     , "facing": "east"} }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:honey_block"                  } }, 
                { "pos": [1, 0, 1], "block": {"id": "minecraft:stone"                        } }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 0, 0], "is": {"id": "minecraft:piston_head"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:honey_block"} }, 
                { "pos": [1, 0, 1], "is": {"id": "minecraft:air"        } }, 
                { "pos": [2, 0, 1], "is": {"id": "minecraft:stone"      } }  
            ]
        }
    ], 
    "breakpoints": []
}

