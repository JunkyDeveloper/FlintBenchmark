{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "place_honey_block", 
    "description": "A survival player placing a honey block item on stone creates a honey block above it and consumes the item.", 
    "tags": ["decoration", "honey-block", "placement"], 
    "minecraftIds": ["minecraft:honey_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:honey_block", "count": 1}, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:honey_block"}                    }, 
                {                   "is": "empty"                        , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

