{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "tnt_explosion_drops_honey_block", 
    "description": "A honey block destroyed by a TNT explosion drops exactly one honey block item (its loot table is drop-self).", 
    "tags": ["decoration", "honey-block", "drops", "explosion"], 
    "minecraftIds": ["minecraft:honey_block", "minecraft:obsidian", "minecraft:tnt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [4, 3, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [4, 0, 2] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:honey_block"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 1.5] }, 
        {
            "at": 1, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 1.5], 
            "fuse": "1s"
        }, 
        {
            "at": 35, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"} }                                     , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:honey_block"}  
            ]
        }
    ], 
    "breakpoints": []
}

