{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Crimson Hyphae Axe Strip Keeps Axis X", 
    "description": "An axe used on crimson hyphae with axis x turns it into stripped crimson hyphae and keeps axis x.", 
    "tags": ["hyphae", "axe", "strip", "player"], 
    "minecraftIds": [
        "minecraft:crimson_hyphae"         , "minecraft:stripped_crimson_hyphae", "minecraft:iron_axe"               , 
        "minecraft:stone"                  
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_axe"} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                      } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:crimson_hyphae", "axis": "x"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stripped_crimson_hyphae", "axis": "x"} }, 
                { "is": {"id": "minecraft:iron_axe"}, "slot": "hotbar1" }                             
            ]
        }
    ], 
    "breakpoints": []
}

