{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Crimson Hyphae Placement West Face Axis X", 
    "description": "Using crimson hyphae on the west face of stone places it with axis x (the axis of the clicked face).", 
    "tags": ["hyphae", "placement", "axis", "player"], 
    "minecraftIds": ["minecraft:crimson_hyphae", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-3, 0, -3], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:crimson_hyphae", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-3, 0, -3], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [-2.5, 1, 0.5], "rot": [-90, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0] , "is": {"id": "minecraft:stone"}                                          }, 
                { "pos": [-1, 2, 0], "is": {"id": "minecraft:crimson_hyphae", "axis": "x"}                    }, 
                {                    "is": {"id": "minecraft:crimson_hyphae", "count": 1} , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

