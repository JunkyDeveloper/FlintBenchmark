{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ice_block_light_threshold", 
    "description": "Ice melts on a random tick only when block light at its position is greater than 11 - light dampening 1 = 10. Each ice block sits in a stone pit with a light block directly above; light entering ice loses 1 level. A level 11 light block gives block light 10 at the ice and it stays ice; a level 12 light block gives 11 and it melts into a water source. The pits are 4 blocks apart so each light block only affects its own ice. Random tick speed 4096 gives about one random tick per block per game tick.", 
    "tags": ["ice", "melting", "random-tick", "light", "threshold", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:ice", "minecraft:water", "minecraft:light"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 2, 1] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:ice"                                     } }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:ice"                                     } }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:light", "level": 11, "waterlogged": false} }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:light", "level": 12, "waterlogged": false} }  
            ]
        }, 
        {
            "at": 121, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:ice"              } }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:water", "level": 0} }  
            ]
        }
    ], 
    "breakpoints": []
}

