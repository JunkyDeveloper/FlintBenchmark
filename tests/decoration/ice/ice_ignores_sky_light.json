{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ice_ignores_sky_light", 
    "description": "Ice melting only looks at block light (threshold above 11 - light dampening 1 = 10), never sky light. At noon (time 6000) ice under open sky with block light 0 stays ice for 200 ticks at random tick speed 4096. An inverted daylight detector at the same height outputs 15 minus the effective sky light; power 0-3 confirms effective sky light 12-15 there (rain darkens the sky by 3), so the ice block itself sees sky light of at least 11, which would be enough to melt it if sky light counted.", 
    "tags": ["ice", "melting", "random-tick", "light", "sky-light", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:ice", "minecraft:daylight_detector"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 1, 1] ]
        }, 
        "world": {
            "time": "6000", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "assert", 
            "checks": [ {"time": 6000} ]
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:ice"                                } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:daylight_detector", "inverted": true} }  
            ]
        }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [2, 1, 0], 
                    "is": [
                        {"id": "minecraft:daylight_detector", "power": 0}, 
                        {"id": "minecraft:daylight_detector", "power": 1}, 
                        {"id": "minecraft:daylight_detector", "power": 2}, 
                        {"id": "minecraft:daylight_detector", "power": 3}  
                    ]
                }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:ice"} }
            ]
        }, 
        {
            "at": 201, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:ice"} }
            ]
        }
    ], 
    "breakpoints": []
}

