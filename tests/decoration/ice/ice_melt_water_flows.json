{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ice_melt_water_flows", 
    "description": "When ice melts it becomes a water source and notifies itself of the change, so the new water starts flowing straight away. Ice with glowstone above (block light 14) at the closed end of a walled channel 3 blocks long melts. The source stays at level 0 and spreads into the channel as flowing water, level 1 then level 2.", 
    "tags": ["ice", "melting", "random-tick", "water", "flow", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:ice", "minecraft:water", "minecraft:glowstone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [1, 1, 0], [2, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:ice"} }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:glowstone"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }  
            ]
        }, 
        {
            "at": 81, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water", "level": 1} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:water", "level": 2} }  
            ]
        }
    ], 
    "breakpoints": []
}

