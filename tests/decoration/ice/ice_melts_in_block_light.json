{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "ice_melts_in_block_light", 
    "description": "Ice with glowstone directly above (block light 14 at the ice, above the threshold of 11 - light dampening 1 = 10) melts into a water source on a random tick. The ice sits in a stone pit so the water stays put. With random tick speed 4096 each block gets about one random tick per game tick, so not melting within 60 ticks is practically impossible.", 
    "tags": ["ice", "melting", "random-tick", "light", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:ice", "minecraft:water", "minecraft:glowstone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 2, 1] ]
        }, 
        "world": {
            "time": "6000", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:ice"} }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:glowstone"} }, 
        {
            "at": 61, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"    , "level": 0} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:glowstone"            } }  
            ]
        }
    ], 
    "breakpoints": []
}

