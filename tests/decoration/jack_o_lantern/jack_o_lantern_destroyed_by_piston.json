{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_destroyed_by_piston", 
    "description": "An extending piston destroys a jack o'lantern in front of it instead of pushing it (push reaction DESTROY) and the jack o'lantern drops itself as an item.", 
    "tags": ["decoration", "jack-o-lantern", "piston", "push-reaction", "drops"], 
    "minecraftIds": ["minecraft:jack_o_lantern", "minecraft:piston", "minecraft:redstone_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -2], [6, 3, 3] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:stone"}                                       }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": false} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:jack_o_lantern", "facing": "north"}           }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:jack_o_lantern", "facing": "north"}                  }, 
                {                   "is": "minecraft:item"                                     , "exists": false }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "extended": true, "facing": "east"} } , 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"} }              , 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }                                        , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:jack_o_lantern"}  
            ]
        }
    ]
}

