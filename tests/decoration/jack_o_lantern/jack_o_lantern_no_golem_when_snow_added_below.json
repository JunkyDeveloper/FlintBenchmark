{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_no_golem_when_snow_added_below", 
    "description": "Building a snow golem pattern under an already placed jack o'lantern does nothing: CarvedPumpkinBlock only checks for golems in onPlace, so the jack o'lantern and the snow blocks stay and no snow golem spawns.", 
    "tags": ["decoration", "jack-o-lantern", "golem", "snow-golem", "placement-order"], 
    "minecraftIds": ["minecraft:jack_o_lantern", "minecraft:snow_block", "minecraft:snow_golem", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, -1, 0], [1, 3, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, -1, 3], "block": {"id": "minecraft:stone"         } }, 
                { "pos": [0,  2, 3], "block": {"id": "minecraft:jack_o_lantern"} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 3], "block": {"id": "minecraft:snow_block"} }, 
        { "at": 2, "do": "place", "pos": [0, 0, 3], "block": {"id": "minecraft:snow_block"} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 3], "is": {"id": "minecraft:jack_o_lantern"} }                                     , 
                { "pos": [0, 1, 3], "is": {"id": "minecraft:snow_block"} }                                         , 
                { "pos": [0, 0, 3], "is": {"id": "minecraft:snow_block"} }                                         , 
                { "is": "minecraft:snow_golem", "exists": false, "pos": [0.5, 0.05, 3.5], "position_tolerance": 5 }  
            ]
        }
    ]
}

