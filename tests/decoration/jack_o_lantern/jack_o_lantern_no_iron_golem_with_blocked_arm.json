{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_no_iron_golem_with_blocked_arm", 
    "description": "A jack o'lantern placed on a T of iron blocks does nothing when one of the air spaces beside the lower iron block is filled: the pattern requires air there, so the blocks stay and no iron golem spawns.", 
    "tags": ["decoration", "jack-o-lantern", "golem", "iron-golem", "player"], 
    "minecraftIds": ["minecraft:jack_o_lantern", "minecraft:iron_block", "minecraft:iron_golem", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, 0], [1, 3, 6] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:jack_o_lantern", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, -1, 3], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [ 0,  0, 5], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [ 0,  2, 2], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [-1,  0, 3], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [ 0,  0, 3], "block": {"id": "minecraft:iron_block"} }, 
                { "pos": [-1,  1, 3], "block": {"id": "minecraft:iron_block"} }, 
                { "pos": [ 0,  1, 3], "block": {"id": "minecraft:iron_block"} }, 
                { "pos": [ 1,  1, 3], "block": {"id": "minecraft:iron_block"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 5.5], "rot": [180, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 3], "is": {"id": "minecraft:jack_o_lantern", "facing": "south"} }                  , 
                { "pos": [0, 0, 3], "is": {"id": "minecraft:iron_block"} }                                         , 
                { "pos": [-1, 1, 3], "is": {"id": "minecraft:iron_block"} }                                        , 
                { "pos": [0, 1, 3], "is": {"id": "minecraft:iron_block"} }                                         , 
                { "pos": [1, 1, 3], "is": {"id": "minecraft:iron_block"} }                                         , 
                { "pos": [-1, 0, 3], "is": {"id": "minecraft:stone"} }                                             , 
                {"slot": "hotbar1", "is": "empty"}                                                                 , 
                { "is": "minecraft:iron_golem", "exists": false, "pos": [0.5, 0.05, 3.5], "position_tolerance": 5 }  
            ]
        }
    ]
}

