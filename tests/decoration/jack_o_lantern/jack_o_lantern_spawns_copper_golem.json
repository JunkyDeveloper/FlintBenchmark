{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_spawns_copper_golem", 
    "description": "Placing a jack o'lantern on a copper block removes the jack o'lantern, replaces the copper block with a copper chest facing the way the jack o'lantern faced, and spawns a copper golem.", 
    "tags": ["decoration", "jack-o-lantern", "golem", "copper-golem", "player"], 
    "minecraftIds": [
        "minecraft:jack_o_lantern", "minecraft:copper_block"  , "minecraft:copper_chest"  , "minecraft:copper_golem"  , 
        "minecraft:stone"         
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, -1, 0], [1, 3, 6] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:jack_o_lantern", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 3], "block": {"id": "minecraft:stone"       } }, 
                { "pos": [0, 0, 5], "block": {"id": "minecraft:stone"       } }, 
                { "pos": [0, 2, 2], "block": {"id": "minecraft:stone"       } }, 
                { "pos": [0, 1, 3], "block": {"id": "minecraft:copper_block"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 5.5], "rot": [180, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "is": "minecraft:copper_golem", "exists": false, "pos": [0.5, 2.05, 3.5], "position_tolerance": 3 }
            ]
        }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 1, 3], "is": {"id": "minecraft:copper_chest", "facing": "south", "type": "single"} }, 
                {"slot": "hotbar1", "is": "empty"}, 
                {
                    "is": "minecraft:copper_golem", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [0.5, 2.05, 3.5], 
                    "position_tolerance": 3
                }
            ]
        }
    ]
}

