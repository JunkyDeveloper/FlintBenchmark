{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_spawns_iron_golem", 
    "description": "Placing a jack o'lantern on the middle top of a T of four iron blocks with air around it removes the whole pattern and spawns an iron golem.", 
    "tags": ["decoration", "jack-o-lantern", "golem", "iron-golem", "player"], 
    "minecraftIds": ["minecraft:jack_o_lantern", "minecraft:iron_block", "minecraft:iron_golem", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, 0], [1, 3, 6] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:jack_o_lantern", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, -1, 3], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [ 0,  0, 5], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [ 0,  2, 2], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [ 0,  0, 3], "block": {"id": "minecraft:iron_block"} }, 
                { "pos": [-1,  1, 3], "block": {"id": "minecraft:iron_block"} }, 
                { "pos": [ 0,  1, 3], "block": {"id": "minecraft:iron_block"} }, 
                { "pos": [ 1,  1, 3], "block": {"id": "minecraft:iron_block"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 5.5], "rot": [180, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "is": "minecraft:iron_golem", "exists": false, "pos": [0.5, 0.05, 3.5], "position_tolerance": 3 }
            ]
        }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [-1, 1, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 1, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [1, 1, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 2, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 2, 2], "is": {"id": "minecraft:stone"} }, 
                {"slot": "hotbar1", "is": "empty"}, 
                {
                    "is": "minecraft:iron_golem", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [0.5, 0.05, 3.5], 
                    "position_tolerance": 3
                }
            ]
        }
    ]
}

