{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_spawns_snow_golem", 
    "description": "Placing a jack o'lantern on top of two stacked snow blocks removes all three blocks and spawns a snow golem (the golem may leave a snow layer on the spot of the bottom block).", 
    "tags": ["decoration", "jack-o-lantern", "golem", "snow-golem", "player"], 
    "minecraftIds": ["minecraft:jack_o_lantern", "minecraft:snow_block", "minecraft:snow_golem", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, -1, 0], [1, 3, 6] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:jack_o_lantern", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, -1, 3], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [0,  0, 5], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [0,  0, 3], "block": {"id": "minecraft:snow_block"} }, 
                { "pos": [0,  1, 3], "block": {"id": "minecraft:snow_block"} }, 
                { "pos": [0,  2, 2], "block": {"id": "minecraft:stone"     } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 5.5], "rot": [180, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 3], "is": {"id": "minecraft:snow_block"} }                                         , 
                { "pos": [0, 1, 3], "is": {"id": "minecraft:snow_block"} }                                         , 
                { "is": "minecraft:snow_golem", "exists": false, "pos": [0.5, 0.05, 3.5], "position_tolerance": 2 }  
            ]
        }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [ 0                      , 0                                    , 3 ], 
                    "is" : [ {"id": "minecraft:air"}, {"id": "minecraft:snow", "layers": 1}    ]  
                }, 
                { "pos": [0, 1, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 2, 3], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 2, 2], "is": {"id": "minecraft:stone"} }, 
                {"slot": "hotbar1", "is": "empty"}, 
                {
                    "is": "minecraft:snow_golem", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [0.5, 0.05, 3.5], 
                    "position_tolerance": 2
                }
            ]
        }
    ]
}

