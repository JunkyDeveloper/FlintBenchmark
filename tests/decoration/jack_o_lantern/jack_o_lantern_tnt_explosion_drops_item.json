{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jack_o_lantern_tnt_explosion_drops_item", 
    "description": "A jack o'lantern destroyed by a TNT explosion drops exactly one jack o'lantern item (its loot table is dropSelf).", 
    "tags": ["decoration", "jack-o-lantern", "drops", "explosion", "tnt"], 
    "minecraftIds": ["minecraft:jack_o_lantern", "minecraft:tnt", "minecraft:obsidian"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 3, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [3, 0, 2] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:jack_o_lantern", "facing": "north"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:jack_o_lantern"}                  }, 
                {                   "is": "minecraft:item"                  , "exists": false }  
            ]
        }, 
        {
            "at": 3, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 1.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"} }, 
                {
                    "is": "minecraft:item", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [1.5, 1.5, 1.5], 
                    "position_tolerance": 4, 
                    "Item.id": "minecraft:jack_o_lantern"
                }
            ]
        }
    ]
}

