{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_copper_lantern_aging_blocked_by_younger_copper", 
    "description": "ChangeOverTimeBlock.getNextState scans weathering neighbors up to Manhattan distance 4 and refuses to age if any is younger. At random_tick_speed 4096 an exposed copper lantern whose nearest unaffected copper blocks are 3-4 blocks away stays exposed for 200 ticks, while an identical lantern exactly 5 blocks from the copper oxidizes. The copper blocks form a 3x3x3 cluster so they barely age themselves.", 
    "tags": ["decoration", "lantern", "copper", "oxidation", "random-tick", "edge-case"], 
    "minecraftIds": [
        "minecraft:exposed_copper_lantern"  , 
        "minecraft:weathered_copper_lantern", 
        "minecraft:oxidized_copper_lantern" , 
        "minecraft:copper_block"              
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-5, 0, -1], [5, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, -1], [2, 2, 1] ], 
            "with": {"id": "minecraft:copper_block"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [5, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [5, 1, 0], 
                    "block": {"id": "minecraft:exposed_copper_lantern", "hanging": false, "waterlogged": false}
                }, 
                { "pos": [-5, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [-5, 1, 0], 
                    "block": {"id": "minecraft:exposed_copper_lantern", "hanging": false, "waterlogged": false}
                }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [5, 1, 0], 
                    "is": {"id": "minecraft:exposed_copper_lantern", "hanging": false, "waterlogged": false}
                }, 
                {
                    "pos": [-5, 1, 0], 
                    "is": [
                        {"id": "minecraft:weathered_copper_lantern", "hanging": false, "waterlogged": false}, 
                        {"id": "minecraft:oxidized_copper_lantern" , "hanging": false, "waterlogged": false}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

