{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_copper_lantern_honeycomb_waxes", 
    "description": "Using honeycomb on an exposed copper lantern waxes it (HoneycombItem.WAXABLES) into a waxed exposed copper lantern with the same properties, and the survival player's honeycomb is consumed.", 
    "tags": ["decoration", "lantern", "copper", "waxed", "honeycomb", "block-state", "player"], 
    "minecraftIds": [
        "minecraft:exposed_copper_lantern"      , 
        "minecraft:waxed_exposed_copper_lantern", 
        "minecraft:honeycomb"                     
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:honeycomb", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {"id": "minecraft:exposed_copper_lantern", "hanging": false, "waterlogged": false}
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:waxed_exposed_copper_lantern", "hanging": false, "waterlogged": false}
                }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"} }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

