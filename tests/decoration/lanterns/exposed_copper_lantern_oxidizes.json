{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_copper_lantern_oxidizes", 
    "description": "With random_tick_speed 4096 and no other copper nearby, a hanging exposed copper lantern ages (WeatheringLanternBlock.randomTick -> changeOverTime) to the next oxidation stage, keeping hanging=true and waterlogged=false.", 
    "tags": ["decoration", "lantern", "copper", "oxidation", "random-tick", "block-state"], 
    "minecraftIds": [
        "minecraft:exposed_copper_lantern"  , 
        "minecraft:weathered_copper_lantern", 
        "minecraft:oxidized_copper_lantern"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 0, 0], 
                    "block": {"id": "minecraft:exposed_copper_lantern", "hanging": true, "waterlogged": false}
                }
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {"id": "minecraft:exposed_copper_lantern", "hanging": true, "waterlogged": false}
                }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": [
                        {"id": "minecraft:weathered_copper_lantern", "hanging": true, "waterlogged": false}, 
                        {"id": "minecraft:oxidized_copper_lantern" , "hanging": true, "waterlogged": false}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

