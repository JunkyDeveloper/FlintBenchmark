{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "lantern_blocks_flowing_water", 
    "description": "Flowing water reaching a lantern neither destroys nor waterlogs it: SimpleWaterloggedBlock only accepts water sources, so the flow stops at the lantern and the space behind it stays dry.", 
    "tags": ["decoration", "lantern", "water", "fluid", "waterlogging", "edge-case"], 
    "minecraftIds": ["minecraft:lantern", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 1, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [1, 1, 0], 
            "block": {"id": "minecraft:lantern", "hanging": false, "waterlogged": false}
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water"} }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 0}                               }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:lantern", "hanging": false, "waterlogged": false} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"}                                             }  
            ]
        }
    ], 
    "breakpoints": []
}

