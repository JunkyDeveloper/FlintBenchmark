{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "lantern_center_support_on_fence_and_chain", 
    "description": "Lanterns only need center support (Block.canSupportCenter): a survival player can place one standing on a fence post and one hanging under a vertical chain.", 
    "tags": ["decoration", "lantern", "placement", "support", "block-state", "player"], 
    "minecraftIds": ["minecraft:lantern", "minecraft:oak_fence", "minecraft:iron_chain"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, -1, 0], [4, 3, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:lantern", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0,  0, 0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [0,  1, 0], "block": {"id": "minecraft:oak_fence"              } }, 
                { "pos": [4, -1, 0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [4,  3, 0], "block": {"id": "minecraft:iron_chain", "axis": "y"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:lantern", "hanging": false, "waterlogged": false} }, 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:lantern", "hanging": true, "waterlogged": false} } , 
                {"slot": "hotbar1", "is": "empty"}                                                               
            ]
        }
    ], 
    "breakpoints": []
}

