{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "lantern_standing_survival_placement", 
    "description": "A survival player clicking the top of a stone block places a standing lantern (hanging=false, waterlogged=false) and consumes the item (LanternBlock.getStateForPlacement tries DOWN first).", 
    "tags": ["decoration", "lantern", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:lantern"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:lantern", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:lantern", "hanging": false, "waterlogged": false} }, 
                {"slot": "hotbar1", "is": "empty"}                                                               
            ]
        }
    ], 
    "breakpoints": []
}

