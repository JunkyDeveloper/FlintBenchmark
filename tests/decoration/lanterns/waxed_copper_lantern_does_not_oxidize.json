{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "waxed_copper_lantern_does_not_oxidize", 
    "description": "Waxed copper lanterns are plain LanternBlocks with no random tick, so at random_tick_speed 4096 a waxed copper lantern stays unchanged for 200 ticks while an unwaxed exposed copper lantern next to it oxidizes.", 
    "tags": ["decoration", "lantern", "copper", "waxed", "oxidation", "random-tick"], 
    "minecraftIds": [
        "minecraft:waxed_copper_lantern"    , 
        "minecraft:exposed_copper_lantern"  , 
        "minecraft:weathered_copper_lantern", 
        "minecraft:oxidized_copper_lantern"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [8, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [8, 0, 0] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [0, 1, 0], 
                    "block": {"id": "minecraft:waxed_copper_lantern", "hanging": false, "waterlogged": false}
                }, 
                {
                    "pos": [8, 1, 0], 
                    "block": {"id": "minecraft:exposed_copper_lantern", "hanging": false, "waterlogged": false}
                }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:waxed_copper_lantern", "hanging": false, "waterlogged": false}
                }, 
                {
                    "pos": [8, 1, 0], 
                    "is": [
                        {"id": "minecraft:weathered_copper_lantern", "hanging": false, "waterlogged": false}, 
                        {"id": "minecraft:oxidized_copper_lantern" , "hanging": false, "waterlogged": false}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

