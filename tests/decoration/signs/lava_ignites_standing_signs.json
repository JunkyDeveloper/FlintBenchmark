{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "lava_ignites_standing_signs", 
    "description": "One lava pool borders the supports of an oak sign and a crimson sign; lava sets fire on the floor cell beside the oak sign, which is ignited by lava, and never beside the crimson sign, which is not.", 
    "tags": ["decoration", "sign", "lava", "fire", "ignite", "random-tick"], 
    "minecraftIds": ["minecraft:oak_sign", "minecraft:crimson_sign", "minecraft:lava"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -2], [4, 4, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-4, 0, -2], [4, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-3, 1, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-3, 1, -1], [3, 1, 1] ], 
            "with": {"id": "minecraft:lava"}
        }, 
        { "at": 0, "do": "place", "pos": [-2, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [-3, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [3, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "place", "pos": [-3, 2, 0], "block": {"id": "minecraft:oak_sign", "rotation": 8} }, 
        { "at": 1, "do": "place", "pos": [3, 2, 0], "block": {"id": "minecraft:crimson_sign", "rotation": 8} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [-3, 2, 0], "is": {"id": "minecraft:oak_sign"    } }, 
                { "pos": [ 3, 2, 0], "is": {"id": "minecraft:crimson_sign"} }, 
                { "pos": [ 2, 2, 0], "is": {"id": "minecraft:air"         } }  
            ]
        }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                { "pos": [-3, 2, 0], "is": {"id": "minecraft:oak_sign"    } }, 
                { "pos": [ 3, 2, 0], "is": {"id": "minecraft:crimson_sign"} }, 
                { "pos": [ 2, 2, 0], "is": {"id": "minecraft:air"         } }  
            ]
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [-3, 2, 0], "is": {"id": "minecraft:oak_sign"    } }, 
                { "pos": [ 3, 2, 0], "is": {"id": "minecraft:crimson_sign"} }, 
                { "pos": [ 2, 2, 0], "is": {"id": "minecraft:air"         } }  
            ]
        }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                { "pos": [-2, 2, 0], "is": {"id": "minecraft:fire"} }
            ]
        }
    ], 
    "breakpoints": []
}

