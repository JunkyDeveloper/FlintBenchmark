{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "oak_sign_stacking", 
    "description": "A standing sign survives on top of another sign because sign blocks count as solid, and it breaks once the sign below it is gone.", 
    "tags": ["decoration", "sign", "support", "neighbor-update", "block-state"], 
    "minecraftIds": ["minecraft:oak_sign"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 3, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_sign", "rotation": 8} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:oak_sign", "rotation": 8} }, 
                { "pos": [3, 0, 0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [3, 1, 0], "block": {"id": "minecraft:oak_sign", "rotation": 8} }, 
                { "pos": [3, 2, 0], "block": {"id": "minecraft:oak_sign", "rotation": 8} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:oak_sign", "rotation": 4} }, 
        { "at": 1, "do": "remove", "pos": [3, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_sign", "rotation": 4} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:oak_sign", "rotation": 8} }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:air"                    } }, 
                { "pos": [3, 2, 0], "is": {"id": "minecraft:air"                    } }  
            ]
        }
    ], 
    "breakpoints": []
}

