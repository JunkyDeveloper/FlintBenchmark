{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "oak_sign_support_and_drop", 
    "description": "A standing oak sign breaks and drops an oak sign item when its support is removed, and a sign item used on a ceiling with no support places nothing.", 
    "tags": ["decoration", "sign", "support", "neighbor-update", "drops", "player"], 
    "minecraftIds": ["minecraft:oak_sign"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 5, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:oak_sign", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 5, 2] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:oak_sign", "rotation": 8} }, 
        { "at": 0, "do": "place", "pos": [4, 4, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_sign", "rotation": 8} }
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }, 
                {
                    "is": "minecraft:item", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [0.5, 1, 0.5], 
                    "position_tolerance": 1.5, 
                    "Item.id": "minecraft:oak_sign"
                }
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [4.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 3, 0], "is": {"id": "minecraft:air"                 }                    }, 
                {                   "is": {"id": "minecraft:oak_sign", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

