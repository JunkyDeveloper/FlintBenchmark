{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "oak_wall_hanging_sign_never_breaks", 
    "description": "A wall hanging sign stays in place after the blocks it was placed between are removed, because it has no survival check.", 
    "tags": ["decoration", "sign", "wall-hanging-sign", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:oak_wall_hanging_sign"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"                                   } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:stone"                                   } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:oak_wall_hanging_sign", "facing": "north"} }  
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 1, 0] }, 
        { "at": 1, "do": "remove", "pos": [2, 1, 0] }, 
        { "at": 1, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                                     } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                                     } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_wall_hanging_sign", "facing": "north"} }  
            ]
        }
    ], 
    "breakpoints": []
}

