{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "copper_stairs_weathering", 
    "description": "With a high random tick speed an unwaxed cut copper stair weathers to a later stage and keeps its properties, while a fully oxidized stair and a waxed stair stay unchanged.", 
    "tags": ["decoration", "stairs", "copper", "weathering", "random-tick"], 
    "minecraftIds": [
        "minecraft:cut_copper_stairs"         , 
        "minecraft:oxidized_cut_copper_stairs", 
        "minecraft:waxed_cut_copper_stairs"     
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [12, 3, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 1000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cut_copper_stairs", "facing": "west", "half": "top"} }, 
                {
                    "pos": [6, 1, 0], 
                    "block": {"id": "minecraft:oxidized_cut_copper_stairs", "facing": "west", "half": "top"}
                }, 
                {
                    "pos": [12, 1, 0], 
                    "block": {"id": "minecraft:waxed_cut_copper_stairs", "facing": "west", "half": "top"}
                }
            ]
        }, 
        {
            "at": 800, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:exposed_cut_copper_stairs"  , "facing": "west", "half": "top"}, 
                        {"id": "minecraft:weathered_cut_copper_stairs", "facing": "west", "half": "top"}, 
                        {"id": "minecraft:oxidized_cut_copper_stairs" , "facing": "west", "half": "top"}  
                    ]
                }, 
                {
                    "pos": [6, 1, 0], 
                    "is": {"id": "minecraft:oxidized_cut_copper_stairs", "facing": "west", "half": "top"}
                }, 
                {
                    "pos": [12, 1, 0], 
                    "is": {"id": "minecraft:waxed_cut_copper_stairs", "facing": "west", "half": "top"}
                }
            ]
        }
    ], 
    "breakpoints": []
}

