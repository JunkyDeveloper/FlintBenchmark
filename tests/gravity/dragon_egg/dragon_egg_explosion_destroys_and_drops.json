{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "dragon_egg_explosion_destroys_and_drops", 
    "description": "TNT exploding next to a dragon egg on an obsidian floor destroys the egg, and because the egg is in the explosion-resistant loot list it drops exactly one dragon egg item.", 
    "tags": ["gravity", "dragon-egg", "explosion", "drops"], 
    "minecraftIds": ["minecraft:dragon_egg", "minecraft:obsidian", "minecraft:tnt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-3, 0, -3], [6, 4, 5] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-3, 0, -3], [6, 0, 5] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:dragon_egg"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:dragon_egg"} }
            ]
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 1.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"} }, 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:dragon_egg", "Item.count": 1}
            ]
        }
    ], 
    "breakpoints": []
}

