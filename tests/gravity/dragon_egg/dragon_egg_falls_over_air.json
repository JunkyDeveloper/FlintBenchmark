{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "dragon_egg_falls_over_air", 
    "description": "A dragon egg placed over air stays for its 5-tick placement delay, then falls and lands on the floor as a dragon egg block.", 
    "tags": ["gravity", "dragon-egg", "falling"], 
    "minecraftIds": ["minecraft:dragon_egg", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 4, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "place", "pos": [0, 3, 0], "block": {"id": "minecraft:dragon_egg"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 3, 0], "is": {"id": "minecraft:dragon_egg"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"       } }  
            ]
        }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dragon_egg"} }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:air"       } }  
            ]
        }
    ], 
    "breakpoints": []
}

