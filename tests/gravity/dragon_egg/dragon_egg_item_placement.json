{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "dragon_egg_item_placement", 
    "description": "A survival player placing the dragon egg item on stone gets a dragon egg block on the clicked face, and the item is consumed.", 
    "tags": ["gravity", "dragon-egg", "placement", "player"], 
    "minecraftIds": ["minecraft:dragon_egg", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:dragon_egg", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dragon_egg"            }                    }, 
                {                   "is": {"id": "minecraft:air"       , "count": 0}, "slot": "hotbar1" }  
            ]
        }, 
        {
            "at": 15, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dragon_egg"} }
            ]
        }
    ], 
    "breakpoints": []
}

