{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "gravel_explosion_drops_one_item", 
    "description": "Gravel destroyed by a TNT explosion on an obsidian floor disappears and drops exactly one item entity (the loot is random, so which item it is is not asserted).", 
    "tags": ["gravity", "gravel", "drops", "explosion"], 
    "minecraftIds": ["minecraft:gravel", "minecraft:obsidian", "minecraft:tnt", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [14, 4, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [10, 0, 0], [13, 0, 2] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 1, "do": "place", "pos": [12, 1, 1], "block": {"id": "minecraft:gravel"} }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [12.5, 1, 2.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 60, 
            "do": "assert", 
            "checks": [
                { "pos": [12, 1, 1], "is": {"id": "minecraft:air"}                             }, 
                {                    "is": "minecraft:item"       , "exists": true, "count": 1 }  
            ]
        }
    ], 
    "breakpoints": []
}

