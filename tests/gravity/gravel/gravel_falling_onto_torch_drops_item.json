{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "gravel_falling_onto_torch_drops_item", 
    "description": "Gravel falling onto a floor torch cannot replace it, so it breaks into a gravel item and the torch survives.", 
    "tags": ["gravity", "gravel", "falling", "drops"], 
    "minecraftIds": ["minecraft:gravel", "minecraft:stone", "minecraft:torch", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [14, 6, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [10, 0, 0], [12, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [11, 1, 1], "block": {"id": "minecraft:torch"} }, 
        { "at": 1, "do": "place", "pos": [11, 5, 1], "block": {"id": "minecraft:gravel"} }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [11, 5, 1], "is": {"id": "minecraft:air"}                               }, 
                { "pos": [11, 1, 1], "is": {"id": "minecraft:torch"}                             }, 
                { "pos": [11, 2, 1], "is": {"id": "minecraft:air"}                               }, 
                {                    "is": "minecraft:item"         , "exists": true, "count": 1 }  
            ]
        }
    ], 
    "breakpoints": []
}

