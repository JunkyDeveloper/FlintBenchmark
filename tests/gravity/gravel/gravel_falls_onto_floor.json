{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "gravel_falls_onto_floor", 
    "description": "Gravel placed over air stays for the 2-tick schedule delay, then falls and lands on stone as gravel, leaving its starting position empty.", 
    "tags": ["gravity", "gravel", "falling"], 
    "minecraftIds": ["minecraft:gravel", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 6, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 5, 1], "block": {"id": "minecraft:gravel"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 5, 1], "is": {"id": "minecraft:gravel"} }
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 5, 1], "is": {"id": "minecraft:air"   } }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:gravel"} }, 
                { "pos": [1, 0, 1], "is": {"id": "minecraft:stone" } }  
            ]
        }
    ], 
    "breakpoints": []
}

