{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "gravel_falls_when_support_removed", 
    "description": "Resting gravel falls to the next solid floor after the stone supporting it is removed.", 
    "tags": ["gravity", "gravel", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:gravel", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 6, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 3, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 4, 1], "block": {"id": "minecraft:gravel"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 4, 1], "is": {"id": "minecraft:gravel"} }
            ]
        }, 
        { "at": 11, "do": "remove", "pos": [1, 3, 1] }, 
        { "at": 11, "do": "remove", "pos": [1, 2, 1] }, 
        { "at": 11, "do": "remove", "pos": [1, 1, 1] }, 
        {
            "at": 50, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 4, 1], "is": {"id": "minecraft:air"   } }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:gravel"} }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:air"   } }  
            ]
        }
    ], 
    "breakpoints": []
}

