{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "gravel_rests_on_bottom_slab", 
    "description": "Gravel placed on top of a bottom slab stays where it is because the slab is not free space.", 
    "tags": ["gravity", "gravel", "support", "slab"], 
    "minecraftIds": ["minecraft:gravel", "minecraft:stone", "minecraft:stone_slab"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 4, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:stone_slab", "type": "bottom"} }, 
        { "at": 1, "do": "place", "pos": [1, 2, 1], "block": {"id": "minecraft:gravel"} }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 2, 1], "is": {"id": "minecraft:gravel"                      } }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:stone_slab", "type": "bottom"} }  
            ]
        }
    ], 
    "breakpoints": []
}

