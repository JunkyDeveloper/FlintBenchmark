{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "gravel_survival_placement", 
    "description": "Gravel placed by a survival player onto stone stays in place, does not fall, and consumes the item.", 
    "tags": ["gravity", "gravel", "placement", "player"], 
    "minecraftIds": ["minecraft:gravel", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:gravel", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:gravel"            }                    }, 
                {                   "is": {"id": "minecraft:air"   , "count": 0}, "slot": "hotbar1" }  
            ]
        }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:gravel"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"   } }  
            ]
        }
    ], 
    "breakpoints": []
}

