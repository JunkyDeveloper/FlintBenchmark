        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }         , 
                {"is": "minecraft:copper_golem", "exists": true, "count": 1}, 
                { "slot": "hotbar1", "is": {"id": "minecraft:golden_axe"} }   
