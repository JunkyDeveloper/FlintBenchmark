{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "axe_strip_log_axes", 
    "description": "Using an axe on oak logs with axis x, y and z turns each into the stripped oak log with the same axis (AxeItem.getStripped copies RotatedPillarBlock.AXIS).", 
    "tags": ["item", "axe", "interaction", "player", "strip", "block-state"], 
    "minecraftIds": ["minecraft:golden_axe", "minecraft:oak_log", "minecraft:stripped_oak_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [4, 0, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_axe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:oak_log", "axis": "x"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:oak_log", "axis": "y"} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:oak_log", "axis": "z"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [4.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stripped_oak_log", "axis": "x"}                    }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:stripped_oak_log", "axis": "y"}                    }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:stripped_oak_log", "axis": "z"}                    }, 
                {                   "is": {"id": "minecraft:golden_axe"                   }, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

