                { "pos": [3, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [3, 2, 0], "block": {"id": "minecraft:stone"} }
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [3.5, 3, 0.5], "rot": [90, 41] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 125, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:sand"} }, 
                {
                    "is": "minecraft:item", 
                    "exists": true, 
                    "count": 1, 
