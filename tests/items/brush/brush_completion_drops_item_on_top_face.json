{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "brush_completion_drops_item_on_top_face", 
    "description": "Finishing a brushing from above spawns the hidden diamond as a dropped item above the brushed block.", 
    "tags": ["item", "brush", "suspicious-sand", "drop", "player"], 
