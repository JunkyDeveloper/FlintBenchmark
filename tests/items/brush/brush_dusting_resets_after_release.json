{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "brush_dusting_resets_after_release", 
    "description": "A partially brushed suspicious sand block keeps its dusted level while the brush count is retained, then decays back to dusted 0 once brushing stops.", 
    "tags": ["item", "brush", "suspicious-sand", "player"], 
    "minecraftIds": ["minecraft:brush", "minecraft:suspicious_sand"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "selected_hotbar": 1, 
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:brush"} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"          } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:suspicious_sand"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 2.5, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:suspicious_sand", "dusted": 2} }
            ]
        }, 
        { "at": 31, "do": "tp", "entity_alias": "player", "pos": [0.5, 2.5, 0.5], "rot": [0, -90] }, 
        {
            "at": 35, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:suspicious_sand", "dusted": 2} }
            ]
        }, 
        {
            "at": 160, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:suspicious_sand", "dusted": 0} }
            ]
        }
    ], 
    "breakpoints": []
}

