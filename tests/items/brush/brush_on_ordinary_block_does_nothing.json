{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "brush_on_ordinary_block_does_nothing", 
    "description": "Brushing plain sand for 60 ticks changes nothing, while the same held brush then dusts a suspicious sand block next to it, so the no-op is meaningful.", 
    "tags": ["item", "brush", "suspicious-sand", "player"], 
    "minecraftIds": ["minecraft:brush", "minecraft:sand", "minecraft:suspicious_sand"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:brush"} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 0, 0], "block": {"id": "minecraft:stone"          } }, 
                { "pos": [-1, 0, 0], "block": {"id": "minecraft:stone"          } }, 
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:sand"           } }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:suspicious_sand"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 2.5, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 60, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:sand"                        } }, 
                { "pos": [ 0, 0, 0], "is": {"id": "minecraft:stone"                       } }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:suspicious_sand", "dusted": 0} }  
            ]
        }, 
        { "at": 61, "do": "tp", "entity_alias": "player", "pos": [-0.5, 2.5, 0.5], "rot": [0, 90] }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [-1, 1, 0], 
                    "is": [
                        {"id": "minecraft:suspicious_sand", "dusted": 1}, 
                        {"id": "minecraft:suspicious_sand", "dusted": 2}, 
                        {"id": "minecraft:suspicious_sand", "dusted": 3}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

