{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "bucket_cannot_fill_in_adventure", 
    "description": "An adventure-mode player cannot pick up water with an empty bucket: the source stays and the bucket stays empty.", 
    "tags": ["item", "bucket", "water", "adventure", "player"], 
    "minecraftIds": ["minecraft:bucket", "minecraft:water"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 3] ]
        }, 
        "player": {
            "game_mode": "Adventure", 
            "inventory": { "hotbar1": {"id": "minecraft:bucket", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 1, 2], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [ 1, 2, 2], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [-1, 2, 2], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [ 0, 2, 2], "block": {"id": "minecraft:water", "level": 0} }  
            ]
        }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 0.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 2], "is": {"id": "minecraft:water" , "level": 0            }                    }, 
                {                   "is": {"id": "minecraft:bucket",             "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ]
}

