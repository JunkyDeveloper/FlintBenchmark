{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "bucket_dispenser_picks_up_water", 
    "description": "A powered dispenser holding an empty bucket and facing a water source removes the water and now holds a water bucket.", 
    "tags": ["item", "bucket", "dispenser", "water"], 
    "minecraftIds": [
        "minecraft:dispenser"     , "minecraft:bucket"        , "minecraft:water_bucket"  , "minecraft:water"         , 
        "minecraft:redstone_block"
    ], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 3] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 2], "block": {"id": "minecraft:stone"} }, 
                { "pos": [1, 2, 2], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 2, 2], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 2, 3], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 2, 2], "block": {"id": "minecraft:water", "level": 0} }, 
                {
                    "pos": [0, 2, 1], 
                    "block": {
                        "id": "minecraft:dispenser", 
                        "facing": "south", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:bucket\"}]"}
                    }
                }, 
                { "pos": [0, 3, 1], "block": {"id": "minecraft:redstone_block"} }
            ]
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 2], "is": {"id": "minecraft:air"} }, 
                {
                    "pos": [0, 2, 1], 
                    "is": { "id": "minecraft:dispenser", "nbt": {"Items[0].id": "minecraft:water_bucket"} }
                }
            ]
        }
    ]
}

