{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "bucket_fills_from_full_powder_snow_cauldron", 
    "description": "An empty bucket used on a full powder snow cauldron empties the cauldron and gives a powder snow bucket.", 
    "tags": ["item", "bucket", "cauldron", "powder-snow", "player"], 
    "minecraftIds": [
        "minecraft:bucket"              , "minecraft:powder_snow_bucket"  , "minecraft:powder_snow_cauldron", 
        "minecraft:cauldron"            
    ], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 3] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:bucket", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 1, 2], "block": {"id": "minecraft:stone"                           } }, 
                { "pos": [ 1, 2, 2], "block": {"id": "minecraft:stone"                           } }, 
                { "pos": [-1, 2, 2], "block": {"id": "minecraft:stone"                           } }, 
                { "pos": [ 0, 2, 2], "block": {"id": "minecraft:powder_snow_cauldron", "level": 3} }  
            ]
        }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 0.5], "rot": [0, 0] }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 2], "is": {"id": "minecraft:powder_snow_cauldron", "level": 3} }
            ]
        }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 2], "is": {"id": "minecraft:cauldron"                      }                    }, 
                {                   "is": {"id": "minecraft:powder_snow_bucket", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ]
}

