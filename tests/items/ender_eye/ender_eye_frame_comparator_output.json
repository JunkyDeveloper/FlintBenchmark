{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": [
        "minecraft:ender_eye"       , "minecraft:end_portal_frame", "minecraft:comparator"      , 
        "minecraft:redstone_lamp"   
    ], 
    "name": "ender_eye_frame_comparator_output", 
    "description": "A comparator reading an end portal frame outputs 0 while it is empty and 15 once an ender eye fills it, so the lamp behind the comparator lights up.", 
    "tags": ["item", "ender_eye", "end_portal_frame", "comparator", "redstone", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:ender_eye", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 0, 1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 0, 2], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:end_portal_frame", "facing": "north", "eye": "false"} }, 
                {
                    "pos": [0, 1, 1], 
                    "block": {"id": "minecraft:comparator", "facing": "north", "mode": "compare", "powered": "false"}
                }, 
                { "pos": [0, 1, 2], "block": {"id": "minecraft:redstone_lamp", "lit": "false"} }
            ]
        }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 2], "is": {"id": "minecraft:redstone_lamp", "lit": "false"} }
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:end_portal_frame", "eye": "true"} }, 
                { "pos": [0, 1, 1], "is": {"id": "minecraft:comparator", "powered": "true"}   }, 
                { "pos": [0, 1, 2], "is": {"id": "minecraft:redstone_lamp", "lit": "true"}    }  
            ]
        }
    ]
}

