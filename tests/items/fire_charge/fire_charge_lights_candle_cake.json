{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "fire_charge_lights_candle_cake", 
    "description": "Using a fire charge on an unlit candle cake lights it: CandleCakeBlock.useItemOn passes on fire charges so FireChargeItem.useOn runs (CandleCakeBlock.canLight). One charge is consumed and no fire is placed above.", 
    "tags": ["item", "fire_charge", "candle_cake", "ignite", "block-state", "player"], 
    "minecraftIds": ["minecraft:fire_charge", "minecraft:candle_cake", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:fire_charge", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                    } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:candle_cake", "lit": false} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:candle_cake", "lit": true}                    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"}                                         }, 
                {                   "is": {"id": "minecraft:fire_charge", "count": 1} , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

