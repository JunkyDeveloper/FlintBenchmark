        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:fire_charge", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:soul_sand"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:soul_fire"              }                    }, 
                {                   "is": {"id": "minecraft:fire_charge", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
