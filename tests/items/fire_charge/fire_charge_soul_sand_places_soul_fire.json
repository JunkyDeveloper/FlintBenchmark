{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "fire_charge_soul_sand_places_soul_fire", 
    "description": "Using a fire charge on top of soul sand places soul fire instead of normal fire (BaseFireBlock.getState checks SoulFireBlock.canSurviveOnBlock) and consumes one charge.", 
