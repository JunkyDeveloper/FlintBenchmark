        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "slot": "hotbar1", "is": {"id": "minecraft:firework_rocket", "count": 2} }, 
                {
                    "is": "minecraft:firework_rocket", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [0.5, 1.4, 0.5], 
