{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:fishing_rod", "minecraft:fishing_bobber"], 
    "name": "fishing_rod_reel_in_midair_keeps_rod", 
    "description": "Using a fishing rod a second time while its bobber is still in the air reels the bobber in and the rod is not consumed: it stays in the hand with count 1. This does not check durability.", 
    "tags": ["item", "fishing-rod", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [1, 3, 6] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:fishing_rod", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "slot": "hotbar1", "is": {"id": "minecraft:fishing_rod", "count": 1}                  }, 
                {                    "is": "minecraft:fishing_bobber"                 , "exists": false }  
            ]
        }
    ]
}

