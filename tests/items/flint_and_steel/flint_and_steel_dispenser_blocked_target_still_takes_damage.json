{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "flint_and_steel_dispenser_blocked_target_still_takes_damage", 
    "description": "A powered dispenser holding flint and steel facing solid stone changes nothing but still loses one durability, because FlintAndSteelDispenseItemBehavior never clears its success flag on that path.", 
    "tags": ["item", "flint-and-steel", "dispenser", "redstone"], 
    "minecraftIds": [
        "minecraft:flint_and_steel", "minecraft:dispenser"      , "minecraft:redstone_block" , 
        "minecraft:stone"          
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 2, 0] ]
        }
    }, 
    "timeline": [
