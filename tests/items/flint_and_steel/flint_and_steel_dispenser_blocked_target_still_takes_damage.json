            "region": [ [0, 0, 0], [1, 0, 0] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 1, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:dispenser", 
                        "facing": "east", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:flint_and_steel\"}]"}
                    }
                }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:dispenser", 
                        "nbt": {
                            "Items": "[{components: {\"minecraft:damage\": 1}, count: 1, Slot: 0b, id: \"minecraft:flint_and_steel\"}]"
                        }
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
