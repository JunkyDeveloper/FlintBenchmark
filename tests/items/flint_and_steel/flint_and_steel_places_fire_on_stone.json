{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "flint_and_steel_places_fire_on_stone", 
    "description": "Using flint and steel on the top of stone places fire above it (FlintAndSteelItem.useOn) and the item stays in the slot.", 
    "tags": ["item", "flint-and-steel", "fire", "player"], 
    "minecraftIds": ["minecraft:flint_and_steel", "minecraft:fire", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:flint_and_steel"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:fire"           }                    }, 
                {                   "is": {"id": "minecraft:flint_and_steel"}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

