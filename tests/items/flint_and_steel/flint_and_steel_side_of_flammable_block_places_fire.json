    "tags": ["item", "flint-and-steel", "fire", "flammability", "player"], 
    "minecraftIds": ["minecraft:flint_and_steel", "minecraft:fire", "minecraft:oak_planks"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [0, 2, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:oak_planks"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [-1.5, 0, 0.5], "rot": [-90, 0] }, 
        {"at": 1, "do": "interact", "item": "minecraft:flint_and_steel"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:fire"      , "east": true} }, 
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:oak_planks"              } }  
            ]
        }
    ], 
