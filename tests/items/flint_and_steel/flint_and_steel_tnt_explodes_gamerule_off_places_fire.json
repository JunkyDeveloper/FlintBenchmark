{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "flint_and_steel_tnt_explodes_gamerule_off_places_fire", 
    "description": "With the tnt_explodes gamerule off, TNT cannot be primed: TntBlock.useItemOn returns PASS, so FlintAndSteelItem.useOn runs and places fire on top of the TNT, which stays in place.", 
    "tags": ["item", "flint-and-steel", "tnt", "gamerule", "edge-case", "player"], 
    "minecraftIds": ["minecraft:flint_and_steel", "minecraft:tnt", "minecraft:fire"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs"     : false, 
                "minecraft:advance_time"   : false, 
                "minecraft:advance_weather": false, 
                "minecraft:tnt_explodes"   : false  
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:obsidian"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:tnt"     } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:flint_and_steel"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:tnt"}                   }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:fire"}                  }, 
                {                   "is": "minecraft:tnt"         , "exists": false }  
            ]
        }
    ], 
    "breakpoints": []
}

