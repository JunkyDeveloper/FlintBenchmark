{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "glass_bottle_dispenser_beehive_collect_honey", 
    "description": "A powered dispenser facing a beehive at honey level 5 turns the glass bottle into a honey bottle and resets the hive to honey level 0.", 
    "tags": ["glass-bottle", "honey-bottle", "dispenser", "beehive", "redstone"], 
    "minecraftIds": [
        "minecraft:glass_bottle"  , "minecraft:honey_bottle"  , "minecraft:dispenser"     , "minecraft:beehive"       , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 2, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [3, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:dispenser", 
                "facing": "east", 
                "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:glass_bottle\"}]"}
            }
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [1, 1, 0], 
            "block": {"id": "minecraft:beehive", "honey_level": 5, "facing": "east"}
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:dispenser", 
                        "nbt": {"Items": "[{count: 1, Slot: 0b, id: \"minecraft:honey_bottle\"}]"}
                    }
                }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:beehive", "honey_level": 0, "facing": "east"} }
            ]
        }
    ], 
    "breakpoints": []
}

