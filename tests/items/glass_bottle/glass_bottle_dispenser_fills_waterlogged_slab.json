{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "glass_bottle_dispenser_fills_waterlogged_slab", 
    "description": "A powered dispenser facing a waterlogged slab turns the glass bottle into a water potion and the slab stays waterlogged.", 
    "tags": ["glass-bottle", "dispenser", "water", "waterlogged", "redstone"], 
    "minecraftIds": [
        "minecraft:glass_bottle"  , "minecraft:potion"        , "minecraft:dispenser"     , "minecraft:oak_slab"      , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 2, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [3, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:dispenser", 
                "facing": "east", 
                "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:glass_bottle\"}]"}
            }
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [1, 1, 0], 
            "block": {"id": "minecraft:oak_slab", "type": "bottom", "waterlogged": true}
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:dispenser", 
                        "nbt": {
                            "Items": "[{components: {\"minecraft:potion_contents\": {potion: \"minecraft:water\"}}, count: 1, Slot: 0b, id: \"minecraft:potion\"}]"
                        }
                    }
                }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_slab", "type": "bottom", "waterlogged": true} }
            ]
        }
    ], 
    "breakpoints": []
}

