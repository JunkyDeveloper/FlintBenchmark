{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": [
        "minecraft:golden_hoe" , "minecraft:dirt"       , "minecraft:coarse_dirt", "minecraft:stone"      , 
        "minecraft:farmland"   
    ], 
    "name": "hoe_blocked_by_solid_block_above", 
    "description": "Dirt and coarse dirt with a stone block directly above are not changed when the hoe is used on a side face (onlyIfAirAbove fails); once the stone is removed the same click works.", 
    "tags": ["item", "hoe", "tilling", "edge-case", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [4, 4, 4] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_hoe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [2, 0, 0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [2, 0, 3], "block": {"id": "minecraft:coarse_dirt"} }, 
                { "pos": [2, 1, 3], "block": {"id": "minecraft:stone"      } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "rot": [-90, 37], "pos": [0.5, 0, 0.5] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 0, 0], "is": {"id": "minecraft:dirt"                  }                    }, 
                {                   "is": {"id": "minecraft:golden_hoe", "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [2, 1, 0] }, 
        { "at": 4, "do": "tp", "entity_alias": "player", "rot": [-90, 37], "pos": [0.5, 0, 0.5] }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }
            ]
        }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "rot": [-90, 37], "pos": [0.5, 0, 3.5] }, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 0, 3], "is": {"id": "minecraft:coarse_dirt"            }                    }, 
                {                   "is": {"id": "minecraft:golden_hoe" , "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 8, "do": "remove", "pos": [2, 1, 3] }, 
        { "at": 9, "do": "tp", "entity_alias": "player", "rot": [-90, 37], "pos": [0.5, 0, 3.5] }, 
        {"at": 9, "do": "interact"}, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 0, 3], "is": {"id": "minecraft:dirt"} }
            ]
        }
    ]
}

