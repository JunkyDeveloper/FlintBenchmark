{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:golden_hoe", "minecraft:dirt", "minecraft:farmland", "minecraft:stone"], 
    "name": "hoe_ignores_bottom_face", 
    "description": "Using a hoe on the bottom face of floating dirt does nothing (onlyIfAirAbove rejects Direction.DOWN); using it on the top face of the same dirt afterwards tills it.", 
    "tags": ["item", "hoe", "tilling", "edge-case", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [2, 5, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_hoe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0,  2, 0], "block": {"id": "minecraft:dirt" } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:dirt"                  }                    }, 
                {                   "is": {"id": "minecraft:golden_hoe", "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }
            ]
        }
    ]
}

