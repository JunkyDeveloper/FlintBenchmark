{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:golden_hoe", "minecraft:stone", "minecraft:farmland"], 
    "name": "hoe_ignores_non_tillable_blocks", 
    "description": "Using a hoe on stone or on already tilled farmland does nothing: they are not in the tillable table so useOn passes, and the hoe stays in hand.", 
    "tags": ["item", "hoe", "tilling", "edge-case", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [3, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_hoe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"}                                      }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 0}                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"}                                        }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"}                                        }, 
                {                   "is": {"id": "minecraft:golden_hoe", "count": 1} , "slot": "hotbar1" }  
            ]
        }
    ]
}

