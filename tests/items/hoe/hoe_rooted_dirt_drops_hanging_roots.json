{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:golden_hoe", "minecraft:rooted_dirt", "minecraft:dirt", "minecraft:hanging_roots"], 
    "name": "hoe_rooted_dirt_drops_hanging_roots", 
    "description": "Using a hoe on rooted dirt turns it into dirt and drops one hanging roots item (HoeItem TILLABLES, changeIntoStateAndDropItem).", 
    "tags": ["item", "hoe", "tilling", "drop", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [3, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_hoe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:rooted_dirt"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"} }                                   , 
                { "slot": "hotbar1", "is": {"id": "minecraft:golden_hoe", "count": 1} }                , 
                { "is": "minecraft:item", "count": 1, "pos": [0.5, 1, 0.5], "position_tolerance": 2.5 }  
            ]
        }
    ]
}

