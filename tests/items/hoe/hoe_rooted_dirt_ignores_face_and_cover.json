{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:golden_hoe", "minecraft:rooted_dirt", "minecraft:dirt", "minecraft:stone"], 
    "name": "hoe_rooted_dirt_ignores_face_and_cover", 
    "description": "Rooted dirt has an always-true predicate, so a hoe converts it to dirt when clicked from below, and when clicked on a side face with stone above it.", 
    "tags": ["item", "hoe", "tilling", "edge-case", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [4, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_hoe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, -1, 0], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [0,  2, 0], "block": {"id": "minecraft:rooted_dirt"} }, 
                { "pos": [3,  0, 0], "block": {"id": "minecraft:rooted_dirt"} }, 
                { "pos": [3,  1, 0], "block": {"id": "minecraft:stone"      } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:dirt"                  }                    }, 
                {                   "is": {"id": "minecraft:golden_hoe", "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [1.5, 0, 0.5], "rot": [-90, 37] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [3, 0, 0], "is": {"id": "minecraft:dirt"                  }                    }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:stone"                 }                    }, 
                {                   "is": {"id": "minecraft:golden_hoe", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ]
}

