                        "nbt": {
                            "front_text": "{color: \"red\", has_glowing_text: 1b, messages: [\"hi\", \"\", \"\", \"\"]}", 
                            "back_text": "{color: \"blue\", has_glowing_text: 1b, messages: [\"hi\", \"\", \"\", \"\"]}"
                        }
                    }
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -1.5], "rot": [0, 30] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
