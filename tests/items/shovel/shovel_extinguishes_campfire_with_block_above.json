                { "pos": [0, 3, 0], "block": {"id": "minecraft:stone"} }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 10] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "lit": false, 
                        "waterlogged": false, 
                        "signal_fire": false, 
                        "facing": "north"
                    }
                }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:stone"} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:golden_shovel", "count": 1} }
            ]
        }
