    "flintVersion": "1.1", 
    "name": "shovel_extinguishes_campfire_with_block_above", 
    "description": "A survival golden shovel used on the side of a lit campfire with stone directly above still puts it out, because the campfire branch of ShovelItem.useOn does not check the block above (unlike the flatten branch).", 
    "tags": ["item", "shovel", "campfire", "edge-case", "player"], 
    "minecraftIds": ["minecraft:golden_shovel", "minecraft:campfire", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -3], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_shovel", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
