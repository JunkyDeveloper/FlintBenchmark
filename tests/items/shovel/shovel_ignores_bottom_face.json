{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "shovel_ignores_bottom_face", 
    "description": "A survival golden shovel used on the bottom face of a floating dirt block does nothing, because ShovelItem.useOn returns PASS for a clicked face of DOWN.", 
    "tags": ["item", "shovel", "flatten", "edge-case", "player"], 
    "minecraftIds": ["minecraft:golden_shovel", "minecraft:dirt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, -1, 0], [0, 2, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_shovel", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0,  2, 0], "block": {"id": "minecraft:dirt" } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:dirt"                     }                    }, 
                {                   "is": {"id": "minecraft:golden_shovel", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

