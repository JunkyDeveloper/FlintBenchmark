{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "shovel_ignores_dirt_with_block_above", 
    "description": "A survival golden shovel used on the side of a dirt block with stone directly above does nothing, because ShovelItem.useOn requires air above the flattened block.", 
    "tags": ["item", "shovel", "flatten", "edge-case", "player"], 
    "minecraftIds": ["minecraft:golden_shovel", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -3], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:golden_shovel", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -3], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 2, 0], "block": {"id": "minecraft:dirt" } }, 
                { "pos": [0, 3, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:dirt"                     }                    }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:stone"                    }                    }, 
                {                   "is": {"id": "minecraft:golden_shovel", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

