{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "end_portal_frame_comparator_output", 
    "description": "A comparator reads 0 from an empty end portal frame and 15 from one with an eye; inserting an eye updates the comparator (updateNeighbourForOutputSignal) from 0 to 15.", 
    "tags": ["portal", "end_portal_frame", "ender_eye", "comparator", "redstone", "player"], 
    "minecraftIds": [
        "minecraft:end_portal_frame", "minecraft:ender_eye"       , "minecraft:comparator"      , 
        "minecraft:redstone_wire"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 1, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:ender_eye", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [1, 1, 0], 
                    "block": {"id": "minecraft:comparator", "facing": "west", "mode": "compare", "powered": false}
                }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:redstone_wire"} }, 
                {
                    "pos": [1, 1, 2], 
                    "block": {"id": "minecraft:comparator", "facing": "west", "mode": "compare", "powered": false}
                }, 
                { "pos": [2, 1, 2], "block": {"id": "minecraft:redstone_wire"} }
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:end_portal_frame", "facing": "north", "eye": false} }, 
                { "pos": [0, 1, 2], "block": {"id": "minecraft:end_portal_frame", "facing": "north", "eye": true } }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:comparator"   , "powered": false             } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:redstone_wire",                   "power":  0} }, 
                { "pos": [1, 1, 2], "is": {"id": "minecraft:comparator"   , "powered": true              } }, 
                { "pos": [2, 1, 2], "is": {"id": "minecraft:redstone_wire",                   "power": 15} }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:end_portal_frame", "facing": "north", "eye": true} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:ender_eye", "count": 1} }                            
            ]
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:comparator"   , "powered": true             } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:redstone_wire",                  "power": 15} }  
            ]
        }
    ], 
    "breakpoints": []
}

