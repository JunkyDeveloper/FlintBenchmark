{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "end_portal_frame_eye_already_filled", 
    "description": "Using an ender eye on a frame that already has an eye passes: the state is unchanged and the survival player keeps both eyes.", 
    "tags": ["portal", "end_portal_frame", "ender_eye", "block-state", "player"], 
    "minecraftIds": ["minecraft:end_portal_frame", "minecraft:ender_eye"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:ender_eye", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                          } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:end_portal_frame", "facing": "west", "eye": true} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:end_portal_frame", "facing": "west", "eye": true} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:ender_eye", "count": 2} }                           
            ]
        }
    ], 
    "breakpoints": []
}

