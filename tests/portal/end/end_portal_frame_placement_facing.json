{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "end_portal_frame_placement_facing", 
    "description": "A survival player placing an end portal frame gets eye=false and facing opposite to the player's horizontal direction (yaw 0 = south -> north, yaw 90 = west -> east); the item is consumed.", 
    "tags": ["portal", "end_portal_frame", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:end_portal_frame"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [1, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 0, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [-0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:end_portal_frame"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:end_portal_frame", "facing": "north", "eye": false} }, 
                {"slot": "hotbar1", "is": "empty"}                                                                  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [1.5, 3, 0.5], "rot": [90, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:end_portal_frame"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:end_portal_frame", "facing": "east", "eye": false} }, 
                {"slot": "hotbar1", "is": "empty"}                                                                
            ]
        }
    ], 
    "breakpoints": []
}

