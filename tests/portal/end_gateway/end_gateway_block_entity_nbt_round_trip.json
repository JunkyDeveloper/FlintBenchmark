{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:end_gateway"], 
    "name": "End Gateway Block Entity NBT Round Trip", 
    "description": "An end gateway set with exit_portal and ExactTeleport block-entity data keeps both values when its NBT is read back.", 
    "tags": ["portal", "end_gateway", "block-entity", "nbt"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:obsidian"} }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:end_gateway", 
                "nbt": {"exit_portal": "[I; 10, 70, -20]", "ExactTeleport": "1b"}
            }
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:end_gateway", 
                        "nbt": {
                            "exit_portal[0]": 10, 
                            "exit_portal[1]": 70, 
                            "exit_portal[2]": -20, 
                            "ExactTeleport": "1b"
                        }
                    }
                }
            ]
        }
    ]
}

