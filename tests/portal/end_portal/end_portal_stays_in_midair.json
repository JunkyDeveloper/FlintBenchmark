{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "end_portal_stays_in_midair", 
    "description": "An end portal block placed in mid-air with no support stays an end portal and is not removed by block updates.", 
    "tags": ["portal", "end_portal"], 
    "minecraftIds": ["minecraft:end_portal"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 2, 2] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:end_portal"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:end_portal"} }
            ]
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:end_portal"} }, 
                { "pos": [1, 0, 1], "is": {"id": "minecraft:air"       } }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:air"       } }  
            ]
        }
    ]
}

