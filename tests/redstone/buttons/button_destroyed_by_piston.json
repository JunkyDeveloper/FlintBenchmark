{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "button_destroyed_by_piston", 
    "description": "An extending piston destroys an oak or stone button in front of it instead of pushing it.", 
    "tags": ["redstone", "button", "oak-button", "stone-button", "piston", "push-reaction"], 
    "minecraftIds": ["minecraft:oak_button", "minecraft:stone_button", "minecraft:piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 5] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:stone"}                                            }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": false}      }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:oak_button", "face": "floor", "facing": "north"}   }, 
                { "pos": [1, 0, 4], "block": {"id": "minecraft:stone"}                                            }, 
                { "pos": [0, 1, 4], "block": {"id": "minecraft:piston", "facing": "east", "extended": false}      }, 
                { "pos": [1, 1, 4], "block": {"id": "minecraft:stone_button", "face": "floor", "facing": "north"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_button"  , "face": "floor"} }, 
                { "pos": [1, 1, 4], "is": {"id": "minecraft:stone_button", "face": "floor"} }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        { "at": 3, "do": "place", "pos": [0, 2, 4], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "extended": true, "facing": "east"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head",                   "facing": "east"} }, 
                { "pos": [0, 1, 4], "is": {"id": "minecraft:piston"     , "extended": true, "facing": "east"} }, 
                { "pos": [1, 1, 4], "is": {"id": "minecraft:piston_head",                   "facing": "east"} }  
            ]
        }
    ], 
    "breakpoints": []
}

