{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "button_washed_away_by_water", 
    "description": "Flowing water replaces an oak or stone button because buttons cannot hold fluid and cannot be waterlogged.", 
    "tags": ["redstone", "button", "oak-button", "stone-button", "fluid", "waterlogging"], 
    "minecraftIds": ["minecraft:oak_button", "minecraft:stone_button", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 2, 5] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 0, 5] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 2, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 1,  4], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  3], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  5], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  3], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  5], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 2, 1,  4], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_button"  , "face": "floor", "facing": "north"} }, 
                { "pos": [0, 1, 4], "block": {"id": "minecraft:stone_button", "face": "floor", "facing": "north"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_button"  } }, 
                { "pos": [0, 1, 4], "is": {"id": "minecraft:stone_button"} }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
        { "at": 3, "do": "place", "pos": [1, 1, 4], "block": {"id": "minecraft:water", "level": 0} }, 
        {
            "at": 14, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }, 
                { "pos": [0, 1, 4], "is": {"id": "minecraft:water"} }  
            ]
        }
    ], 
    "breakpoints": []
}

