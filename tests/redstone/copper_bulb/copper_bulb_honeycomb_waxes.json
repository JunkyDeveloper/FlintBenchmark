{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_bulb_honeycomb_waxes", 
    "description": "Using honeycomb on a lit, powered copper bulb turns it into a waxed copper bulb that keeps its lit and powered state and consumes one honeycomb.", 
    "tags": ["copper-bulb", "honeycomb", "wax-on", "interaction", "player"], 
    "minecraftIds": [
        "minecraft:copper_bulb"      , "minecraft:waxed_copper_bulb", "minecraft:honeycomb"        , 
        "minecraft:redstone_block"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [2, 3, 3] ]
        }, 
        "player": {
            "selected_hotbar": 1, 
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:honeycomb", "count": 2} }
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 2], "block": {"id": "minecraft:copper_bulb"   } }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:redstone_block"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 2], "is": {"id": "minecraft:waxed_copper_bulb", "lit": true, "powered": true} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:honeycomb", "count": 1} }                           
            ]
        }
    ], 
    "breakpoints": []
}

