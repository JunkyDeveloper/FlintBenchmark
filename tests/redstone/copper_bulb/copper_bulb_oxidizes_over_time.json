{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_bulb_oxidizes_over_time", 
    "description": "With a very high random tick speed an isolated unaffected copper bulb weathers to a later oxidation stage and keeps its lit state.", 
    "tags": ["copper-bulb", "weathering", "random-tick", "world-config"], 
    "minecraftIds": [
        "minecraft:copper_bulb"          , "minecraft:exposed_copper_bulb"  , "minecraft:weathered_copper_bulb", 
        "minecraft:oxidized_copper_bulb" 
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [1, 1, 1] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {"id": "minecraft:copper_bulb", "lit": true, "powered": false}
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:copper_bulb", "lit": true, "powered": false} }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": [
                        {"id": "minecraft:exposed_copper_bulb"  , "lit": true, "powered": false}, 
                        {"id": "minecraft:weathered_copper_bulb", "lit": true, "powered": false}, 
                        {"id": "minecraft:oxidized_copper_bulb" , "lit": true, "powered": false}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

