{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_bulb_axe_scrapes", 
    "description": "Using an axe on a lit, powered exposed copper bulb scrapes it back to a copper bulb that keeps its lit and powered state.", 
    "tags": ["copper-bulb", "exposed-copper-bulb", "axe", "scrape", "interaction", "player"], 
    "minecraftIds": [
        "minecraft:exposed_copper_bulb", "minecraft:copper_bulb"        , "minecraft:iron_axe"           , 
        "minecraft:redstone_block"     
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [2, 3, 3] ]
        }, 
        "player": {
            "selected_hotbar": 1, 
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:iron_axe", "count": 1} }
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 2], "block": {"id": "minecraft:exposed_copper_bulb"} }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:redstone_block"     } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, 0] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 2], "is": {"id": "minecraft:copper_bulb", "lit": true, "powered": true} }
            ]
        }
    ], 
    "breakpoints": []
}

