{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "waxed_bulb_comparator_output", 
    "description": "A comparator reading a lit waxed copper bulb outputs signal 15 and keeps doing so after the bulb loses power, while a comparator reading an unlit bulb outputs 0.", 
    "tags": ["redstone", "copper-bulb", "waxed-copper-bulb", "comparator", "analog-output"], 
    "minecraftIds": [
        "minecraft:waxed_copper_bulb", "minecraft:comparator"       , "minecraft:redstone_lamp"    , 
        "minecraft:redstone_block"   , "minecraft:stone"            
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [3, 1, 5] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, -1, -1], [3, -1, 5] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:waxed_copper_bulb"                  } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:comparator"       , "facing": "west"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:redstone_lamp"                      } }, 
                { "pos": [0, 0, 4], "block": {"id": "minecraft:waxed_copper_bulb"                  } }, 
                { "pos": [1, 0, 4], "block": {"id": "minecraft:comparator"       , "facing": "west"} }, 
                { "pos": [2, 0, 4], "block": {"id": "minecraft:redstone_lamp"                      } }  
            ]
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:waxed_copper_bulb", "lit": true , "powered": true } }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:comparator"       ,               "powered": true } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:redstone_lamp"    , "lit": true                   } }, 
                { "pos": [0, 0, 4], "is": {"id": "minecraft:waxed_copper_bulb", "lit": false                  } }, 
                { "pos": [1, 0, 4], "is": {"id": "minecraft:comparator"       ,               "powered": false} }, 
                { "pos": [2, 0, 4], "is": {"id": "minecraft:redstone_lamp"    , "lit": false                  } }  
            ]
        }, 
        { "at": 11, "do": "remove", "pos": [0, 0, 1] }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:waxed_copper_bulb", "lit": true, "powered": false} }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:comparator"       ,              "powered": true } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:redstone_lamp"    , "lit": true                  } }  
            ]
        }
    ], 
    "breakpoints": []
}

