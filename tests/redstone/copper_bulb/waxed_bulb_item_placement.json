{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "waxed_bulb_item_placement", 
    "description": "A survival player placing the waxed copper bulb item against a redstone block gets a lit, powered bulb because placement runs the power check, and uses up one item.", 
    "tags": ["redstone", "copper-bulb", "waxed-copper-bulb", "placement", "player"], 
    "minecraftIds": ["minecraft:waxed_copper_bulb", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [2, 3, 3] ]
        }, 
        "player": {
            "selected_hotbar": 1, 
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:waxed_copper_bulb", "count": 2} }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 2], "block": {"id": "minecraft:redstone_block"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 1], "is": {"id": "minecraft:waxed_copper_bulb", "lit": true, "powered": true} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:waxed_copper_bulb", "count": 1} }                   
            ]
        }
    ], 
    "breakpoints": []
}

