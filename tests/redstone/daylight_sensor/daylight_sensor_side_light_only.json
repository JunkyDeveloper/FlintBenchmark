{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "daylight_sensor_side_light_only", 
    "description": "A daylight detector with a solid block directly above it receives sky light only from the sides, which is 14, so at noon a normal one outputs 14 and an inverted one outputs 1.", 
    "tags": ["redstone", "daylight-sensor", "sky-light"], 
    "minecraftIds": ["minecraft:daylight_detector", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, -1, -1], [2, 3, 1] ]
        }, 
        "world": {"time": "6000"}
    }, 
    "timeline": [
        {
            "at": 105, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 1, -1], "block": {"id": "minecraft:stone"                               } }, 
                { "pos": [1, 1,  1], "block": {"id": "minecraft:stone"                               } }, 
                { "pos": [1, 0, -1], "block": {"id": "minecraft:daylight_detector", "inverted": false} }, 
                { "pos": [1, 0,  1], "block": {"id": "minecraft:daylight_detector", "inverted": true } }  
            ]
        }, 
        {
            "at": 130, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 0, -1], "is": {"id": "minecraft:daylight_detector", "inverted": false, "power": 14} }, 
                { "pos": [1, 0,  1], "is": {"id": "minecraft:daylight_detector", "inverted": true , "power":  1} }  
            ]
        }
    ], 
    "breakpoints": []
}

