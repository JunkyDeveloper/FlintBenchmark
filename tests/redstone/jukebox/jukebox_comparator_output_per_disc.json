{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_comparator_output_per_disc", 
    "description": "A comparator reads a jukebox's stored disc rather than playback: discs 13, cat, mellohi, 5 and relic give outputs 1, 2, 7, 15 and 14, and since they were loaded without a song start the jukeboxes stay silent and adjacent lamps stay off.", 
    "tags": ["jukebox", "music-disc", "comparator", "redstone", "block-entity"], 
    "minecraftIds": [
        "minecraft:jukebox"           , "minecraft:comparator"        , "minecraft:redstone_lamp"     , 
        "minecraft:stone"             , "minecraft:music_disc_13"     , "minecraft:music_disc_cat"    , 
        "minecraft:music_disc_mellohi", "minecraft:music_disc_5"      , "minecraft:music_disc_relic"  
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [1, 1, 8] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, 0], [1, 0, 8] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 1, 1, 0], "block": {"id": "minecraft:comparator"   , "facing": "west"} }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_lamp"                  } }, 
                { "pos": [ 1, 1, 2], "block": {"id": "minecraft:comparator"   , "facing": "west"} }, 
                { "pos": [-1, 1, 2], "block": {"id": "minecraft:redstone_lamp"                  } }, 
                { "pos": [ 1, 1, 4], "block": {"id": "minecraft:comparator"   , "facing": "west"} }, 
                { "pos": [-1, 1, 4], "block": {"id": "minecraft:redstone_lamp"                  } }, 
                { "pos": [ 1, 1, 6], "block": {"id": "minecraft:comparator"   , "facing": "west"} }, 
                { "pos": [-1, 1, 6], "block": {"id": "minecraft:redstone_lamp"                  } }, 
                { "pos": [ 1, 1, 8], "block": {"id": "minecraft:comparator"   , "facing": "west"} }, 
                { "pos": [-1, 1, 8], "block": {"id": "minecraft:redstone_lamp"                  } }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem": "{id: \"minecraft:music_disc_13\", count: 1}"}
                    }
                }, 
                {
                    "pos": [0, 1, 2], 
                    "block": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem": "{id: \"minecraft:music_disc_cat\", count: 1}"}
                    }
                }, 
                {
                    "pos": [0, 1, 4], 
                    "block": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem": "{id: \"minecraft:music_disc_mellohi\", count: 1}"}
                    }
                }, 
                {
                    "pos": [0, 1, 6], 
                    "block": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem": "{id: \"minecraft:music_disc_5\", count: 1}"}
                    }
                }, 
                {
                    "pos": [0, 1, 8], 
                    "block": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem": "{id: \"minecraft:music_disc_relic\", count: 1}"}
                    }
                }
            ]
        }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 1} }
                }, 
                {
                    "pos": [1, 1, 2], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 2} }
                }, 
                {
                    "pos": [1, 1, 4], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 7} }
                }, 
                {
                    "pos": [1, 1, 6], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 15} }
                }, 
                {
                    "pos": [1, 1, 8], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 14} }
                }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": true} }, 
                { "pos": [-1, 1, 2], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [0, 1, 2], "is": {"id": "minecraft:jukebox", "has_record": true} }, 
                { "pos": [-1, 1, 4], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [0, 1, 4], "is": {"id": "minecraft:jukebox", "has_record": true} }, 
                { "pos": [-1, 1, 6], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [0, 1, 6], "is": {"id": "minecraft:jukebox", "has_record": true} }, 
                { "pos": [-1, 1, 8], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [0, 1, 8], "is": {"id": "minecraft:jukebox", "has_record": true} }
            ]
        }
    ], 
    "breakpoints": []
}

