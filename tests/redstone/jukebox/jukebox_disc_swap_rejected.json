{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_disc_swap_rejected", 
    "description": "Using a second music disc on a jukebox that already holds one ejects the stored disc instead of inserting the held one, which stays in the player's hand.", 
    "tags": ["jukebox", "music-disc", "block-entity", "player"], 
    "minecraftIds": [
        "minecraft:jukebox"           , "minecraft:music_disc_cat"    , "minecraft:music_disc_mellohi", 
        "minecraft:stone"             , "minecraft:item"              
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:music_disc_mellohi", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {
                            "RecordItem"              : "{id: \"minecraft:music_disc_cat\", count: 1}", 
                            "ticks_since_song_started": "0L"                                            
                        }
                    }
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": false} }               , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:music_disc_cat"}, 
                { "slot": "hotbar1", "is": {"id": "minecraft:music_disc_mellohi", "count": 1} }              
            ]
        }
    ], 
    "breakpoints": []
}

