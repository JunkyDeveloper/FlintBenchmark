{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_eject_disc_empty_hand", 
    "description": "Using an empty hand on a jukebox playing an inserted disc pops the disc out as an item entity, sets has_record to false, clears RecordItem, turns an adjacent lamp off and drops the comparator output from 2 to 0.", 
    "tags": ["jukebox", "music-disc", "block-entity", "comparator", "redstone", "player"], 
    "minecraftIds": [
        "minecraft:jukebox"       , "minecraft:music_disc_cat", "minecraft:redstone_lamp" , "minecraft:comparator"    , 
        "minecraft:stone"         , "minecraft:item"          
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:music_disc_cat", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:jukebox"                        } }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_lamp"                  } }, 
                { "pos": [ 1, 1, 0], "block": {"id": "minecraft:comparator"   , "facing": "west"} }  
            ]
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": false}                  }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false}                   }, 
                {                    "is": "minecraft:item"                                , "exists": false }  
            ]
        }, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem.id": "minecraft:music_disc_cat"}
                    }
                }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": true} }, 
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 2} }
                }, 
                {"slot": "hotbar1", "is": "empty"}, 
                {"is": "minecraft:item", "exists": false}
            ]
        }, 
        {"at": 9, "do": "interact"}, 
        {
            "at": 13, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": false} }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 0} }
                }, 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:music_disc_cat"}
            ]
        }
    ], 
    "breakpoints": []
}

