{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_hopper_rejects_non_disc", 
    "description": "A hopper above an empty jukebox cannot insert a non-playable item: the stone stays in the hopper and the jukebox stays empty.", 
    "tags": ["jukebox", "hopper", "container", "block-entity", "item-transfer"], 
    "minecraftIds": ["minecraft:jukebox", "minecraft:hopper", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:jukebox"} }, 
                {
                    "pos": [0, 2, 0], 
                    "block": {
                        "id": "minecraft:hopper", 
                        "facing": "down", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:stone\"}]", "TransferCooldown": 0}
                    }
                }
            ]
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": false} }, 
                {
                    "pos": [0, 2, 0], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items[0].id": "minecraft:stone", "Items[0].count": 1} }
                }
            ]
        }
    ], 
    "breakpoints": []
}

