{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_insert_disc_creative", 
    "description": "A creative player using a cat music disc on an empty jukebox inserts a copy of it: has_record becomes true and RecordItem holds the disc, but the held disc is not consumed.", 
    "tags": ["jukebox", "music-disc", "block-entity", "creative", "player"], 
    "minecraftIds": ["minecraft:jukebox", "minecraft:music_disc_cat", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:music_disc_cat", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Creative"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"  } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:jukebox"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem.id": "minecraft:music_disc_cat", "RecordItem.count": 1}
                    }
                }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:music_disc_cat", "count": 1} }
            ]
        }
    ], 
    "breakpoints": []
}

