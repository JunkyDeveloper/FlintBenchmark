{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_non_disc_item_ignored", 
    "description": "Using a diamond, which is not jukebox playable, on an empty jukebox changes nothing: has_record stays false, no record is stored and the diamond stays in hand.", 
    "tags": ["jukebox", "block-entity", "player"], 
    "minecraftIds": ["minecraft:jukebox", "minecraft:diamond", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:diamond", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"  } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:jukebox"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": false} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:diamond", "count": 1} }        , 
                {"is": "minecraft:item", "exists": false}                                     
            ]
        }
    ], 
    "breakpoints": []
}

