{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_place_item_empty", 
    "description": "A survival player placing a jukebox item on stone creates a jukebox with has_record false, silent and with no comparator output, and consumes the item.", 
    "tags": ["jukebox", "placement", "block-entity", "comparator", "player"], 
    "minecraftIds": ["minecraft:jukebox", "minecraft:stone", "minecraft:comparator"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:jukebox", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [1, 0, 0] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }
            ]
        }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:jukebox", "has_record": false} }, 
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 0} }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

