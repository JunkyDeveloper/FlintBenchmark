{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_playing_weak_power_only", 
    "description": "A jukebox playing an inserted disc weakly powers an adjacent lamp, but does not strongly power a solid block next to it, so a lamp on the far side of that block stays off.", 
    "tags": ["jukebox", "music-disc", "redstone", "signal", "weak-power", "player"], 
    "minecraftIds": ["minecraft:jukebox", "minecraft:music_disc_cat", "minecraft:redstone_lamp", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [2, 1, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:music_disc_cat", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [2, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:jukebox"      } }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_lamp"} }, 
                { "pos": [ 1, 1, 0], "block": {"id": "minecraft:stone"        } }, 
                { "pos": [ 2, 1, 0], "block": {"id": "minecraft:redstone_lamp"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                { "pos": [ 2, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }  
            ]
        }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:jukebox"      , "has_record": true              } }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp",                     "lit": true } }, 
                { "pos": [ 2, 1, 0], "is": {"id": "minecraft:redstone_lamp",                     "lit": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

