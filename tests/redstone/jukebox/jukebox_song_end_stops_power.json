{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "jukebox_song_end_stops_power", 
    "description": "A jukebox near the end of disc 11 (71 seconds, ending at tick 1440) powers an adjacent lamp until the song finishes; afterwards the lamp turns off, while the disc stays inside, has_record stays true and the comparator still reads 11.", 
    "tags": ["jukebox", "music-disc", "redstone", "signal", "comparator", "block-entity"], 
    "minecraftIds": [
        "minecraft:jukebox"      , "minecraft:music_disc_11", "minecraft:redstone_lamp", "minecraft:comparator"   , 
        "minecraft:stone"        
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [1, 1, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_lamp"                  } }, 
                { "pos": [ 1, 1, 0], "block": {"id": "minecraft:comparator"   , "facing": "west"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:jukebox", 
                "has_record": true, 
                "nbt": {
                    "RecordItem"              : "{id: \"minecraft:music_disc_11\", count: 1}", 
                    "ticks_since_song_started": "1420L"                                        
                }
            }
        }, 
        { "at": 3, "do": "place", "pos": [-2, 1, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": true} }, 
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 11} }
                }
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:jukebox", 
                        "has_record": true, 
                        "nbt": {"RecordItem.id": "minecraft:music_disc_11"}
                    }
                }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }, 
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 11} }
                }
            ]
        }
    ], 
    "breakpoints": []
}

