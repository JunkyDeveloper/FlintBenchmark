{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_lightning_rod_axe_scrapes", 
    "description": "Using an axe on an exposed lightning rod scrapes it back one stage to lightning_rod, keeping facing, powered and waterlogged state.", 
    "tags": ["redstone", "lightning-rod", "exposed", "axe", "scrape", "player"], 
    "minecraftIds": ["minecraft:exposed_lightning_rod", "minecraft:lightning_rod", "minecraft:stone_axe"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [4, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:stone_axe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id"         : "minecraft:exposed_lightning_rod", 
                        "facing"     : "up"                             , 
                        "powered"    : "false"                          , 
                        "waterlogged": "false"                            
                    }
                }, 
                {
                    "pos": [4, 1, 0], 
                    "block": {
                        "id"         : "minecraft:exposed_lightning_rod", 
                        "facing"     : "east"                           , 
                        "powered"    : "false"                          , 
                        "waterlogged": "true"                             
                    }
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:lightning_rod", "facing": "up", "powered": "false", "waterlogged": "false"}
                }, 
                {
                    "pos": [4, 1, 0], 
                    "is": {"id": "minecraft:lightning_rod", "facing": "east", "powered": "false", "waterlogged": "true"}
                }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:stone_axe", "count": 1} }
            ]
        }
    ], 
    "breakpoints": []
}

