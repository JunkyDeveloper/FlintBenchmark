{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_lightning_rod_struck_by_lightning", 
    "description": "A lightning bolt striking an exposed lightning rod resets it to plain lightning_rod (keeping facing), powers it and a lamp beside it, and the replacement rod still turns unpowered after about 8 ticks because placing it schedules a new reset tick.", 
    "tags": ["redstone", "lightning-rod", "exposed", "lightning", "weathering-reset", "powered", "scheduled-tick"], 
    "minecraftIds": [
        "minecraft:exposed_lightning_rod", "minecraft:lightning_rod"        , "minecraft:lightning_bolt"       , 
        "minecraft:redstone_lamp"        
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:redstone_lamp"} }, 
                {
                    "pos": [0, 0, 0], 
                    "block": {
                        "id": "minecraft:exposed_lightning_rod", 
                        "facing": "up", 
                        "powered": false, 
                        "waterlogged": false
                    }
                }
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:exposed_lightning_rod", "powered": false              } }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:redstone_lamp"        ,                   "lit": false} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "bolt", 
            "entity_type": "minecraft:lightning_bolt", 
            "pos": [0.5, 1, 0.5]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {"id": "minecraft:lightning_rod", "facing": "up", "powered": true, "waterlogged": false}
                }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:redstone_lamp", "lit": true} }
            ]
        }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {"id": "minecraft:lightning_rod", "facing": "up", "powered": false, "waterlogged": false}
                }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:redstone_lamp", "lit": false} }
            ]
        }
    ], 
    "breakpoints": []
}

