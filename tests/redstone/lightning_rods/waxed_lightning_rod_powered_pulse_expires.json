            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:waxed_lightning_rod", "facing": "up", "powered": true, "waterlogged": false}
                }
            ]
        }, 
        {
            "at": [10, 14], 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:waxed_lightning_rod", 
                        "facing": "up", 
