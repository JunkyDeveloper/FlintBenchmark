            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 4, 1, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
