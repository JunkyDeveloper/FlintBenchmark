{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "exposed_lightning_rod_weathering", 
    "description": "With a high random tick speed an unwaxed exposed lightning rod weathers only forward along its chain (exposed, weathered, oxidized) and keeps its facing, powered and waterlogged state. Representative of lightning_rod, exposed, weathered and oxidized rods (WeatheringLightningRodBlock). Weathering is random: failing to move at least one stage in 300 ticks has a probability of roughly 2e-6.", 
    "tags": ["redstone", "lightning-rod", "weathering", "random-tick", "modifies-gamerule"], 
    "minecraftIds": [
        "minecraft:exposed_lightning_rod"  , "minecraft:weathered_lightning_rod", "minecraft:oxidized_lightning_rod" 
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 0, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {
                "id"         : "minecraft:exposed_lightning_rod", 
                "facing"     : "east"                           , 
                "powered"    : "false"                          , 
                "waterlogged": "false"                            
            }
        }, 
        {
            "at": [1, 50, 100, 150, 200, 250], 
            "do": "assert", 
