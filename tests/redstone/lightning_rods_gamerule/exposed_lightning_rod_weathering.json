                            "waterlogged": "false"                            
                        }, 
                        {
                            "id"         : "minecraft:weathered_lightning_rod", 
                            "facing"     : "east"                             , 
                            "powered"    : "false"                            , 
                            "waterlogged": "false"                              
                        }, 
                        {
                            "id"         : "minecraft:oxidized_lightning_rod", 
                            "facing"     : "east"                            , 
                            "powered"    : "false"                           , 
                            "waterlogged": "false"                             
                        }
                    ]
                }
            ]
        }, 
