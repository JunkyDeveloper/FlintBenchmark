{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "oak_pressure_plate_piston_destroy", 
    "description": "A piston extending into a wooden pressure plate destroys it and takes its place.", 
    "tags": ["redstone", "pressure-plate", "piston", "push-reaction"], 
    "minecraftIds": ["minecraft:oak_pressure_plate", "minecraft:piston"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 2, 0] ]
        }
