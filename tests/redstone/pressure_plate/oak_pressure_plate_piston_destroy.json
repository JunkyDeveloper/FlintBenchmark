        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:oak_pressure_plate"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_pressure_plate"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:piston"     , "extended": true                } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston_head",                   "facing": "up"} }  
            ]
        }
    ], 
    "breakpoints": []
}

