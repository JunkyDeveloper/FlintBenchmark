{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "big_dripleaf_bonemeal_into_water", 
    "description": "Bone meal on a big dripleaf with a water source above grows the new top leaf into the water, making it waterlogged, while the stem left below stays dry.", 
    "tags": ["vegetation", "big-dripleaf", "bone-meal", "growth", "player", "waterlogging"], 
    "minecraftIds": [
        "minecraft:big_dripleaf"     , "minecraft:big_dripleaf_stem", "minecraft:bone_meal"        , 
        "minecraft:water"            , "minecraft:dirt"             
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 2, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 0,  0], "block": {"id": "minecraft:dirt" } }, 
                { "pos": [ 1, 2,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 2,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2, -1], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:big_dripleaf", "facing": "west"} }, 
        { "at": 2, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:water"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:big_dripleaf", "facing": "west", "waterlogged": false} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:water", "level": 0}                                    }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact", "item": "minecraft:bone_meal"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf_stem", "facing": "west", "waterlogged": false}
                }, 
                {
                    "pos": [0, 2, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "west", "tilt": "none", "waterlogged": true}
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

