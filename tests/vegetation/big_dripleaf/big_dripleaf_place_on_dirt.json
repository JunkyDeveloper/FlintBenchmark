{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "big_dripleaf_place_on_dirt", 
    "description": "A survival player placing a big dripleaf on dirt creates an untilted, non-waterlogged leaf facing opposite the player's horizontal look direction and consumes the item.", 
    "tags": ["vegetation", "big-dripleaf", "placement", "player", "block-state"], 
    "minecraftIds": ["minecraft:big_dripleaf", "minecraft:dirt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"} }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [90, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:big_dripleaf"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"} }, 
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "east", "tilt": "none", "waterlogged": false}
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

