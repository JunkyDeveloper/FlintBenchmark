{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "big_dripleaf_place_on_supports", 
    "description": "A big dripleaf item can be placed on blocks from the supports_big_dripleaf tag: grass block, moss block, clay, mud and farmland.", 
    "tags": ["vegetation", "big-dripleaf", "placement", "player", "support"], 
    "minecraftIds": [
        "minecraft:big_dripleaf", "minecraft:grass_block" , "minecraft:moss_block"  , "minecraft:clay"        , 
        "minecraft:mud"         , "minecraft:farmland"    
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [8, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:moss_block" } }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:clay"       } }, 
                { "pos": [6, 0, 0], "block": {"id": "minecraft:mud"        } }, 
                { "pos": [8, 0, 0], "block": {"id": "minecraft:farmland"   } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:moss_block" } }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:clay"       } }, 
                { "pos": [6, 0, 0], "is": {"id": "minecraft:mud"        } }, 
                { "pos": [8, 0, 0], "is": {"id": "minecraft:farmland"   } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:big_dripleaf"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [2.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:big_dripleaf"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact", "item": "minecraft:big_dripleaf"}, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [6.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 4, "do": "interact", "item": "minecraft:big_dripleaf"}, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [8.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:big_dripleaf"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none", "waterlogged": false}
                }, 
                {
                    "pos": [2, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none", "waterlogged": false}
                }, 
                {
                    "pos": [4, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none", "waterlogged": false}
                }, 
                {
                    "pos": [6, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none", "waterlogged": false}
                }, 
                {
                    "pos": [8, 1, 0], 
                    "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none", "waterlogged": false}
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

