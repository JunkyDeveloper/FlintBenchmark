{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "big_dripleaf_support_loss", 
    "description": "A big dripleaf breaks as soon as the dirt supporting it is removed.", 
    "tags": ["vegetation", "big-dripleaf", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:big_dripleaf", "minecraft:dirt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:big_dripleaf", "facing": "north"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"                                           } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none"} }  
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }  
            ]
        }
    ], 
    "breakpoints": []
}

