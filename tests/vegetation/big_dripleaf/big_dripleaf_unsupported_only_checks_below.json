{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "big_dripleaf_unsupported_only_checks_below", 
    "description": "A big dripleaf force-placed on stone survives an update from a side neighbour, because survival is only re-checked when the block below changes. Replacing the stone with cobblestone, also unsupported, then breaks it.", 
    "tags": ["vegetation", "big-dripleaf", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:big_dripleaf", "minecraft:stone", "minecraft:cobblestone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:big_dripleaf", "facing": "north"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none"} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:stone"                                          } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:big_dripleaf", "facing": "north", "tilt": "none"} }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:cobblestone"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:cobblestone"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"        } }  
            ]
        }
    ], 
    "breakpoints": []
}

