{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "crimson_fungus_destroyed_by_piston", 
    "description": "A piston extending into a crimson fungus destroys it instead of pushing it, and the piston head takes its place.", 
    "tags": ["vegetation", "crimson_fungus", "piston", "push-reaction"], 
    "minecraftIds": [
        "minecraft:crimson_fungus", "minecraft:crimson_nylium", "minecraft:piston"        , "minecraft:piston_head"   , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [14, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, -1], [14, 3, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [12, 1, 0], [13, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [13, 0, 0], "block": {"id": "minecraft:crimson_nylium"}                              }, 
                { "pos": [13, 1, 0], "block": {"id": "minecraft:crimson_fungus"}                              }, 
                { "pos": [12, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": false} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [13, 1, 0], "is": {"id": "minecraft:crimson_fungus"} }
            ]
        }, 
        { "at": 5, "do": "place", "pos": [12, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [12, 1, 0], "is": {"id": "minecraft:piston"     , "facing": "east", "extended": true} }, 
                { "pos": [13, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"                  } }  
            ]
        }
    ], 
    "breakpoints": []
}

