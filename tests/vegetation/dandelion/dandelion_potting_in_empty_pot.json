{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dandelion_potting_in_empty_pot", 
    "description": "A dandelion item used on an empty flower pot turns it into a potted dandelion and consumes the item.", 
    "tags": ["vegetation", "dandelion", "flower-pot", "player"], 
    "minecraftIds": ["minecraft:dandelion", "minecraft:stone", "minecraft:flower_pot", "minecraft:potted_dandelion"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, -1, -2], [2, 4, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:dandelion", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, -1, -2], [2, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [1, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:flower_pot"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 6, 0.5] }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:potted_dandelion"}                    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"}                                 }, 
                {                   "is": "empty"                             , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

