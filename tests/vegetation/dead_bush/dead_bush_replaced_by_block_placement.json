{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dead_bush_replaced_by_block_placement", 
    "description": "A survival player placing a stone block against a dead bush replaces the dead bush instead of placing next to it, because the dead bush is replaceable.", 
    "tags": ["vegetation", "dead_bush", "placement", "replaceable", "player"], 
    "minecraftIds": ["minecraft:dead_bush", "minecraft:sand", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [2, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:stone", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, -1, -1], [2, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:sand"} }, 
        { "at": 4, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:dead_bush"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 6, 0.5] }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:sand"}                     }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"}                    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"}                      }, 
                {                   "is": "empty"                  , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

