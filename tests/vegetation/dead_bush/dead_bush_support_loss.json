{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dead_bush_support_loss", 
    "description": "A dead bush on sand or terracotta becomes air once the block beneath it is removed.", 
    "tags": ["vegetation", "dead_bush", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:dead_bush", "minecraft:sand", "minecraft:terracotta"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [3, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, -1, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [1, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:sand"} }, 
        { "at": 4, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:terracotta"} }, 
        { "at": 4, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:dead_bush"} }, 
        { "at": 4, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:dead_bush"} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dead_bush"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:dead_bush"} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 0, 0] }, 
        { "at": 5, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }  
            ]
        }
    ], 
    "breakpoints": []
}

