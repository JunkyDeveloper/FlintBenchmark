{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dead_bush_washed_away_by_water", 
    "description": "Water flowing sideways along a stone channel into the space of a dead bush replaces the dead bush with water, since the dead bush has no collision and is replaceable.", 
    "tags": ["vegetation", "dead_bush", "fluid", "water", "neighbor-update"], 
    "minecraftIds": ["minecraft:dead_bush", "minecraft:water", "minecraft:sand", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [4, 1, -1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, 1], [4, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [2, 0, 0], "block": {"id": "minecraft:sand"} }, 
        { "at": 0, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:dead_bush"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:dead_bush"} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:water"} }  
            ]
        }
    ], 
    "breakpoints": []
}

