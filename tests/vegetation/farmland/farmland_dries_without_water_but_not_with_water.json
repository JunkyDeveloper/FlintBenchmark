{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_dries_without_water_but_not_with_water", 
    "description": "Fully moist farmland with no water nearby loses moisture on random ticks until it turns to dirt, while farmland next to a water source keeps moisture 7.", 
    "tags": ["vegetation", "farmland", "moisture", "drying", "random-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 9] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 9] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [3, 3, 9] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [0, 0, 8], "block": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [1, 0, 8], "block": {"id": "minecraft:water"                  } }  
            ]
        }, 
        {
            "at": 150, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"                   } }, 
                { "pos": [0, 0, 8], "is": {"id": "minecraft:farmland", "moisture": 7} }  
            ]
        }
    ], 
    "breakpoints": []
}

