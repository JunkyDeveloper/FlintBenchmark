{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_drops_dirt_when_destroyed", 
    "description": "Farmland destroyed by a TNT explosion drops exactly one dirt item and no farmland item, because its loot table drops dirt instead of itself.", 
    "tags": ["vegetation", "farmland", "drops", "explosion", "loot"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:obsidian", "minecraft:tnt", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7}                  }, 
                {                   "is": "minecraft:item"                           , "exists": false }  
            ]
        }, 
        {
            "at": 5, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [1.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }                                   , 
                {"is": "minecraft:item", "exists": true, "count": 1}                                  , 
                {"is": "minecraft:item", "exists": true, "Item.id": "minecraft:dirt", "Item.count": 1}  
            ]
        }
    ], 
    "breakpoints": []
}

