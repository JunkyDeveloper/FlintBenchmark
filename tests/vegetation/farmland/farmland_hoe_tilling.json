{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_hoe_tilling", 
    "description": "A hoe turns dirt, grass blocks and dirt paths with air above into farmland at moisture 0, but does nothing to dirt that has a solid block directly above it.", 
    "tags": ["vegetation", "farmland", "hoe", "tilling", "player"], 
    "minecraftIds": [
        "minecraft:farmland"   , "minecraft:dirt"       , "minecraft:grass_block", "minecraft:dirt_path"  , 
        "minecraft:stone"      , "minecraft:iron_hoe"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [10, 4, 1] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [10, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [10, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:dirt_path"  } }, 
                { "pos": [7, 1, 0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [7, 2, 0], "block": {"id": "minecraft:stone"      } }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:iron_hoe"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 6, "do": "interact", "item": "minecraft:iron_hoe"}, 
        { "at": 7, "do": "tp", "entity_alias": "player", "pos": [4.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 7, "do": "interact", "item": "minecraft:iron_hoe"}, 
        { "at": 8, "do": "tp", "entity_alias": "player", "pos": [9.5, 1, 0.5], "rot": [90, 37] }, 
        {"at": 8, "do": "interact", "item": "minecraft:iron_hoe"}, 
        { "at": 9, "do": "tp", "entity_alias": "player", "pos": [9.5, 5, 0.5] }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [7, 1, 0], "is": {"id": "minecraft:dirt"                   } }, 
                { "pos": [7, 2, 0], "is": {"id": "minecraft:stone"                  } }  
            ]
        }
    ], 
    "breakpoints": []
}

