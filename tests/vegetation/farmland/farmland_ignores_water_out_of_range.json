{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_ignores_water_out_of_range", 
    "description": "Farmland dries out and turns to dirt when its only water is five blocks away sideways or directly below it, because only water within four blocks sideways and one block up counts.", 
    "tags": ["vegetation", "farmland", "moisture", "water", "random-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 4, 9] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [6, 1, 9] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 2, -1], [6, 4, 9] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:water"                  } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [5, 1, 8], "block": {"id": "minecraft:water"                  } }, 
                { "pos": [0, 1, 8], "block": {"id": "minecraft:farmland", "moisture": 7} }  
            ]
        }, 
        {
            "at": 150, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dirt"} }, 
                { "pos": [0, 1, 8], "is": {"id": "minecraft:dirt"} }  
            ]
        }
    ], 
    "breakpoints": []
}

