{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_item_placement", 
    "description": "The farmland item places farmland at moisture 0 when the space above is free, but places plain dirt instead when a solid block sits directly above the target position.", 
    "tags": ["vegetation", "farmland", "placement", "player"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [7, 4, 1] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [7, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [7, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [3, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 4, "do": "place", "pos": [4, 2, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:farmland"}, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:air"                    } }  
            ]
        }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [6.5, 1, 0.5], "rot": [90, 24] }, 
        {"at": 6, "do": "interact", "item": "minecraft:farmland"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [6.5, 5, 0.5] }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:dirt"                   } }, 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:stone"                  } }  
            ]
        }
    ], 
    "breakpoints": []
}

