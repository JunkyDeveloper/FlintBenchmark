{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_stays_dry_under_fence_gate", 
    "description": "Dry farmland under a closed fence gate, which is solid but in the maintains-farmland tag, stays farmland through random ticks and survives the placement, while bare dry farmland beside it turns to dirt.", 
    "tags": ["vegetation", "farmland", "fence-gate", "support", "random-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:oak_fence_gate", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 0}                          }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_fence_gate", "open": false, "facing": "north"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 0}                          }  
            ]
        }, 
        {
            "at": 150, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 0}                          }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_fence_gate", "open": false, "facing": "north"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:dirt"}                                             }  
            ]
        }
    ], 
    "breakpoints": []
}

