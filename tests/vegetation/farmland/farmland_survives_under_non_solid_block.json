{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_survives_under_non_solid_block", 
    "description": "Placing a block that does not count as solid, such as short grass or a carpet, on top of farmland leaves the farmland unchanged.", 
    "tags": ["vegetation", "farmland", "support", "neighbor-update", "scheduled-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:short_grass", "minecraft:white_carpet", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 5} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 5} }  
            ]
        }, 
        { "at": 6, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:short_grass"} }, 
        { "at": 6, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:white_carpet"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland"    , "moisture": 5} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:short_grass"                } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:farmland"    , "moisture": 5} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:white_carpet"               } }  
            ]
        }
    ], 
    "breakpoints": []
}

