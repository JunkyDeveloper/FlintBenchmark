{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_turns_to_dirt_under_solid_block", 
    "description": "Placing a solid block, including a bottom slab whose collision box still counts as solid, on top of farmland turns the farmland to dirt after the scheduled tick, while farmland with nothing above stays.", 
    "tags": ["vegetation", "farmland", "support", "neighbor-update", "scheduled-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:stone", "minecraft:oak_slab"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [5, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7} }  
            ]
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7} }  
            ]
        }, 
        { "at": 6, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 6, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:oak_slab", "type": "bottom"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"                                     } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"                                    } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:dirt"                                     } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:oak_slab", "type": "bottom"               } }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:farmland",                   "moisture": 7} }  
            ]
        }
    ], 
    "breakpoints": []
}

