{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_turns_to_dirt_when_piston_pushes_block_onto_it", 
    "description": "A piston pushing a stone block down onto farmland turns the farmland to dirt once the push finishes, while farmland nearby with nothing pushed onto it is unchanged.", 
    "tags": ["vegetation", "farmland", "piston", "support", "neighbor-update"], 
    "minecraftIds": [
        "minecraft:farmland"      , "minecraft:dirt"          , "minecraft:stone"         , "minecraft:piston"        , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [4, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7}                       }, 
                { "pos": [3, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 7}                       }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:stone"}                                         }, 
                { "pos": [0, 3, 0], "block": {"id": "minecraft:piston", "facing": "down", "extended": "false"} }  
            ]
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                    } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:stone"                  } }  
            ]
        }, 
        { "at": 6, "do": "place", "pos": [1, 3, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 16, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 3, 0], "is": {"id": "minecraft:piston", "extended": "true"}    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:piston_head", "facing": "down"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"}                         }, 
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"}                          }, 
                { "pos": [3, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7}       }  
            ]
        }
    ], 
    "breakpoints": []
}

