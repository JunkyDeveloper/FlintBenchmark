{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_wets_from_nearby_water", 
    "description": "A random tick sets dry farmland straight to moisture 7 when water is exactly four blocks away sideways, both in a straight line and diagonally.", 
    "tags": ["vegetation", "farmland", "moisture", "water", "random-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 3, 11] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 0, 11] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [5, 3, 11] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0,  0], "block": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 0,  0], "block": {"id": "minecraft:water"                  } }, 
                { "pos": [0, 0,  6], "block": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 0, 10], "block": {"id": "minecraft:water"                  } }  
            ]
        }, 
        {
            "at": 60, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [0, 0, 6], "is": {"id": "minecraft:farmland", "moisture": 7} }  
            ]
        }
    ], 
    "breakpoints": []
}

