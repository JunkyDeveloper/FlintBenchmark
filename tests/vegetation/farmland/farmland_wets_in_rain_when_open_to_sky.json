{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "farmland_wets_in_rain_when_open_to_sky", 
    "description": "During rain, dry farmland open to the sky is soaked to moisture 7 without any water nearby, while farmland covered by a roof gets no rain and dries out to dirt.", 
    "tags": ["vegetation", "farmland", "moisture", "rain", "weather", "random-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 4, 1] ]
        }, 
        "world": {
            "weather": "rain", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [5, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 80, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:farmland", "moisture": 0} }, 
                { "pos": [4, 3, 0], "block": {"id": "minecraft:stone"                  } }  
            ]
        }, 
        {
            "at": 130, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland", "moisture": 7} }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:dirt"                   } }  
            ]
        }
    ], 
    "breakpoints": []
}

