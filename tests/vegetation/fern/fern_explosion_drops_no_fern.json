{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "fern_explosion_drops_no_fern", 
    "description": "An explosion next to a fern destroys it, but without shears the loot table never drops the fern item itself.", 
    "tags": ["vegetation", "fern", "explosion", "loot"], 
    "minecraftIds": ["minecraft:fern", "minecraft:grass_block", "minecraft:obsidian", "minecraft:tnt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 4, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [6, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [5, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
        { "at": 0, "do": "place", "pos": [5, 1, 0], "block": {"id": "minecraft:fern"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [5, 1, 0], "is": {"id": "minecraft:fern"} }
            ]
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [6.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [5, 1, 0], "is": {"id": "minecraft:air"}                                               }, 
                {                   "is": "minecraft:item"       , "exists": false, "Item.id": "minecraft:fern" }  
            ]
        }
    ], 
    "breakpoints": []
}

