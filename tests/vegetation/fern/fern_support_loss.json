{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "fern_support_loss", 
    "description": "A fern breaks into air when the dirt beneath it is removed, while a fern whose dirt stays in place is unaffected.", 
    "tags": ["vegetation", "fern", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:fern", "minecraft:dirt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:dirt"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:fern"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:fern"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:fern"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:fern"} }  
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air" } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air" } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:dirt"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:fern"} }  
            ]
        }
    ], 
    "breakpoints": []
}

