{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "firefly_bush_composts_in_empty_composter", 
    "description": "A firefly bush used on an empty composter always raises it to level 1 and is consumed, instead of being placed.", 
    "tags": ["vegetation", "firefly-bush", "composter", "compostable", "player"], 
    "minecraftIds": ["minecraft:firefly_bush", "minecraft:composter", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [7, 4, 3] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:firefly_bush", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [7, 4, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [4, 1, 1], [4, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [4, 1, 1], "block": {"id": "minecraft:composter", "level": "0"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [4.5, 2, 1.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [4.5, 9, 1.5] }, 
        {
            "at": 15, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 1, 1], "is": {"id": "minecraft:composter", "level": "1"}                    }, 
                { "pos": [4, 2, 1], "is": {"id": "minecraft:air"}                                        }, 
                {                   "is": "empty"                                    , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

