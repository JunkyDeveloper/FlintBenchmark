{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "firefly_bush_destroyed_by_piston", 
    "description": "A piston extending into a firefly bush destroys it instead of pushing it, the piston head takes its place, and one firefly bush item drops.", 
    "tags": ["vegetation", "firefly-bush", "piston", "push-reaction", "drops"], 
    "minecraftIds": [
        "minecraft:firefly_bush"  , "minecraft:dirt"          , "minecraft:piston"        , "minecraft:redstone_block", 
        "minecraft:piston_head"   , "minecraft:item"          
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [14, 3, 3] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [14, 3, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [10, 1, 1], [13, 2, 2] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [12, 0, 1], "block": {"id": "minecraft:dirt"}                                          }, 
                { "pos": [12, 1, 1], "block": {"id": "minecraft:firefly_bush"}                                  }, 
                { "pos": [11, 1, 1], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [12, 1, 1], "is": {"id": "minecraft:firefly_bush"                     } }, 
                { "pos": [11, 1, 1], "is": {"id": "minecraft:piston"      , "extended": "false"} }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [11.5, 9, 2.5] }, 
        { "at": 5, "do": "place", "pos": [11, 1, 2], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 15, 
            "do": "assert", 
            "checks": [
                { "pos": [11, 1, 1], "is": {"id": "minecraft:piston", "extended": "true"} }                   , 
                { "pos": [12, 1, 1], "is": {"id": "minecraft:piston_head", "facing": "east"} }                , 
                { "pos": [13, 1, 1], "is": {"id": "minecraft:air"} }                                          , 
                {"is": "minecraft:item", "exists": true, "Item": "{count: 1, id: \"minecraft:firefly_bush\"}"}  
            ]
        }
    ], 
    "breakpoints": []
}

