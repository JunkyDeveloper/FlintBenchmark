{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "firefly_bush_support_loss", 
    "description": "A firefly bush on grass block or farmland becomes air once the block beneath it is removed.", 
    "tags": ["vegetation", "firefly-bush", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:firefly_bush", "minecraft:grass_block", "minecraft:farmland"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [14, 2, 2] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [14, 2, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [12, 1, 1], [13, 1, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [12, 0, 1], "block": {"id": "minecraft:grass_block" } }, 
                { "pos": [13, 0, 1], "block": {"id": "minecraft:farmland"    } }, 
                { "pos": [12, 1, 1], "block": {"id": "minecraft:firefly_bush"} }, 
                { "pos": [13, 1, 1], "block": {"id": "minecraft:firefly_bush"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [12, 1, 1], "is": {"id": "minecraft:firefly_bush"} }, 
                { "pos": [13, 1, 1], "is": {"id": "minecraft:firefly_bush"} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [12, 0, 1] }, 
        { "at": 5, "do": "remove", "pos": [13, 0, 1] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [12, 0, 1], "is": {"id": "minecraft:air"} }, 
                { "pos": [12, 1, 1], "is": {"id": "minecraft:air"} }, 
                { "pos": [13, 0, 1], "is": {"id": "minecraft:air"} }, 
                { "pos": [13, 1, 1], "is": {"id": "minecraft:air"} }  
            ]
        }
    ], 
    "breakpoints": []
}

