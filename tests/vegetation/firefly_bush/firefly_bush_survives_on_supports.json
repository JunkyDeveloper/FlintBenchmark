    "flintVersion": "1.0.0", 
    "name": "firefly_bush_survives_on_supports", 
    "description": "A firefly bush above grass block, dirt, podzol, mud, moss block or farmland stays when a neighbour update reaches it, but turns to air above sand.", 
    "tags": ["vegetation", "firefly-bush", "support", "supports-vegetation", "neighbor-update"], 
