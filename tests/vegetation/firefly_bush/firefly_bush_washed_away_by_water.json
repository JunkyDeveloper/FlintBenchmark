{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "firefly_bush_washed_away_by_water", 
    "description": "Water spreading from an adjacent source into a firefly bush replaces it with flowing water and drops one firefly bush item.", 
    "tags": ["vegetation", "firefly-bush", "water", "fluid", "drops"], 
    "minecraftIds": [
        "minecraft:firefly_bush", "minecraft:dirt"        , "minecraft:stone"       , "minecraft:water"       , 
        "minecraft:item"        
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [14, 3, 4] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [14, 3, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [10, 1, 2], [11, 1, 2] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [11, 0, 2], "block": {"id": "minecraft:dirt"} }, 
        { "at": 4, "do": "place", "pos": [11, 1, 2], "block": {"id": "minecraft:firefly_bush"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [11.5, 9, 2.5] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [11, 1, 2], "is": {"id": "minecraft:firefly_bush"} }
            ]
        }, 
        { "at": 6, "do": "place", "pos": [10, 1, 2], "block": {"id": "minecraft:water"} }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                { "pos": [10, 1, 2], "is": {"id": "minecraft:water"} }                                        , 
                { "pos": [11, 1, 2], "is": {"id": "minecraft:water"} }                                        , 
                {"is": "minecraft:item", "exists": true, "Item": "{count: 1, id: \"minecraft:firefly_bush\"}"}  
            ]
        }
    ], 
    "breakpoints": []
}

