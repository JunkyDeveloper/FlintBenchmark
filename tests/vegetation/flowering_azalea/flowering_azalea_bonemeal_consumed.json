                { "pos": [0, 1, 0], "block": {"id": "minecraft:flowering_azalea"} }  
            ]
        }, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        {
