{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "flowering_azalea_has_collision", 
    "description": "An item entity dropped from above comes to rest on top of a flowering azalea at y+1, which shows that the block has a full-width collision shape up to the top of the block.", 
