{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "flowering_azalea_not_replaced_by_block_placement", 
    "description": "Because a flowering azalea is not replaceable, placing a stone block against its top face puts the stone on top of it and leaves the azalea in place.", 
    "tags": ["vegetation", "flowering-azalea", "replaceable", "placement", "player"], 
    "minecraftIds": ["minecraft:flowering_azalea", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:stone", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [3, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"} }, 
        { "at": 4, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:flowering_azalea"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [2.5, 1, 0.5], "rot": [90, 17] }, 
        {"at": 6, "do": "interact"}, 
        { "at": 7, "do": "tp", "entity_alias": "player", "pos": [2.5, 6, 0.5] }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"}                                }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:flowering_azalea"}                    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:stone"}                               }, 
                {                   "is": "empty"                             , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

