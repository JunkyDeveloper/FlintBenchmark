{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "glow_lichen_destroyed_by_piston", 
    "description": "An extending piston destroys a glow lichen in front of it instead of pushing it, leaving only the piston head with nothing behind it.", 
    "tags": ["vegetation", "glow-lichen", "piston", "push-reaction", "redstone"], 
    "minecraftIds": [
        "minecraft:glow_lichen"   , "minecraft:piston"        , "minecraft:piston_head"   , "minecraft:redstone_block", 
        "minecraft:stone"         
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 3, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 0, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:piston", "facing": "east", "extended": false}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:glow_lichen", "down": true} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "extended": false              } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:glow_lichen",                    "down": true} }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "extended": true, "facing": "east"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head",                   "facing": "east"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                                            } }  
            ]
        }
    ], 
    "breakpoints": []
}

