{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "glow_lichen_face_removed_with_support", 
    "description": "A glow lichen with up and north faces loses only the north face when the north wall is removed, and becomes air when the ceiling is removed too.", 
    "tags": ["vegetation", "glow-lichen", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:glow_lichen", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 0, 0], [0, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place", 
            "pos": [0, 2, 0], 
            "block": {"id": "minecraft:glow_lichen", "up": true, "north": true}
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:glow_lichen", "up": true, "north": true} }
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 2, -1] }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:glow_lichen", 
                        "up": true, 
                        "north": false, 
                        "south": false, 
                        "east": false, 
                        "west": false, 
                        "down": false
                    }
                }
            ]
        }, 
        { "at": 7, "do": "remove", "pos": [0, 3, 0] }, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"} }
            ]
        }
    ], 
    "breakpoints": []
}

