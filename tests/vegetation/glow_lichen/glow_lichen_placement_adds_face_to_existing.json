{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "glow_lichen_placement_adds_face_to_existing", 
    "description": "Using glow lichen on the ceiling of a block that already has a north lichen face adds the up face to the same block and keeps the north face, consuming one item.", 
