                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:glow_lichen", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
