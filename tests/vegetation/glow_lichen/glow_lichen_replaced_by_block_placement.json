{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "glow_lichen_replaced_by_block_placement", 
    "description": "Using a stone block on a floor glow lichen replaces the lichen, because glow lichen is replaceable by a block other than lichen, and consumes one item.", 
    "tags": ["vegetation", "glow-lichen", "replaceable", "placement", "player"], 
    "minecraftIds": ["minecraft:glow_lichen", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:stone", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:glow_lichen", "down": true} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"            }                    }, 
                {                   "is": {"id": "minecraft:stone", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

