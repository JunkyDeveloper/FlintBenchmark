{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "glow_lichen_support_loss_to_slab", 
    "description": "A glow lichen on a stone floor becomes air when the stone is replaced by a bottom slab, but survives under a bottom slab whose underside is a full face.", 
    "tags": ["vegetation", "glow-lichen", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:glow_lichen", "minecraft:stone", "minecraft:stone_slab"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:glow_lichen", "down": true            } }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:glow_lichen",               "up": true} }  
            ]
        }, 
        { "at": 5, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone_slab", "type": "bottom"} }, 
        { "at": 5, "do": "place", "pos": [2, 3, 0], "block": {"id": "minecraft:stone_slab", "type": "bottom"} }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                    } }, 
                { "pos": [2, 2, 0], "is": {"id": "minecraft:glow_lichen", "up": true} }  
            ]
        }
    ], 
    "breakpoints": []
}

