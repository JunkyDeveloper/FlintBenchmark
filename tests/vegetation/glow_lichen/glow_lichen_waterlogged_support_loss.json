{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "glow_lichen_waterlogged_support_loss", 
    "description": "A waterlogged glow lichen with a single face is replaced by a water source, not air, when the block it is attached to is removed (Block.updateOrDestroy destroys it and Level.destroyBlock leaves the fluid).", 
    "tags": ["vegetation", "glow-lichen", "waterlogged", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:glow_lichen", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:glow_lichen", "down": true, "waterlogged": true}
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:glow_lichen", "down": true, "waterlogged": true} }
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 0} }
            ]
        }
    ], 
    "breakpoints": []
}

