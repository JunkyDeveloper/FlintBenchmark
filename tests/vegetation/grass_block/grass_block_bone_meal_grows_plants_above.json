{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_bone_meal_grows_plants_above", 
    "description": "Bone meal on the top face of a grass block with air above is consumed and puts a plant on the block above: short grass, tall grass or a flower from the plains flower list (the test world is assumed to be a plains-like biome; the first of the 16 attempts that start above the block places short grass with probability 7/8 and the rest tries flowers, so the cell cannot realistically stay air). The grass block is kept; the block above that is air or the upper half of tall grass.", 
    "tags": ["vegetation", "grass-block", "bone-meal", "player"], 
    "minecraftIds": [
        "minecraft:grass_block" , "minecraft:bone_meal"   , "minecraft:short_grass" , "minecraft:tall_grass"  , 
        "minecraft:dandelion"   , "minecraft:orange_tulip", "minecraft:red_tulip"   , "minecraft:pink_tulip"  , 
        "minecraft:white_tulip" , "minecraft:poppy"       , "minecraft:azure_bluet" , "minecraft:oxeye_daisy" , 
        "minecraft:cornflower"  
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:bone_meal", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 7, "do": "interact"}, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:short_grass"                  }, 
                        {"id": "minecraft:tall_grass"  , "half": "lower"}, 
                        {"id": "minecraft:dandelion"                    }, 
                        {"id": "minecraft:orange_tulip"                 }, 
                        {"id": "minecraft:red_tulip"                    }, 
                        {"id": "minecraft:pink_tulip"                   }, 
                        {"id": "minecraft:white_tulip"                  }, 
                        {"id": "minecraft:poppy"                        }, 
                        {"id": "minecraft:azure_bluet"                  }, 
                        {"id": "minecraft:oxeye_daisy"                  }, 
                        {"id": "minecraft:cornflower"                   }  
                    ]
                }, 
                {
                    "pos": [ 0                      , 2                                              , 0 ], 
                    "is" : [ {"id": "minecraft:air"}, {"id": "minecraft:tall_grass", "half": "upper"}    ]  
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

