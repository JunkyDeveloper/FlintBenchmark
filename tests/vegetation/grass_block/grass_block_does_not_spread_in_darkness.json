{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_does_not_spread_in_darkness", 
    "description": "In a sealed, unlit stone box a grass block with air above survives but never spreads onto adjacent dirt, because the light level above it stays below 9 (the same layout with a glowstone is grass_block_spreads_to_dirt_in_range). Nothing happens with a high random tick speed over 200 ticks.", 
    "tags": ["vegetation", "grass-block", "random-tick", "spread", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:grass_block", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -3], [4, 9, 3] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-4, 0, -3], [4, 9, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-3, 1, -2], [3, 8, 2] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 5,  0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [ 1, 5,  0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [-1, 5,  0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [ 0, 5,  1], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [ 0, 4, -1], "block": {"id": "minecraft:dirt"       } }  
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 5, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 5,  0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [ 1, 5,  0], "is": {"id": "minecraft:dirt"                         } }, 
                { "pos": [-1, 5,  0], "is": {"id": "minecraft:dirt"                         } }, 
                { "pos": [ 0, 5,  1], "is": {"id": "minecraft:dirt"                         } }, 
                { "pos": [ 0, 4, -1], "is": {"id": "minecraft:dirt"                         } }  
            ]
        }
    ], 
    "breakpoints": []
}

