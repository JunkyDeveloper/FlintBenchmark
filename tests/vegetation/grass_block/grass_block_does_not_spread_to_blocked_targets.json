{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_does_not_spread_to_blocked_targets", 
    "description": "With a high random tick speed and light from a glowstone, a grass block spreads onto a plain dirt control but not onto coarse dirt, dirt under stone, dirt under a snow block or dirt under a water source, all of which are in range. The water source is enclosed by glass. The control stays dirt for 196 ticks with a probability of roughly 1e-5.", 
    "tags": ["vegetation", "grass-block", "random-tick", "spread", "modifies-gamerule"], 
    "minecraftIds": [
        "minecraft:grass_block", "minecraft:dirt"       , "minecraft:stone"      , "minecraft:glowstone"  , 
        "minecraft:coarse_dirt", "minecraft:snow_block" , "minecraft:water"      , "minecraft:glass"      
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -3], [4, 9, 3] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-4, 0, -3], [4, 9, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-3, 1, -2], [3, 8, 2] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 5,  0], "block": {"id": "minecraft:grass_block"            } }, 
                { "pos": [ 0, 5, -1], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [ 1, 5,  0], "block": {"id": "minecraft:coarse_dirt"            } }, 
                { "pos": [-1, 5,  0], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [-1, 6,  0], "block": {"id": "minecraft:stone"                  } }, 
                { "pos": [-1, 5,  1], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [-1, 6,  1], "block": {"id": "minecraft:snow_block"             } }, 
                { "pos": [ 1, 5,  1], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [ 1, 6,  1], "block": {"id": "minecraft:water"      , "level": 0} }, 
                { "pos": [ 0, 6,  1], "block": {"id": "minecraft:glass"                  } }, 
                { "pos": [ 2, 6,  1], "block": {"id": "minecraft:glass"                  } }, 
                { "pos": [ 1, 6,  0], "block": {"id": "minecraft:glass"                  } }, 
                { "pos": [ 1, 6,  2], "block": {"id": "minecraft:glass"                  } }, 
                { "pos": [ 1, 7,  1], "block": {"id": "minecraft:glass"                  } }, 
                { "pos": [ 0, 9,  0], "block": {"id": "minecraft:glowstone"              } }  
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 5, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 5, -1], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [ 1, 5,  0], "is": {"id": "minecraft:coarse_dirt"                  } }, 
                { "pos": [-1, 5,  0], "is": {"id": "minecraft:dirt"                         } }, 
                { "pos": [-1, 5,  1], "is": {"id": "minecraft:dirt"                         } }, 
                { "pos": [ 1, 5,  1], "is": {"id": "minecraft:dirt"                         } }  
            ]
        }
    ], 
    "breakpoints": []
}

