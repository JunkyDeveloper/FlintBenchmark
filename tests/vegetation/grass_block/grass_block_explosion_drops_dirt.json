{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_explosion_drops_dirt", 
    "description": "A grass block destroyed by a TNT explosion drops exactly one item entity, a single dirt (without Silk Touch its loot table gives dirt, not the grass block). The floor is obsidian so that nothing else drops, and the player is moved away so it cannot pick the item up.", 
    "tags": ["vegetation", "grass-block", "drops", "explosion", "tnt"], 
    "minecraftIds": [
        "minecraft:grass_block", "minecraft:tnt"        , "minecraft:obsidian"   , "minecraft:dirt"       , 
        "minecraft:item"       
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [4, 3, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:grass_block", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [4, 0, 2] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:grass_block"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 12, 0.5], "rot": [0, 0] }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [3.5, 1, 1.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"} }                                               , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:dirt", "Item.count": 1}  
            ]
        }
    ], 
    "breakpoints": []
}

