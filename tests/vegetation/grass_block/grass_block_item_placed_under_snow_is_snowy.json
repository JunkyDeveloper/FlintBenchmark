{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_item_placed_under_snow_is_snowy", 
    "description": "A player placing a grass block item into a space with a snow block directly above gets a grass block with snowy=true, and the item is consumed.", 
    "tags": ["vegetation", "grass-block", "snowy", "placement", "player"], 
    "minecraftIds": ["minecraft:grass_block", "minecraft:snow_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, -2, -1], [1, 1, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:grass_block", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [-2, -2, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [1, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:snow_block"} }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [-1.5, -1, 0.5], "rot": [-90, 0] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "true"}                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:snow_block"}                                      }, 
                {                   "is": "empty"                                         , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

