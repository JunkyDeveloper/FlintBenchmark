{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_shovel_top_face", 
    "description": "Using an iron shovel on the top face of a grass block with air above flattens it into a dirt path and keeps the shovel in the hotbar.", 
    "tags": ["vegetation", "grass-block", "shovel", "interaction", "player"], 
    "minecraftIds": ["minecraft:grass_block", "minecraft:iron_shovel", "minecraft:dirt_path"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_shovel", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt_path"              }                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                    }                    }, 
                {                   "is": {"id": "minecraft:iron_shovel", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

