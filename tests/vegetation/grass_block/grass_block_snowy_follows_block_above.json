{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_snowy_follows_block_above", 
    "description": "A grass block gets snowy=true when a snow layer, snow block or powder snow is placed directly above it, keeps snowy=false under stone or glass, and returns to snowy=false when the snow block above is removed again.", 
    "tags": ["vegetation", "grass-block", "snowy", "neighbor-update"], 
    "minecraftIds": [
        "minecraft:grass_block", "minecraft:snow"       , "minecraft:snow_block" , "minecraft:powder_snow", 
        "minecraft:stone"      , "minecraft:glass"      
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [8, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [6, 0, 0], "block": {"id": "minecraft:grass_block"} }, 
                { "pos": [8, 0, 0], "block": {"id": "minecraft:grass_block"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [8, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:snow"       } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:snow_block" } }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:powder_snow"} }, 
                { "pos": [6, 1, 0], "block": {"id": "minecraft:stone"      } }, 
                { "pos": [8, 1, 0], "block": {"id": "minecraft:glass"      } }  
            ]
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "true" } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "true" } }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "true" } }, 
                { "pos": [6, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [8, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }  
            ]
        }, 
        { "at": 4, "do": "remove", "pos": [0, 1, 0] }, 
        { "at": 4, "do": "remove", "pos": [2, 1, 0] }, 
        { "at": 4, "do": "remove", "pos": [4, 1, 0] }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [6, 0, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }  
            ]
        }
    ], 
    "breakpoints": []
}

