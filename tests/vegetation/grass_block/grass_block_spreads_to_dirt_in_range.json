{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_spreads_to_dirt_in_range", 
    "description": "With a high random tick speed and light from a glowstone, a grass block with air above spreads onto dirt that lies within one block horizontally and from three blocks below to one block above, including dirt under a single snow layer, which becomes grass with snowy=true. Everything sits in a sealed stone box. Each target is picked by a given random tick attempt with probability about 1/45, so a target stays dirt for 196 ticks with a probability of roughly 1e-5.", 
    "tags": ["vegetation", "grass-block", "random-tick", "spread", "modifies-gamerule"], 
    "minecraftIds": [
        "minecraft:grass_block", "minecraft:dirt"       , "minecraft:stone"      , "minecraft:glowstone"  , 
        "minecraft:snow"       
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -3], [4, 9, 3] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-4, 0, -3], [4, 9, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-3, 1, -2], [3, 8, 2] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 5,  0], "block": {"id": "minecraft:grass_block"             } }, 
                { "pos": [ 1, 6,  1], "block": {"id": "minecraft:dirt"                    } }, 
                { "pos": [-1, 2, -1], "block": {"id": "minecraft:dirt"                    } }, 
                { "pos": [ 1, 5, -1], "block": {"id": "minecraft:dirt"                    } }, 
                { "pos": [ 0, 3,  1], "block": {"id": "minecraft:dirt"                    } }, 
                { "pos": [-1, 5,  1], "block": {"id": "minecraft:dirt"                    } }, 
                { "pos": [-1, 6,  1], "block": {"id": "minecraft:snow"       , "layers": 1} }, 
                { "pos": [ 0, 9,  0], "block": {"id": "minecraft:glowstone"               } }  
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 5, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [ 1, 6,  1], "is": {"id": "minecraft:grass_block", "snowy": "false"             } }, 
                { "pos": [-1, 2, -1], "is": {"id": "minecraft:grass_block", "snowy": "false"             } }, 
                { "pos": [ 1, 5, -1], "is": {"id": "minecraft:grass_block", "snowy": "false"             } }, 
                { "pos": [ 0, 3,  1], "is": {"id": "minecraft:grass_block", "snowy": "false"             } }, 
                { "pos": [-1, 5,  1], "is": {"id": "minecraft:grass_block", "snowy": "true"              } }, 
                { "pos": [-1, 6,  1], "is": {"id": "minecraft:snow"       ,                   "layers": 1} }  
            ]
        }
    ], 
    "breakpoints": []
}

