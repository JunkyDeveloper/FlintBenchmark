{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_survives_under_light_passing_block", 
    "description": "With a high random tick speed a grass block stays grass under air, glass, a top slab or a single snow layer (which becomes snowy=true), while a grass block under stone turns into dirt in the same time as a control. The sites are walled in by stone and two blocks apart. Failing to turn the control into dirt in 38 ticks has a probability of roughly 1e-16.", 
    "tags": ["vegetation", "grass-block", "random-tick", "light", "modifies-gamerule"], 
    "minecraftIds": [
        "minecraft:grass_block", "minecraft:dirt"       , "minecraft:stone"      , "minecraft:glass"      , 
        "minecraft:stone_slab" , "minecraft:snow"       
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [9, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [9, 3, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:grass_block"                            } }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:air"                                    } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:grass_block"                            } }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:glass"                                  } }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:grass_block"                            } }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:stone_slab" , "type": "top"             } }, 
                { "pos": [6, 1, 0], "block": {"id": "minecraft:grass_block"                            } }, 
                { "pos": [6, 2, 0], "block": {"id": "minecraft:snow"       ,                "layers": 1} }, 
                { "pos": [8, 1, 0], "block": {"id": "minecraft:grass_block"                            } }  
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:grass_block", "snowy": "false"} }, 
                { "pos": [6, 1, 0], "is": {"id": "minecraft:grass_block", "snowy": "true" } }, 
                { "pos": [8, 1, 0], "is": {"id": "minecraft:dirt"                         } }  
            ]
        }
    ], 
    "breakpoints": []
}

