{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "grass_block_unchanged_without_random_ticks", 
    "description": "With random tick speed 0 a grass block stays grass for 100 ticks even when it is covered by stone, a bottom slab, a water source, two snow layers or a snow block, which shows that grass only turns into dirt through random ticks (the same layout with a high random tick speed is grass_block_turns_to_dirt_under_covering_block).", 
    "tags": ["vegetation", "grass-block", "random-tick", "modifies-gamerule"], 
    "minecraftIds": [
        "minecraft:grass_block", "minecraft:dirt"       , "minecraft:stone"      , "minecraft:stone_slab" , 
        "minecraft:water"      , "minecraft:snow"       , "minecraft:snow_block" 
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [9, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [9, 3, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:grass_block"}                  }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:grass_block"}                  }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:grass_block"}                  }, 
                { "pos": [6, 1, 0], "block": {"id": "minecraft:grass_block"}                  }, 
                { "pos": [8, 1, 0], "block": {"id": "minecraft:grass_block"}                  }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:stone_slab", "type": "bottom"} }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:water", "level": 0}            }, 
                { "pos": [6, 2, 0], "block": {"id": "minecraft:snow", "layers": 2}            }, 
                { "pos": [8, 2, 0], "block": {"id": "minecraft:snow_block"}                   }  
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:grass_block"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:grass_block"} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:grass_block"} }, 
                { "pos": [6, 1, 0], "is": {"id": "minecraft:grass_block"} }, 
                { "pos": [8, 1, 0], "is": {"id": "minecraft:grass_block"} }  
            ]
        }
    ], 
    "breakpoints": []
}

