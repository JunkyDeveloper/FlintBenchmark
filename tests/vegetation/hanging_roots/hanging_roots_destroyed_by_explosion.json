{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "hanging_roots_destroyed_by_explosion", 
    "description": "An explosion next to hanging roots destroys them and, with no shears involved, leaves no item behind.", 
    "tags": ["vegetation", "hanging-roots", "explosion", "drops"], 
    "minecraftIds": ["minecraft:hanging_roots", "minecraft:obsidian", "minecraft:tnt"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [1, 1, 0], [1, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:hanging_roots"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:hanging_roots"} }
            ]
        }, 
        {
            "at": 4, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [1.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"}                       }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:obsidian"}                  }, 
                {                   "is": "minecraft:item"            , "exists": false }  
            ]
        }
    ], 
    "breakpoints": []
}

