{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "hanging_roots_destroyed_by_piston", 
    "description": "An extending piston destroys hanging roots in front of it instead of pushing them, so the air behind the piston head stays empty.", 
    "tags": ["vegetation", "hanging-roots", "piston", "push-reaction", "redstone"], 
    "minecraftIds": [
        "minecraft:hanging_roots" , "minecraft:piston"        , "minecraft:piston_head"   , "minecraft:redstone_block", 
        "minecraft:stone"         
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 3, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 3, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [2, 1, 0], [2, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 2, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:piston", "facing": "east", "extended": false}
        }, 
        { "at": 2, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:hanging_roots"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"       , "extended": false} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:hanging_roots"                   } }  
            ]
        }, 
        { "at": 4, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 14, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "extended": true, "facing": "east"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head",                   "facing": "east"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                                            } }  
            ]
        }
    ], 
    "breakpoints": []
}

