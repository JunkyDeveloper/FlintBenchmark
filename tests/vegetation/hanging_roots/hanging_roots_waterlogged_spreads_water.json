{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "hanging_roots_waterlogged_spreads_water", 
    "description": "Waterlogged hanging roots act as a water source: once a neighbor update schedules their fluid tick, water spreads into an adjacent air corridor while the roots stay.", 
    "tags": ["vegetation", "hanging-roots", "waterlogged", "fluid", "neighbor-update"], 
    "minecraftIds": ["minecraft:hanging_roots", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [1, 1, 0], [2, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:hanging_roots", "waterlogged": true} }, 
        { "at": 4, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:hanging_roots", "waterlogged": true} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water"                             } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:water"                             } }  
            ]
        }
    ], 
    "breakpoints": []
}

