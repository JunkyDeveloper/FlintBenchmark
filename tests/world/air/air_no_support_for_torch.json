{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "air_no_support_for_torch", 
    "description": "A torch on stone stays put, but breaks once the stone becomes air because air has an empty shape and gives no support.", 
