        { "at": 1, "do": "place", "pos": [1, 2, 1], "block": {"id": "minecraft:torch"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:stone"} }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:torch"} }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:air"} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:air"} }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:air"} }  
            ]
        }
    ], 
