{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_ore_pushed_by_piston", 
    "description": "An extending piston pushes copper ore one block forward instead of destroying it, and a copper ore beside the piston arm is left alone.", 
    "tags": ["copper_ore", "piston", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:copper_ore", "minecraft:piston", "minecraft:piston_head", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [3, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:piston"    , "facing": "east", "extended": "false"} }, 
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:copper_ore"                                       } }, 
                { "pos": [-1, 2, 1], "block": {"id": "minecraft:copper_ore"                                       } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:piston"    , "facing": "east", "extended": "false"} }, 
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:copper_ore"                                       } }, 
                { "pos": [ 1, 1, 0], "is": {"id": "minecraft:air"                                              } }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-2, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": "true"}    }, 
                { "pos": [0, 1, 0] , "is": {"id": "minecraft:piston_head", "facing": "east", "type": "normal"} }, 
                { "pos": [1, 1, 0] , "is": {"id": "minecraft:copper_ore"}                                      }, 
                { "pos": [-1, 2, 1], "is": {"id": "minecraft:copper_ore"}                                      }  
            ]
        }
    ], 
    "breakpoints": []
}

