{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_ore_survival_placement", 
    "description": "A survival player using a copper ore item on the top face of stone places a copper ore block above it and consumes the item.", 
    "tags": ["copper_ore", "placement", "player"], 
    "minecraftIds": ["minecraft:copper_ore"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:copper_ore", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"}                         }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:copper_ore"}                    }, 
                {                   "is": "empty"                       , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

