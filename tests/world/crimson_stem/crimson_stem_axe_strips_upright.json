{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "crimson_stem_axe_strips_upright", 
    "description": "A survival player using an axe on an upright crimson stem turns it into a stripped crimson stem with axis y and keeps the axe.", 
    "tags": ["crimson_stem", "pillar", "axe", "strip", "block-state", "player"], 
    "minecraftIds": [
        "minecraft:crimson_stem"         , "minecraft:stripped_crimson_stem", "minecraft:iron_axe"             , 
        "minecraft:stone"                
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_axe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:crimson_stem", "axis": "y"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stripped_crimson_stem", "axis": "y"}                    }, 
                {                   "is": {"id": "minecraft:iron_axe"                          }, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

