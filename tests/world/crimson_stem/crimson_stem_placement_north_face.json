{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "crimson_stem_placement_north_face", 
    "description": "A crimson stem placed against the north face of a block gets axis z and uses up the item.", 
    "tags": ["crimson_stem", "pillar", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:crimson_stem", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -3], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:crimson_stem", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -3], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2,  0], "is": {"id": "minecraft:stone"}                                        }, 
                { "pos": [0, 2, -1], "is": {"id": "minecraft:crimson_stem", "axis": "z"}                    }, 
                {                    "is": "empty"                                      , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

