{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "diamond_ore_ignores_pickaxe_interact", 
    "description": "A survival player using an iron pickaxe on a diamond ore block does not break it, drops nothing and keeps the pickaxe.", 
    "tags": ["world", "ore", "diamond-ore", "player", "drops"], 
    "minecraftIds": ["minecraft:diamond_ore", "minecraft:iron_pickaxe", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:iron_pickaxe", "count": 1} }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:diamond_ore"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:diamond_ore"} }              , 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }                      , 
                { "slot": "hotbar1", "is": {"id": "minecraft:iron_pickaxe", "count": 1} }, 
                {"is": "minecraft:item", "exists": false}                                  
            ]
        }
    ], 
    "breakpoints": []
}

