{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "diamond_ore_item_places_block", 
    "description": "A survival player using the diamond ore item on top of stone places a diamond ore block and consumes the item.", 
    "tags": ["world", "ore", "diamond-ore", "placement", "player"], 
    "minecraftIds": ["minecraft:diamond_ore", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:diamond_ore", "count": 1} }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:diamond_ore"}                    }, 
                {                   "is": "empty"                        , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

