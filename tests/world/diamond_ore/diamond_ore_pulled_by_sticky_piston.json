{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "diamond_ore_pulled_by_sticky_piston", 
    "description": "A sticky piston pushes a diamond ore block forward and pulls it back intact when it retracts.", 
    "tags": ["world", "ore", "diamond-ore", "piston", "sticky-piston", "push-reaction"], 
    "minecraftIds": ["minecraft:diamond_ore", "minecraft:sticky_piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 1, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:sticky_piston", "facing": "east"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:diamond_ore"                    } }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 0, 0], "is": {"id": "minecraft:piston_head"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:diamond_ore"} }  
            ]
        }, 
        { "at": 9, "do": "remove", "pos": [0, 1, 0] }, 
        {
            "at": 16, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:sticky_piston", "extended": false} }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:diamond_ore"                     } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:air"                             } }  
            ]
        }
    ], 
    "breakpoints": []
