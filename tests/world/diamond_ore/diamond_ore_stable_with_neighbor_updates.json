{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "diamond_ore_stable_with_neighbor_updates", 
    "description": "A placed diamond ore stays diamond ore after random ticks and after neighbouring blocks are placed and removed around it.", 
    "tags": ["world", "ore", "diamond-ore", "neighbor-update"], 
    "minecraftIds": ["minecraft:diamond_ore", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:diamond_ore"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:diamond_ore"} }
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 1, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 0, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 4, "do": "remove", "pos": [1, 1, 0] }, 
        { "at": 4, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:diamond_ore"} }
            ]
        }
    ], 
    "breakpoints": []
}

