{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "diamond_ore_tnt_explosion_drops_diamond", 
    "description": "A TNT explosion destroys an adjacent diamond ore block and it drops a diamond item, not a diamond ore item.", 
    "tags": ["world", "ore", "diamond-ore", "explosion", "drops"], 
    "minecraftIds": [
        "minecraft:diamond_ore", "minecraft:obsidian"   , "minecraft:tnt"        , "minecraft:item"       , 
        "minecraft:diamond"    
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [12, 3, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0, 
                "minecraft:tnt_explosion_drop_decay": false
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [10, 0, 0], [12, 0, 0] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [11, 1, 0], "block": {"id": "minecraft:diamond_ore"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 0.5] }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [11, 1, 0], "is": {"id": "minecraft:diamond_ore"} }
            ]
        }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [12.5, 1, 0.5], 
            "fuse": "1s"
        }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                { "pos": [11, 1, 0], "is": {"id": "minecraft:air"} }                    , 
                {"is": "minecraft:item", "exists": true, "count": 1}                    , 
                {"is": "minecraft:item", "exists": true, "Item.id": "minecraft:diamond"}  
            ]
        }
    ], 
    "breakpoints": []
}

