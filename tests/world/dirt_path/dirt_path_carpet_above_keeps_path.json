        { "at": 3, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:white_carpet"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dirt_path"   } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:white_carpet"} }  
