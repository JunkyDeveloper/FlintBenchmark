{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dirt_path_dirt_stays_after_support_removed", 
    "description": "After a path turned into dirt under a stone block, removing the stone does not bring the path back.", 
    "tags": ["world", "dirt_path", "neighbor-update"], 
    "minecraftIds": ["minecraft:dirt_path", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:dirt_path"} }, 
        { "at": 3, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dirt"} }
            ]
        }, 
        { "at": 9, "do": "remove", "pos": [0, 2, 0] }, 
        {
            "at": 14, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dirt"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air" } }  
            ]
        }
    ], 
    "breakpoints": []
}

