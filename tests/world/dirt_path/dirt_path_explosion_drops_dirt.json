{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dirt_path_explosion_drops_dirt", 
    "description": "A dirt path destroyed by a TNT explosion drops exactly one dirt item and no dirt path item.", 
    "tags": ["world", "dirt_path", "drops", "explosion"], 
    "minecraftIds": ["minecraft:dirt_path", "minecraft:dirt", "minecraft:tnt", "minecraft:obsidian", "minecraft:item"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 1, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:dirt_path"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [2.5, 12, 0.5] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [ {"is": "minecraft:item", "exists": false} ]
        }, 
        {
            "at": 3, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }                  , 
                {"is": "minecraft:item", "exists": true, "count": 1}                 , 
                {"is": "minecraft:item", "exists": true, "Item.id": "minecraft:dirt"}  
            ]
        }
    ], 
    "breakpoints": []
}

