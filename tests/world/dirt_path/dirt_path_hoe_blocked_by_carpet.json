{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dirt_path_hoe_blocked_by_carpet", 
    "description": "A hoe used on the side of a dirt path that has a carpet on top does nothing because the block above is not air.", 
    "tags": ["world", "dirt_path", "hoe", "player"], 
    "minecraftIds": ["minecraft:dirt_path", "minecraft:white_carpet", "minecraft:iron_hoe"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:iron_hoe", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:dirt_path"} }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:white_carpet"} }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 20] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dirt_path"   } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:white_carpet"} }  
            ]
        }
    ], 
    "breakpoints": []
