{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dirt_path_ignores_side_neighbor_changes", 
    "description": "Solid blocks placed beside a dirt path and the removal of the block below it do not turn the path into dirt, because only a change above is checked.", 
    "tags": ["world", "dirt_path", "neighbor-update"], 
    "minecraftIds": ["minecraft:dirt_path", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:dirt_path"} }, 
        { "at": 3, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 3, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 3, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:stone"} }, 
        { "at": 3, "do": "place", "pos": [0, 1, -1], "block": {"id": "minecraft:stone"} }, 
        { "at": 4, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dirt_path"} }, 
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"      } }  
            ]
        }
    ], 
    "breakpoints": []
}

