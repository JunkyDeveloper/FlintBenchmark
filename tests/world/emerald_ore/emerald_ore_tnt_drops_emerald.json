{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "emerald_ore_tnt_drops_emerald", 
    "description": "An emerald ore destroyed by a TNT explosion drops exactly one emerald item (never the ore block). The TNT is only a trigger for the ore's loot table; the floor is obsidian so it survives the blast.", 
    "tags": ["world", "emerald-ore", "drops", "explosion"], 
    "minecraftIds": [
        "minecraft:emerald_ore", "minecraft:obsidian"   , "minecraft:tnt"        , "minecraft:item"       , 
        "minecraft:emerald"    
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:emerald_ore"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [-1.5, 3, 0.5] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:emerald_ore"}                  }, 
                {                   "is": "minecraft:item"               , "exists": false }  
            ]
        }, 
        {
            "at": 3, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }, 
                {"is": "minecraft:item", "exists": true, "count": 1}, 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:emerald", "Item.count": "1"}
            ]
        }
    ], 
    "breakpoints": []
}

