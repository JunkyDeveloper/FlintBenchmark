{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fire Converts To Soul Fire When Floor Becomes Soul Sand", 
    "description": "Fire on stone, with an oak planks neighbour to keep it alive, turns into soul fire when the stone is replaced by soul sand, because FireBlock.updateShape rebuilds the state through BaseFireBlock.getState.", 
    "tags": ["fire", "soul_fire", "neighbour-update"], 
    "minecraftIds": [
        "minecraft:fire"      , "minecraft:soul_fire" , "minecraft:soul_sand" , "minecraft:oak_planks", 
        "minecraft:stone"     
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:fire_spread_radius_around_player": -1
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:oak_planks"} }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:fire", 
                "age": 0, 
                "north": false, 
                "east": false, 
                "south": false, 
                "west": false, 
                "up": false
            }
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:fire", 
                        "age": 0, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": false, 
                        "up": false
                    }
                }
            ]
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:soul_sand"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:soul_fire"} }
            ]
        }
    ], 
    "breakpoints": []
}

