{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fire Does Not Tick When Spread Radius Is Zero", 
    "description": "With fire_spread_radius_around_player set to 0 no player is close enough, so fire with age 4 on stone never runs its burn-out and is still there after 60 ticks.", 
    "tags": ["fire", "gamerule", "scheduled-tick", "modifies-gamerule"], 
    "minecraftIds": ["minecraft:fire", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:fire_spread_radius_around_player": 0
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:fire", 
                "age": 4, 
                "north": false, 
                "east": false, 
                "south": false, 
                "west": false, 
                "up": false
            }
        }, 
        {
            "at": 60, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:fire", 
                        "age": 4, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": false, 
                        "up": false
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

