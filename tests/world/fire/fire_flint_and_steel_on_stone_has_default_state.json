{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fire Flint And Steel On Stone Has Default State", 
    "description": "Flint and steel on the top of stone places fire with age 0 and no side flags, even with oak planks beside the fire position, because the sturdy floor wins in BaseFireBlock getState/FireBlock.getStateForPlacement.", 
    "tags": ["fire", "flint-and-steel", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:fire", "minecraft:stone", "minecraft:oak_planks", "minecraft:flint_and_steel"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:fire_spread_radius_around_player": -1
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:oak_planks"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:flint_and_steel"}, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:fire", 
                        "age": 0, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": false, 
                        "up": false
                    }
                }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_planks"} }
            ]
        }
    ], 
    "breakpoints": []
}

