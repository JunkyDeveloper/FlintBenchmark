{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fire Never Burns Out On Netherrack", 
    "description": "Fire with age 15 on netherrack is still there after 120 ticks, because netherrack is in the infiniburn tag, which skips the burn-out checks.", 
    "tags": ["fire", "infiniburn", "scheduled-tick"], 
    "minecraftIds": ["minecraft:fire", "minecraft:netherrack"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:fire_spread_radius_around_player": -1
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:netherrack"} }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {
                "id": "minecraft:fire", 
                "age": 15, 
                "north": false, 
                "east": false, 
                "south": false, 
                "west": false, 
                "up": false
            }
        }, 
        {
            "at": 120, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:fire", 
                        "age": 15, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": false, 
                        "up": false
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

