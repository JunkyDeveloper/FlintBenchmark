{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Fire Side Flags Update With Neighbour", 
    "description": "Floating fire with age 5 gains the east flag when a flammable block is placed east of it, keeping its age and west flag (FireBlock.updateShape recomputes the state).", 
    "tags": ["fire", "block-state", "neighbour-update"], 
    "minecraftIds": ["minecraft:fire", "minecraft:oak_planks"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:fire_spread_radius_around_player": -1
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:oak_planks"} }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [1, 1, 0], 
            "block": {
                "id": "minecraft:fire", 
                "age": 5, 
                "north": false, 
                "east": false, 
                "south": false, 
                "west": true, 
                "up": false
            }
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": {
                        "id": "minecraft:fire", 
                        "age": 5, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": true, 
                        "up": false
                    }
                }
            ]
        }, 
        { "at": 4, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:oak_planks"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": {
                        "id": "minecraft:fire", 
                        "age": 5, 
                        "north": false, 
                        "east": true, 
                        "south": false, 
                        "west": true, 
                        "up": false
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
