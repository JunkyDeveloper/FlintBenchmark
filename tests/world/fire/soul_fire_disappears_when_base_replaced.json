{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Soul Fire Disappears When Base Replaced", 
    "description": "Soul fire on soul sand is removed by the neighbour update when the soul sand is replaced with stone.", 
    "tags": ["soul_fire", "survival", "neighbour-update"], 
    "minecraftIds": ["minecraft:soul_fire", "minecraft:soul_sand", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:soul_sand"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:soul_fire"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:soul_fire"} }
            ]
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }
            ]
        }
    ], 
    "breakpoints": []
}

