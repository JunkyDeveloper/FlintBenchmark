{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Soul Fire Does Not Burn Or Spread", 
    "description": "Soul fire on soul sand next to oak planks is still there after 150 ticks and the planks are intact, because SoulFireBlock has no tick, aging or spread logic.", 
    "tags": ["soul_fire", "no-spread", "scheduled-tick"], 
    "minecraftIds": ["minecraft:soul_fire", "minecraft:soul_sand", "minecraft:oak_planks"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 0] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:fire_spread_radius_around_player": -1
            }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:soul_sand"} }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:oak_planks"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:soul_fire"} }, 
        {
            "at": 150, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:soul_fire" } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_planks"} }  
            ]
        }
    ], 
    "breakpoints": []
}

