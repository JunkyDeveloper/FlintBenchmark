{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "gold_ore_explosion_drops_raw_gold", 
    "description": "An exploded gold ore (no tool) drops exactly one raw gold item and no gold ore item; DropExperienceBlock gives 0 experience.", 
    "tags": ["ore", "gold", "drops", "explosion"], 
    "minecraftIds": ["minecraft:gold_ore", "minecraft:raw_gold"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:gold_ore"} }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }                                                   , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:raw_gold", "Item.count": 1}, 
                {"is": "minecraft:experience_orb", "exists": false}                                                     
            ]
        }
    ], 
    "breakpoints": []
}

