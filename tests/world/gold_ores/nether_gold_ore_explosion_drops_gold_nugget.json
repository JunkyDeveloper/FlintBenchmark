{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "nether_gold_ore_explosion_drops_gold_nugget", 
    "description": "An exploded nether gold ore drops a single stack of gold nuggets (count is random 2-6, so only the id is checked) and no raw gold or ore item.", 
    "tags": ["ore", "gold", "drops", "explosion"], 
    "minecraftIds": ["minecraft:nether_gold_ore", "minecraft:gold_nugget"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:nether_gold_ore"} }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }                                     , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:gold_nugget"}  
            ]
        }
    ], 
    "breakpoints": []
}

