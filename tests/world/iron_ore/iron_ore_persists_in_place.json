{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_ore_persists_in_place", 
    "description": "An iron ore block placed without properties has no block state, does not fall while unsupported, and is unchanged after neighbouring blocks are placed and removed. Representative of iron ore; deepslate iron ore shares its class and XP range.", 
    "tags": ["ore", "iron-ore", "block-state"], 
    "minecraftIds": ["minecraft:iron_ore", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:iron_ore"} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:iron_ore"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"     } }  
            ]
        }, 
        { "at": 6, "do": "place", "pos": [1, 2, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 7, "do": "remove", "pos": [1, 2, 0] }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:iron_ore"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"     } }  
            ]
        }
    ], 
    "breakpoints": []
}

