{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_ore_place_on_block", 
    "description": "A survival player using an iron ore item on the top face of a stone block places an iron ore block above it and consumes the item.", 
    "tags": ["ore", "iron-ore", "placement"], 
    "minecraftIds": ["minecraft:iron_ore", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"gamemode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:iron_ore"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:iron_ore"}                    }, 
                {                   "is": "empty"                     , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

