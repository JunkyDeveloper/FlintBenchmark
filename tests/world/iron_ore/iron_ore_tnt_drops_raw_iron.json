{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "iron_ore_tnt_drops_raw_iron", 
    "description": "Iron ore destroyed by a TNT explosion (drop decay off, no tool) drops exactly one raw iron and no experience orb: the loot table gives raw iron without silk touch, and the explosion path (no player source) produces no experience orb.", 
    "tags": ["ore", "iron-ore", "drops", "explosion"], 
    "minecraftIds": [
        "minecraft:iron_ore"      , "minecraft:obsidian"      , "minecraft:tnt"           , "minecraft:item"          , 
        "minecraft:raw_iron"      , "minecraft:experience_orb"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs"              : false, 
                "minecraft:advance_time"            : false, 
                "minecraft:advance_weather"         : false, 
                "minecraft:tnt_explosion_drop_decay": false  
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:obsidian"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:iron_ore"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 12, 0.5] }, 
        {
            "at": 2, 
            "do": "summon", 
            "entity_alias": "tnt", 
            "entity_type": "minecraft:tnt", 
            "pos": [2.5, 1, 0.5], 
            "nbt": {"fuse": "1s"}
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }                                                   , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:raw_iron", "Item.count": 1}, 
                {"is": "minecraft:experience_orb", "exists": false}                                                     
            ]
        }
    ], 
    "breakpoints": []
}

